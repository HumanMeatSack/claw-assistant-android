+package ai.openclaw.app.localagent
+
+import android.content.Context
+import android.net.Uri
+import java.io.File
+import java.util.concurrent.atomic.AtomicLong
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.job
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+
+internal interface PhoneAgentModelStorage {
+  val modelFile: File
+
+  fun isReady(): Boolean
+
+  suspend fun import(uri: Uri)
+}
+
+private class PinnedPhoneModelStorage(private val context: Context) : PhoneAgentModelStorage {
+  private val directory = context.getDir("phone-local-agent", Context.MODE_PRIVATE)
+  private val preferences = context.getSharedPreferences("phone_local_agent", Context.MODE_PRIVATE)
+  override val modelFile = File(directory, PinnedPhoneModel.fileName)
+
+  override fun isReady(): Boolean =
+    modelFile.isFile && modelFile.length() == PinnedPhoneModel.size &&
+      preferences.getString("verified_model_sha256", null) == PinnedPhoneModel.sha256
+
+  override suspend fun import(uri: Uri) {
+    require(uri.scheme == "content") { "Choose the model with the Android file picker." }
+    requireNotNull(context.contentResolver.openInputStream(uri)) { "The model file cannot be opened." }.use {
+      importVerifiedPhoneModel(it, modelFile)
+    }
+    check(preferences.edit().putString("verified_model_sha256", PinnedPhoneModel.sha256).commit()) {
+      "The model import could not be saved."
+    }
+  }
+}
+
+internal class LiteRtPhoneLocalAgent(
+  context: Context,
+  private val storage: PhoneAgentModelStorage = PinnedPhoneModelStorage(context),
+  private val runtimeFactory: (File, File) -> PhoneAgentRuntime = ::LiteRtPhoneAgentRuntime,
+  private val scope: CoroutineScope = CoroutineScope(SupervisorJob() + Dispatchers.Default),
+  private val idleMillis: Long = 120_000L,
+  private val workDispatcher: CoroutineDispatcher = Dispatchers.Default,
+) : PhoneLocalAgent {
+  private val preferences = context.getSharedPreferences("phone_local_agent", Context.MODE_PRIVATE)
+  private val cacheDirectory = File(context.cacheDir, "phone-local-agent").apply { mkdirs() }
+  private val operation = Mutex()
+  private val generation = AtomicLong()
+  private val mutableState =
+    MutableStateFlow(
+      PhoneAgentState(
+        enabled = preferences.getBoolean("enabled", false),
+        modelReady = storage.isReady(),
+        status = if (storage.isReady()) "Qwen3-4B is ready." else "Import the verified Qwen3-4B model to begin.",
+      ),
+    )
+  override val state: StateFlow<PhoneAgentState> = mutableState.asStateFlow()
+  private var runtime: PhoneAgentRuntime? = null
+  private val history = ArrayDeque<PhoneAgentHistory>()
+  private var idleJob: Job? = null
+  @Volatile private var activeJob: Job? = null
+  @Volatile private var activeConversation: PhoneAgentRuntimeConversation? = null
+
+  override fun setEnabled(enabled: Boolean) {
+    val allowed = enabled && state.value.modelReady && !state.value.importing
+    preferences.edit().putBoolean("enabled", allowed).apply()
+    mutableState.update {
+      it.copy(
+        enabled = allowed,
+        status = when {
+          allowed -> "Phone-local replies are on."
+          enabled -> "Import the verified Qwen3-4B model first."
+          else -> "Phone-local replies are off."
+        },
+      )
+    }
+    if (!allowed) {
+      cancel()
+      scope.launch {
+        operation.withLock {
+          // Disable already cancelled its turn. A queued cleanup must not cancel a newer one.
+          if (!state.value.enabled) {
+            idleJob?.cancel()
+            idleJob = null
+            releaseRuntime()
+            history.clear()
+          }
+        }
+      }
+    }
+  }
+
+  override suspend fun importModel(uri: Uri) {
+    cancel()
+    withContext(Dispatchers.IO) {
+      operation.withLock {
+        idleJob?.cancel()
+        releaseRuntime()
+        history.clear()
+        mutableState.update { it.copy(importing = true, status = "Importing and verifying Qwen3-4B…") }
+        try {
+          storage.import(uri)
+          mutableState.update { it.copy(modelReady = true, status = "Qwen3-4B imported and verified.") }
+        } catch (cancelled: CancellationException) {
+          mutableState.update { it.copy(status = "Model import cancelled.", modelReady = storage.isReady()) }
+          throw cancelled
+        } catch (error: Exception) {
+          mutableState.update { it.copy(status = "Import failed. Choose the verified Qwen3-4B file.", modelReady = storage.isReady()) }
+          throw error
+        } finally {
+          mutableState.update { it.copy(importing = false) }
+        }
+      }
+    }
+  }
+
+  override suspend fun warmUp() =
+    withContext(workDispatcher) {
+      operation.withLock {
+        if (!state.value.enabled || !state.value.modelReady) return@withLock
+        idleJob?.cancel()
+        try {
+          ensureRuntime()
+          mutableState.update { it.copy(status = "Ready on this phone.") }
+        } catch (error: Exception) {
+          mutableState.update { it.copy(status = "The local model could not load. Try again.") }
+          throw error
+        } catch (error: LinkageError) {
+          mutableState.update { it.copy(status = "The local runtime is unavailable on this build.") }
+          throw error
+        } finally {
+          scheduleIdleRelease()
+        }
+      }
+    }
+
+  override suspend fun reply(
+    text: String,
+    tools: List<PhoneAgentTool>,
+    finalizeReply: suspend (String) -> String,
+    execute: suspend (PhoneAgentCall) -> String,
+  ): String =
+    withContext(workDispatcher) {
+      operation.withLock {
+        require(text.isNotBlank()) { "Say or type a request first." }
+        check(state.value.enabled && state.value.modelReady && !state.value.importing) { "Phone-local replies are not ready." }
+        require(tools.map { it.name }.distinct().size == tools.size) { "Phone tool names must be unique." }
+        idleJob?.cancel()
+        val epoch = generation.get()
+        activeJob = currentCoroutineContext().job
+        mutableState.update { it.copy(status = "Thinking on this phone…") }
+        val remembered = history.toMutableList()
+        var hasToolResult = false
+        try {
+          val model = ensureRuntime()
+          var conversation: PhoneAgentRuntimeConversation
+          while (true) {
+            currentCoroutineContext().ensureActive()
+            check(generation.get() == epoch && state.value.enabled) { "The local conversation ended." }
+            conversation = model.conversation(tools, remembered)
+            activeConversation = conversation
+            if (fits(conversation, text, null)) break
+            conversation.close()
+            activeConversation = null
+            if (remembered.isEmpty()) {
+              return@withLock finishReply(text, "That request or its phone tools exceed this model's context. Please make the request shorter.", remembered, epoch, finalizeReply)
+            }
+            remembered.removeAt(0)
+          }
+          var input: String? = text
+          var results: List<Pair<String, String>>? = null
+          var callsUsed = 0
+          val suppliedNames = tools.map { it.name }.toSet()
+          while (true) {
+            currentCoroutineContext().ensureActive()
+            check(generation.get() == epoch && state.value.enabled) { "The local conversation ended." }
+            if (!fits(conversation, input, results)) {
+              val fallback = if (results != null) {
+                summarizePhoneResults(results)
+              } else {
+                "The local context is full. Please ask a shorter question."
+              }
+              return@withLock finishReply(text, fallback, remembered, epoch, finalizeReply)
+            }
+            val response = conversation.send(input, results)
+            currentCoroutineContext().ensureActive()
+            if (response.calls.isEmpty()) {
+              return@withLock finishReply(text, response.text, remembered, epoch, finalizeReply)
+            }
+            if (callsUsed + response.calls.size > 4) {
+              return@withLock finishReply(text, "I reached this request's phone-action limit. Please ask for the next step.", remembered, epoch, finalizeReply)
+            }
+            if (response.calls.any { it.name !in suppliedNames || utf8Size(it.argumentsJson) > 4096 }) {
+              return@withLock finishReply(text, "I couldn't match that to an available phone action. Please rephrase.", remembered, epoch, finalizeReply)
+            }
+            // Parse every argument object before invoking any action in this model response.
+            response.calls.forEach { JSONObject(it.argumentsJson) }
+            results = response.calls.map { call ->
+              currentCoroutineContext().ensureActive()
+              check(generation.get() == epoch && state.value.enabled) { "The local conversation ended." }
+              mutableState.update { it.copy(status = "Checking the phone…") }
+              val result = execute(call)
+              hasToolResult = true
+              callsUsed++
+              call.name to if (utf8Size(result) <= 8192) result else {
+                "{\"ok\":false,\"error\":\"local_result_limit\",\"message\":\"The phone result was too large to review locally; do not infer success.\"}"
+              }
+            }
+            input = null
+          }
+          @Suppress("UNREACHABLE_CODE")
+          error("Phone-local conversation did not finish.")
+        } catch (cancelled: CancellationException) {
+          mutableState.update { it.copy(status = "Local reply stopped.") }
+          throw cancelled
+        } catch (error: Exception) {
+          if (hasToolResult) return@withLock finishReply(text, "The phone model could not finish reviewing the tool result.", remembered, epoch, finalizeReply)
+          mutableState.update { it.copy(status = "The local reply failed. Please try again.") }
+          throw error
+        } catch (error: LinkageError) {
+          if (hasToolResult) return@withLock finishReply(text, "The phone model could not finish reviewing the tool result.", remembered, epoch, finalizeReply)
+          mutableState.update { it.copy(status = "The local runtime is unavailable on this build.") }
+          throw error
+        } finally {
+          activeConversation?.close()
+          activeConversation = null
+          activeJob = null
+          mutableState.update {
+            if (it.enabled && (it.status == "Thinking on this phone…" || it.status == "Checking the phone…")) {
+              it.copy(status = "Ready on this phone.")
+            } else {
+              it
+            }
+          }
+          scheduleIdleRelease()
+        }
+      }
+    }
+
+  override fun cancel() {
+    generation.incrementAndGet()
+    activeJob?.cancel()
+    activeConversation?.cancel()
+  }
+
+  override suspend fun resetConversation() {
+    cancel()
+    operation.withLock { history.clear() }
+  }
+
+  override suspend fun unload() {
+    cancel()
+    withContext(workDispatcher) {
+      operation.withLock {
+        idleJob?.cancel()
+        idleJob = null
+        releaseRuntime()
+        history.clear()
+        mutableState.update {
+          it.copy(status = if (it.enabled) "Ready; the model loads when you ask." else "Phone-local replies are off.")
+        }
+      }
+    }
+  }
+
+  private fun ensureRuntime(): PhoneAgentRuntime {
+    check(storage.isReady()) { "Import the verified Qwen3-4B model first." }
+    return runtime ?: run {
+      mutableState.update { it.copy(status = "Loading Qwen3-4B on this phone…") }
+      runtimeFactory(storage.modelFile, cacheDirectory).also { runtime = it }
+    }
+  }
+
+  private suspend fun finishReply(
+    text: String,
+    modelAnswer: String,
+    remembered: List<PhoneAgentHistory>,
+    epoch: Long,
+    finalizeReply: suspend (String) -> String,
+  ): String {
+    currentCoroutineContext().ensureActive()
+    if (generation.get() != epoch || !state.value.enabled) throw CancellationException("Local reply owner retired")
+    val answer = finalizeReply(modelAnswer).ifBlank { "I couldn't produce a reply. Please try again." }
+    currentCoroutineContext().ensureActive()
+    if (generation.get() != epoch || !state.value.enabled) throw CancellationException("Local reply owner retired")
+    history.clear()
+    history.addAll(remembered)
+    history.addLast(PhoneAgentHistory(text, answer))
+    while (history.size > 3 || history.sumOf { utf8Size(it.user) + utf8Size(it.answer) } > 1024) history.removeFirst()
+    mutableState.update { it.copy(status = "Ready on this phone.") }
+    return answer
+  }
+
+  private fun releaseRuntime() {
+    runtime?.close()
+    runtime = null
+  }
+
+  private fun scheduleIdleRelease() {
+    idleJob?.cancel()
+    idleJob = scope.launch {
+      delay(idleMillis)
+      operation.withLock {
+        releaseRuntime()
+        mutableState.update {
+          if (it.enabled) it.copy(status = "Ready; the model loads when you ask.") else it
+        }
+      }
+    }
+  }
+}
+
+private fun fits(conversation: PhoneAgentRuntimeConversation, text: String?, results: List<Pair<String, String>>?): Boolean =
+  conversation.tokenCount() + conversation.renderedBytes(text, results) + phoneAgentOutputTokens + 32 <= phoneAgentContextTokens
+
+// Qwen's byte-level tokenizer cannot consume more tokens than UTF-8 input bytes. Reserve decoded
+// output separately and use the runtime's actual cache count for instructions, schemas and history.
+private fun utf8Size(text: String): Int = text.toByteArray(Charsets.UTF_8).size
+
+private fun summarizePhoneResults(results: List<Pair<String, String>>): String {
+  val answers = results.mapNotNull { (_, value) ->
+    val structured = runCatching { JSONObject(value) }.getOrNull() ?: return@mapNotNull null
+    listOf("answer", "message").firstNotNullOfOrNull { key ->
+      (structured.opt(key) as? String)?.takeIf { it.isNotBlank() }?.let { clipUtf8(it, 400) }
+    }
+  }
+  return answers.take(2).joinToString(" ").ifBlank {
+    "I got a result, but it is too long for this model. Ask about one device or page."
+  }
+}
+
+private fun clipUtf8(text: String, maximum: Int): String {
+  if (utf8Size(text) <= maximum) return text
+  var end = minOf(text.length, maximum)
+  while (end > 0 && utf8Size(text.substring(0, end)) > maximum - 20) end--
+  if (end > 0 && text[end - 1].isHighSurrogate()) end--
+  return text.substring(0, end) + " [result truncated]"
+}
