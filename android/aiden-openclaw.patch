+    assertFalse(agent.isReadyForConversation())
+    agent.state.value = agent.state.value.copy(enabled = true, modelReady = false)
+    assertFalse(agent.isReadyForConversation())
+    agent.state.value = agent.state.value.copy(modelReady = true, importing = true)
