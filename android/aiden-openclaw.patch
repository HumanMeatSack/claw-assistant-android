+package ai.openclaw.app.assistant
+
+import ai.openclaw.app.R
+import ai.openclaw.app.voice.SystemSpeechSpeaker
+import android.content.Context
+import kotlinx.coroutines.CancellationException
+
+/** Speaks a neutral offline acknowledgment; no personal recording is bundled. */
+internal suspend fun playWakeGreeting(context: Context): Boolean {
+  val speaker = SystemSpeechSpeaker(context.applicationContext)
+  return try {
+    speaker.speakOffline(context.getString(R.string.aiden_assistant_wake_greeting))
+    true
+  } catch (cancelled: CancellationException) {
+    throw cancelled
+  } catch (_: Exception) {
+    false
+  } catch (_: LinkageError) {
+    false
+  } finally {
+    speaker.shutdown()
+  }
+}
diff --git a/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenWakeService.kt b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenWakeService.kt
