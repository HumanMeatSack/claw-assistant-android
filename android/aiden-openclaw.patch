+package ai.openclaw.app.assistant
+
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.style.URLSpan
+import android.view.View
+import java.net.URI
+import java.util.Locale
+
+private data class ReplyLink(val start: Int, val end: Int, val url: String, val label: String? = null)
+
+private val replyMarkdownLink = Regex("\\[([^\\[\\]\\n]+)]\\((https?://(?:[^\\s()<>]|\\([^\\s()<>]*\\))+)\\)", RegexOption.IGNORE_CASE)
+private val replyPlainUrl = Regex("https?://[^\\s<>\"']+", RegexOption.IGNORE_CASE)
+private val modelWord = Regex("\\b(?=[a-z0-9-]*[a-z])(?=[a-z0-9-]*\\d)[a-z0-9]+(?:-[a-z0-9]+)*\\b", RegexOption.IGNORE_CASE)
+private const val sourceReplyPrefix = "Checked public source:"
+
+/** Compact presentation only. Conversation/evidence owners retain the complete original text. */
+internal fun assistantReplyLinks(source: String, openLink: (String) -> Unit): Spanned {
+  val markdown = replyMarkdownLink.findAll(source).mapNotNull { match ->
+    match.groupValues[2].takeIf(::isReplyWebUrl)?.let {
+      ReplyLink(match.range.first, match.range.last + 1, it, match.groupValues[1])
+    }
+  }.toList()
+  val canonical = source.trimStart().startsWith(sourceReplyPrefix)
+  val plain = replyPlainUrl.findAll(source).mapNotNull { match ->
+    val start = match.range.first
+    val url = if (canonical) match.value else proseUrl(match.value)
+    val end = start + url.length
+    if (!isReplyWebUrl(url) || markdown.any { start < it.end && end > it.start }) null else ReplyLink(start, end, url)
+  }.toList()
+  val links = (markdown + plain).sortedBy { it.start }
+  val output = SpannableStringBuilder()
+  if (canonical && links.isNotEmpty()) {
+    var previousEnd = source.indexOf(sourceReplyPrefix) + sourceReplyPrefix.length
+    links.forEachIndexed { index, link ->
+      if (index != 0) output.append('\n')
+      val title = link.label ?: source.substring(previousEnd, link.start).trim(' ', '\n', '\r', ':', ';', ',')
+      appendReplyLink(output, compactReplyLabel(title, link.url), link.url, openLink)
+      previousEnd = link.end
+    }
+    val trailingText = source.substring(previousEnd).trimStart()
+    if (trailingText.isNotBlank()) output.append('\n').append(trailingText)
+  } else {
+    var previousEnd = 0
+    for (link in links) {
+      output.append(source.substring(previousEnd, link.start))
+      appendReplyLink(output, compactReplyLabel(link.label, link.url), link.url, openLink)
+      previousEnd = link.end
+    }
+    output.append(source.substring(previousEnd))
+  }
+  return output
+}
+
+private fun proseUrl(value: String): String {
+  var url = value.trimEnd('.', ',', ';', '!')
+  for ((close, open) in listOf(')' to '(', ']' to '[', '}' to '{')) {
+    while (url.endsWith(close) && url.count { it == close } > url.count { it == open }) url = url.dropLast(1)
+  }
+  return url
+}
+
+private fun appendReplyLink(output: SpannableStringBuilder, label: String, url: String, openLink: (String) -> Unit) {
+  val start = output.length
+  output.append(label)
+  output.setSpan(object : URLSpan(url) {
+    override fun onClick(widget: View) = openLink(url)
+  }, start, output.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+}
+
+private fun isReplyWebUrl(value: String): Boolean = runCatching {
+  val uri = URI(value)
+  (uri.scheme.equals("https", true) || uri.scheme.equals("http", true)) && !uri.host.isNullOrBlank() && uri.rawUserInfo == null
+}.getOrDefault(false)
+
+private fun compactReplyLabel(title: String?, url: String): String {
+  val host = URI(url).host.removePrefix("www.")
+  val parts = title.orEmpty().split(Regex("\\s*(?:::|[|›>]|\\s[-–—]\\s)\\s*"))
+    .map { it.trim().replace(Regex("\\s+"), " ") }.filter(String::isNotBlank)
+  val descriptiveModel = parts.lastOrNull { part ->
+    modelWord.containsMatchIn(part) && part.split(' ').any { word -> word.any(Char::isLetter) && word.none(Char::isDigit) }
+  }
+  var label = descriptiveModel ?: parts.lastOrNull { it.count(Char::isLetter) >= 4 } ?: host
+  if (label.contains(Regex("https?://", RegexOption.IGNORE_CASE))) label = host
+  if (label == label.lowercase(Locale.ROOT) && label != host) {
+    label = label.split(' ').joinToString(" ") { word ->
+      if (modelWord.matches(word)) word.uppercase(Locale.ROOT) else word.replaceFirstChar { it.titlecase(Locale.ROOT) }
+    }
+  }
+  if (label.length <= 40) return label
+  val prefix = label.take(39)
+  val wordEnd = prefix.lastIndexOf(' ').takeIf { it >= 24 } ?: prefix.length
+  return prefix.take(wordEnd).trimEnd() + "…"
+}
