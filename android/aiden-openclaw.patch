index 0000000000000000000000000000000000000000..62c19e90ba3faf997626c41faad7a0265097f23f
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/voice/LocalSpeechBargeIn.kt
@@ -0,0 +1,372 @@
+package ai.openclaw.app.voice
+
+import android.Manifest
+import android.app.KeyguardManager
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.AudioFormat
+import android.os.Build
+import android.os.Bundle
+import android.os.ParcelFileDescriptor
+import android.os.PowerManager
+import android.os.SystemClock
+import android.speech.RecognitionListener
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import android.util.Log
+import androidx.core.content.ContextCompat
+import java.util.Locale
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+internal enum class BargeInEvidence { NoText, PlaybackNotStarted, Converging, Echo, Confirming, Speech }
+
+/** Confirms arbitrary user wording while suppressing contiguous fragments of rendered speech. */
+internal class LocalBargeInEvidence(spokenReply: String) {
+  private val rendered = words(spokenReply)
+  private var startedAt: Long? = null
+  private var candidateWords = emptyList<String>()
+  private var novelSince: Long? = null
+  var text: String = ""
+    private set
+  var final: Boolean = false
+    private set
+
+  fun playbackStarted(nowMs: Long) { startedAt = nowMs }
+
+  fun observe(value: String, isFinal: Boolean, nowMs: Long) {
+    val next = words(value)
+    val extendsPrevious = candidateWords.isNotEmpty() && next.take(candidateWords.size) == candidateWords
+    if (next.isEmpty() || isRenderedFragment(next)) novelSince = null
+    else if (novelSince == null || !extendsPrevious) novelSince = nowMs
+    candidateWords = next
+    text = value.trim()
+    final = isFinal
+  }
+
+  fun decision(nowMs: Long): BargeInEvidence {
+    if (candidateWords.isEmpty()) return BargeInEvidence.NoText
+    val start = startedAt ?: return BargeInEvidence.PlaybackNotStarted
+    if (nowMs - start < 400L) return BargeInEvidence.Converging
+    if (isRenderedFragment(candidateWords)) return BargeInEvidence.Echo
+    return if (final || nowMs - (novelSince ?: nowMs) >= 120L) BargeInEvidence.Speech else BargeInEvidence.Confirming
+  }
+
+  fun confirmationDelay(nowMs: Long): Long? = when (decision(nowMs)) {
+    BargeInEvidence.Converging -> (checkNotNull(startedAt) + 400L - nowMs).coerceAtLeast(1L)
+    BargeInEvidence.Confirming -> (checkNotNull(novelSince) + 120L - nowMs).coerceAtLeast(1L)
+    else -> null
+  }
+
+  private fun isRenderedFragment(tokens: List<String>): Boolean = tokens.isNotEmpty() &&
+    rendered.windowed(tokens.size).any { it == tokens }
+
+  private companion object {
+    val contractions = mapOf("i'm" to "i am", "you're" to "you are", "we're" to "we are", "it's" to "it is", "that's" to "that is", "don't" to "do not", "can't" to "cannot", "i'll" to "i will", "i've" to "i have")
+    fun words(value: String): List<String> {
+      val normalized = value.lowercase(Locale.ROOT).replace('’', '\'')
+      val expanded = Regex("[a-z]+\\'[a-z]+").replace(normalized) { contractions[it.value] ?: it.value }
+      return Regex("[\\p{L}\\p{N}]+").findAll(expanded).map { it.value }.toList()
+    }
+  }
+}
+
+/** Retains the words recognized before and after playback stops, on the same input stream. */
+internal class LocalInterruptionTranscript {
+  private val segments = mutableListOf<String>()
+  private var partial = ""
+
+  fun update(text: String, final: Boolean) {
+    val clean = text.trim()
+    if (clean.isEmpty()) return
+    if (final) {
+      if (segments.lastOrNull() != clean) segments += clean
+      partial = ""
+    } else partial = clean
+  }
+
+  fun text(): String = PushToTalkTranscriptMerger.merge(segments, partial)
+}
+
+internal fun requestsInterruptedReply(text: String): Boolean {
+  val normalized = text.lowercase(Locale.ROOT).replace(Regex("[,.!?]+"), " ").replace(Regex("\\s+"), " ").trim()
+  return Regex(
+    "(?:(?:oh|okay|ok|yeah|yes|actually|sorry|aiden|hey aiden) )*" +
+      "(?:(?:never mind|nevermind|ignore that) )?" +
+      "(?:(?:that|it) was (?:somebody else|someone else|my (?:daughter|wife|kid|son)|the tv) )?" +
+      "(?:(?:can|could|would) you )?(?:please )?" +
+      "(?:continue|resume|carry on|go on|keep going|finish what you were saying)" +
+      "(?: (?:please|that|(?:from )?where you left off|what you were saying|(?:with )?(?:your |the )?(?:last |previous )?(?:answer|reply|explanation)))?",
+  ).matches(normalized)
+}
+
+/** Owns an on-device recognizer fed only by an echo-cancelled communication recorder. */
+internal class LocalSpeechBargeIn(
+  private val context: Context,
+  private val scope: CoroutineScope,
+  private val retirement: AudioRetirement,
+  spokenReply: String,
+  private val locale: String,
+  private val isCurrent: () -> Boolean,
+  private val onEvidence: (String) -> Unit = {},
+  private val onInterrupt: () -> Boolean,
+) : AutoCloseable {
+  private val transcript = LocalInterruptionTranscript()
+  private val evidence = LocalBargeInEvidence(spokenReply)
+  private val utterance = CompletableDeferred<String?>()
+  private var endpoint: Job? = null
+  private var confirmation: Job? = null
+  private var lastEvidence: BargeInEvidence? = null
+  private var recognitionFinished = false
+  private var interrupted = false
+  private val resourcesLock = Any()
+  private val closed = AtomicBoolean(false)
+  private var input: AndroidAudioInputSession? = null
+  private var recognizer: SpeechRecognizer? = null
+  private var pipe: Array<ParcelFileDescriptor>? = null
+  private var writer: ParcelFileDescriptor.AutoCloseOutputStream? = null
+  private var pump: Job? = null
+
+  val active: Boolean get() = !closed.get() && input?.canCaptureDuringPlayback == true
+
+  suspend fun start(): Boolean {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU || !allowed()) return false
+    return try {
+      withContext(Dispatchers.IO) {
+        retirement.await()
+        if (!allowed()) return@withContext
+        val opened = AndroidAudioInputSession.open(
+          context, sampleRateHz = 16_000, frameBytes = 640, communication = true,
+          isCurrent = { !closed.get() && isCurrent() }, onFocusLost = ::close,
+        )
+        synchronized(resourcesLock) {
+          if (closed.get()) {
+            opened.close()
+            throw CancellationException("Interruption capture retired")
+          }
+          input = opened
+        }
+        opened.startRecording()
+        check(opened.canCaptureDuringPlayback) { "Echo cancellation unavailable" }
+        synchronized(resourcesLock) {
+          check(!closed.get()) { "Interruption capture retired" }
+          pipe = ParcelFileDescriptor.createPipe()
+          writer = ParcelFileDescriptor.AutoCloseOutputStream(checkNotNull(pipe)[1])
+        }
+      }
+      withContext(Dispatchers.Main.immediate) {
+        check(allowed() && active) { "Interruption capture unavailable" }
+        val source = checkNotNull(pipe)[0]
+        val listener = LocalSpeechRecognition.create(context)
+        synchronized(resourcesLock) {
+          if (closed.get()) {
+            listener.destroy()
+            return@withContext
+          }
+          recognizer = listener
+        }
+        listener.setRecognitionListener(object : RecognitionListener {
+          override fun onReadyForSpeech(params: Bundle?) = Unit
+          override fun onBeginningOfSpeech() {
+            if (!active || !allowed()) return
+            endpoint?.cancel()
+            endpoint = null
+            // OEM onset callbacks can be Aiden's own speaker before AEC settles.
+            // Keep capturing; actual words must confirm the interruption below.
+            Log.d("TalkMode", "barge_in onset_unconfirmed")
+            onEvidence("onset_unconfirmed")
+          }
+          override fun onRmsChanged(rmsdB: Float) = Unit
+          override fun onBufferReceived(buffer: ByteArray?) = Unit
+          override fun onEndOfSpeech() = Unit
+          override fun onEvent(eventType: Int, params: Bundle?) = Unit
+          override fun onError(error: Int) {
+            finishUtterance()
+            close()
+          }
+          override fun onResults(results: Bundle?) {
+            recognitionFinished = true
+            acceptTranscript(results, final = true)
+            finishUtterance()
+          }
+          override fun onPartialResults(partialResults: Bundle?) { acceptTranscript(partialResults, final = false) }
+          override fun onSegmentResults(segmentResults: Bundle) { acceptTranscript(segmentResults, final = true) }
+          override fun onEndOfSegmentedSession() {
+            recognitionFinished = true
+            finishUtterance()
+          }
+        })
+        listener.startListening(Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+          putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+          putExtra(RecognizerIntent.EXTRA_LANGUAGE, locale)
+          putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
+          putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
+          putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 900L)
+          putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 700L)
+          putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE, source)
+          putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_CHANNEL_COUNT, 1)
+          putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_ENCODING, AudioFormat.ENCODING_PCM_16BIT)
+          putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_SAMPLING_RATE, 16_000)
+          putExtra(RecognizerIntent.EXTRA_SEGMENTED_SESSION, RecognizerIntent.EXTRA_AUDIO_SOURCE)
+        })
+      }
+      val recorder = checkNotNull(input)
+      val stream = checkNotNull(writer)
+      pump = scope.launch(Dispatchers.IO) {
+        val buffer = ByteArray(640)
+        try {
+          while (currentCoroutineContext().isActive && allowed() && recorder.canCaptureDuringPlayback) {
+            val count = recorder.read(buffer, 0, buffer.size)
+            if (count <= 0) break
+            stream.write(buffer, 0, count)
+          }
+        } catch (_: Exception) {
+          // Ending a reply closes the pipe and the recorder together.
+        } finally {
+          close()
+        }
+      }
+      active
+    } catch (cancelled: CancellationException) {
+      close()
+      throw cancelled
+    } catch (error: Exception) {
+      Log.d("TalkMode", "Local interruption unavailable (${error.javaClass.simpleName})")
+      close()
+      false
+    }
+  }
+
+  private fun allowed(): Boolean = !closed.get() && isCurrent() &&
+    ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED &&
+    context.getSystemService(PowerManager::class.java)?.isInteractive == true &&
+    context.getSystemService(KeyguardManager::class.java)?.isKeyguardLocked == false
+
+  suspend fun awaitUtterance(): String? = withTimeoutOrNull(120_000L) { utterance.await() }
+
+  fun playbackStarted() {
+    evidence.playbackStarted(SystemClock.elapsedRealtime())
+    confirmSpeech()
+  }
+
+  private fun interruptForSpeech(): Boolean {
+    if (!active || !allowed()) return false
+    if (!interrupted) interrupted = onInterrupt()
+    if (interrupted && endpoint == null) endpoint = scope.launch(Dispatchers.Main.immediate) {
+      delay(5_000L)
+      finishUtterance()
+    }
+    return interrupted
+  }
+
+  private fun acceptTranscript(result: Bundle?, final: Boolean) {
+    if (!active || !allowed()) return
+    val text = result?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)?.firstOrNull()?.trim() ?: return
+    if (text.isEmpty()) return
+    // Echo cancellation is the acoustic boundary. Repeated words are still valid user speech.
+    if (interrupted) {
+      transcript.update(text, final)
+      scheduleEndpoint(final)
+    } else {
+      evidence.observe(text, final, SystemClock.elapsedRealtime())
+      confirmSpeech()
+    }
+  }
+
+  private fun confirmSpeech() {
+    if (!active || !allowed() || interrupted) return
+    confirmation?.cancel()
+    val now = SystemClock.elapsedRealtime()
+    val decision = evidence.decision(now)
+    if (decision != lastEvidence) {
+      Log.d("TalkMode", "barge_in evidence=${decision.name.lowercase(Locale.ROOT)}")
+      onEvidence(decision.name.lowercase(Locale.ROOT))
+      lastEvidence = decision
+    }
+    if (decision == BargeInEvidence.Speech && interruptForSpeech()) {
+      Log.d("TalkMode", "barge_in accepted")
+      onEvidence("accepted")
+      transcript.update(evidence.text, evidence.final)
+      if (recognitionFinished) finishUtterance() else scheduleEndpoint(evidence.final)
+    } else evidence.confirmationDelay(now)?.let { waitMs ->
+      confirmation = scope.launch(Dispatchers.Main.immediate) {
+        delay(waitMs)
+        confirmSpeech()
+      }
+    }
+  }
+
+  private fun scheduleEndpoint(final: Boolean) {
+    endpoint?.cancel()
+    endpoint = scope.launch(Dispatchers.Main.immediate) {
+      delay(if (final) 800L else 2_500L)
+      finishUtterance()
+    }
+  }
+
+  private fun finishUtterance() {
+    if (interrupted) utterance.complete(transcript.text().ifBlank { null })
+  }
+
+  override fun close(): Unit = synchronized(resourcesLock) {
+    if (!closed.compareAndSet(false, true)) return@synchronized
+    endpoint?.cancel()
+    endpoint = null
+    confirmation?.cancel()
+    confirmation = null
+    utterance.complete(null)
+    // Register the physical retirement before another close caller can return
+    // and admit a replacement microphone through AudioRetirement.await().
+    val resources = Resources(recognizer, pipe, writer, input, pump)
+    recognizer = null
+    pipe = null
+    writer = null
+    input = null
+    pump = null
+    val cleanup = kotlinx.coroutines.CompletableDeferred<Unit>()
+    val retireRecognizer = Runnable {
+      try {
+        resources.recognizer?.cancel()
+        resources.recognizer?.destroy()
+        resources.pipe?.get(0)?.close()
+        cleanup.complete(Unit)
+      } catch (error: Exception) {
+        cleanup.completeExceptionally(error)
+      }
+    }
+    val handler = android.os.Handler(android.os.Looper.getMainLooper())
+    if (android.os.Looper.myLooper() == handler.looper) retireRecognizer.run()
+    else if (!handler.post(retireRecognizer)) cleanup.completeExceptionally(IllegalStateException("Recognizer cleanup unavailable"))
+    retirement.retire(
+      resources.pump,
+      AutoCloseable {
+        try {
+          resources.input?.close()
+        } finally {
+          resources.writer?.close()
+          if (resources.writer == null) resources.pipe?.get(1)?.close()
+        }
+      },
+      cleanup,
+    )
+  }
+
+  private data class Resources(
+    val recognizer: SpeechRecognizer?,
+    val pipe: Array<ParcelFileDescriptor>?,
+    val writer: ParcelFileDescriptor.AutoCloseOutputStream?,
+    val input: AndroidAudioInputSession?,
+    val pump: Job?,
+  )
+}
