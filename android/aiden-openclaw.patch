@@ -0,0 +1,39 @@
+package ai.openclaw.app.localagent
+
+import android.net.Uri
+import kotlinx.coroutines.flow.StateFlow
+
+data class PhoneAgentTool(val name: String, val description: String, val parametersJson: String)
+
+data class PhoneAgentCall(val name: String, val argumentsJson: String)
+
+data class PhoneAgentState(
+  val enabled: Boolean,
+  val modelReady: Boolean,
+  val status: String,
+  val importing: Boolean = false,
+)
+
+/** Optional phone-local conversation owner; actions stay with the existing validated handlers. */
+interface PhoneLocalAgent {
+  val state: StateFlow<PhoneAgentState>
+
+  suspend fun importModel(uri: Uri)
+
+  fun setEnabled(enabled: Boolean)
+
+  suspend fun warmUp()
