@@ -0,0 +1,53 @@
+package ai.openclaw.app
+
+import android.content.Context
+
+internal sealed interface PhoneCommand {
+  data class Quick(val action: PhoneQuickAction) : PhoneCommand
+  data class Utility(val action: PhoneUtilityAction) : PhoneCommand
+  data class Google(val action: PhoneGoogleAction) : PhoneCommand
+  data class Device(val action: PhoneDeviceAction) : PhoneCommand
+}
+
+internal fun parsePhoneCommand(input: String): PhoneCommand? {
+  parsePhoneQuickAction(input)?.let { return PhoneCommand.Quick(it) }
+  parsePhoneGoogleAction(input)?.let { return PhoneCommand.Google(it) }
+  parsePhoneUtilityAction(input)?.let { return PhoneCommand.Utility(it) }
+  return parsePhoneDeviceAction(input)?.let { PhoneCommand.Device(it) }
+}
+
+internal fun executePhoneCommand(context: Context, command: PhoneCommand): PhoneDeviceResult = when (command) {
+  is PhoneCommand.Device -> executePhoneDeviceAction(context, command.action)
+  is PhoneCommand.Quick -> executeQuickCommand(context, command.action)
+  is PhoneCommand.Utility -> executeUtilityCommand(context, command.action)
+  is PhoneCommand.Google -> executePhoneGoogleAction(context, command.action)
+}
+
+private fun executeQuickCommand(context: Context, action: PhoneQuickAction): PhoneDeviceResult =
+  when (executePhoneQuickAction(context, action)) {
+    PhoneQuickActionResult.APP_OPENED -> PhoneDeviceResult("Opening ${(action as PhoneQuickAction.OpenApp).app.displayName}")
+    PhoneQuickActionResult.TIMER_HANDED_OFF -> PhoneDeviceResult("Timer sent to Clock")
+    PhoneQuickActionResult.ALARM_HANDED_OFF -> PhoneDeviceResult("Alarm sent to Clock")
+    PhoneQuickActionResult.FLASHLIGHT_SET -> PhoneDeviceResult(if ((action as PhoneQuickAction.SetFlashlight).enabled) "Flashlight on" else "Flashlight off")
+    PhoneQuickActionResult.VOLUME_SET -> PhoneDeviceResult("Volume adjusted")
+    PhoneQuickActionResult.APP_UNAVAILABLE -> PhoneDeviceResult("This app is unavailable", completed = false)
+    PhoneQuickActionResult.CLOCK_UNAVAILABLE -> PhoneDeviceResult("No supported Clock app is available", completed = false)
+    PhoneQuickActionResult.FLASHLIGHT_UNAVAILABLE -> PhoneDeviceResult("The flashlight is unavailable", completed = false)
+    PhoneQuickActionResult.VOLUME_UNAVAILABLE -> PhoneDeviceResult("Android could not set that volume", completed = false)
+    PhoneQuickActionResult.COULD_NOT_START -> PhoneDeviceResult("Android could not start this action", completed = false)
+  }
+
+private fun executeUtilityCommand(context: Context, action: PhoneUtilityAction): PhoneDeviceResult =
+  when (executePhoneUtilityAction(context, action)) {
+    PhoneUtilityActionResult.MAP_SEARCH_OPENED, PhoneUtilityActionResult.MAP_DIRECTIONS_OPENED -> PhoneDeviceResult("Opening Maps")
+    PhoneUtilityActionResult.DIALER_OPENED -> PhoneDeviceResult("Number ready in Phone")
+    PhoneUtilityActionResult.MESSAGE_DRAFT_OPENED -> PhoneDeviceResult("Draft ready in Messages")
+    PhoneUtilityActionResult.CAMERA_OPENED -> PhoneDeviceResult("Opening Camera")
+    PhoneUtilityActionResult.SETTINGS_OPENED -> PhoneDeviceResult("Opening Settings")
+    PhoneUtilityActionResult.INSTALLED_APP_OPENED -> PhoneDeviceResult("Opening app")
+    PhoneUtilityActionResult.APP_NAME_AMBIGUOUS -> PhoneDeviceResult("More than one app has that name", completed = false)
+    PhoneUtilityActionResult.WEB_PAGE_OPENED -> PhoneDeviceResult("Opening website")
+    PhoneUtilityActionResult.CALENDAR_DRAFT_OPENED -> PhoneDeviceResult("Event draft ready in Calendar")
+    PhoneUtilityActionResult.APP_UNAVAILABLE -> PhoneDeviceResult("No app can open this action", completed = false)
+    PhoneUtilityActionResult.COULD_NOT_START -> PhoneDeviceResult("Android could not start this action", completed = false)
+  }
diff --git a/apps/android/app/src/main/java/ai/openclaw/app/PhoneDeviceAction.kt b/apps/android/app/src/main/java/ai/openclaw/app/PhoneDeviceAction.kt
new file mode 100644
index 00000000..0f7f8e76
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/PhoneDeviceAction.kt
@@ -0,0 +1,125 @@
+package ai.openclaw.app
+
+import android.app.AlarmManager
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.media.AudioManager
+import android.os.BatteryManager
+import android.os.Environment
+import android.os.StatFs
+import android.provider.AlarmClock
+import android.text.format.DateUtils
+import android.text.format.Formatter
+import android.view.KeyEvent
+import java.util.Locale
+import kotlin.math.roundToInt
+
+internal enum class PhoneDeviceAction {
+  Battery,
+  Storage,
+  MediaVolume,
+  RingerVolume,
+  NextAlarm,
+  ShowAlarms,
+  ShowTimers,
+  SnoozeAlarm,
+  DismissExpiredTimers,
+  PauseMedia,
+  ResumeMedia,
+  NextTrack,
+  PreviousTrack,
+  StopMedia,
+}
+
+internal fun parsePhoneDeviceAction(input: String): PhoneDeviceAction? {
+  if (input.length > 100 || input.any { it == '\n' || it == '\r' }) return null
+  val command = input.trim().lowercase(Locale.ROOT).replace('’', '\'').trimEnd('.', '?').removePrefix("please ")
+  return when (command) {
+    "what's my battery level", "what is my battery level", "check my battery", "battery level" -> PhoneDeviceAction.Battery
+    "how much storage is free on my phone", "check phone storage", "free phone storage" -> PhoneDeviceAction.Storage
+    "what's my volume", "tell me the volume", "what's my media volume", "check media volume" -> PhoneDeviceAction.MediaVolume
+    "what's my ringer volume", "check ringer volume" -> PhoneDeviceAction.RingerVolume
+    "when is my next alarm", "what's my next alarm", "check my next alarm" -> PhoneDeviceAction.NextAlarm
+    "show my alarms", "show alarms" -> PhoneDeviceAction.ShowAlarms
+    "show my timers", "show timers" -> PhoneDeviceAction.ShowTimers
+    "snooze alarm", "snooze the ringing alarm" -> PhoneDeviceAction.SnoozeAlarm
+    "dismiss expired timers", "stop ringing timers" -> PhoneDeviceAction.DismissExpiredTimers
+    "pause playback", "pause music", "pause the music", "pause the video" -> PhoneDeviceAction.PauseMedia
+    "resume playback", "resume music", "resume the music", "continue playing" -> PhoneDeviceAction.ResumeMedia
+    "next track", "next song", "skip this song" -> PhoneDeviceAction.NextTrack
+    "previous track", "previous song", "play previous song" -> PhoneDeviceAction.PreviousTrack
+    "stop playback", "stop music", "stop the video" -> PhoneDeviceAction.StopMedia
+    else -> null
+  }
+}
+
+internal data class PhoneDeviceResult(val message: String, val completed: Boolean = true)
+
+internal fun executePhoneDeviceAction(context: Context, action: PhoneDeviceAction): PhoneDeviceResult =
+  try {
+    when (action) {
+      PhoneDeviceAction.Battery -> {
+        val percent = context.getSystemService(BatteryManager::class.java)?.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
+        if (percent != null && percent in 0..100) PhoneDeviceResult("Battery is $percent%") else unavailablePhoneReading()
+      }
+      PhoneDeviceAction.Storage -> {
+        val bytes = StatFs(Environment.getDataDirectory().path).availableBytes
+        PhoneDeviceResult("${Formatter.formatFileSize(context, bytes)} free on this phone")
+      }
+      PhoneDeviceAction.MediaVolume -> volumeReading(context, AudioManager.STREAM_MUSIC, "Media")
+      PhoneDeviceAction.RingerVolume -> volumeReading(context, AudioManager.STREAM_RING, "Ringer")
+      PhoneDeviceAction.NextAlarm -> {
+        val manager = context.getSystemService(AlarmManager::class.java)
+        if (manager == null) {
+          unavailablePhoneReading()
+        } else {
+          val time = manager.nextAlarmClock?.triggerTime
+          val formatted = time?.let {
+            DateUtils.formatDateTime(context, it, DateUtils.FORMAT_SHOW_WEEKDAY or DateUtils.FORMAT_SHOW_DATE or DateUtils.FORMAT_SHOW_TIME)
+          }
+          PhoneDeviceResult(formatted?.let { "Next alarm is $it" } ?: "There is no upcoming alarm")
+        }
+      }
+      PhoneDeviceAction.ShowAlarms -> phoneClockCommand(context, AlarmClock.ACTION_SHOW_ALARMS, "Opening Clock")
+      PhoneDeviceAction.ShowTimers -> phoneClockCommand(context, AlarmClock.ACTION_SHOW_TIMERS, "Opening Clock")
+      PhoneDeviceAction.SnoozeAlarm -> phoneClockCommand(context, AlarmClock.ACTION_SNOOZE_ALARM, "Snooze request sent to Clock")
+      PhoneDeviceAction.DismissExpiredTimers -> phoneClockCommand(context, AlarmClock.ACTION_DISMISS_TIMER, "Dismiss request sent to Clock")
+      PhoneDeviceAction.PauseMedia -> mediaKey(context, KeyEvent.KEYCODE_MEDIA_PAUSE)
+      PhoneDeviceAction.ResumeMedia -> mediaKey(context, KeyEvent.KEYCODE_MEDIA_PLAY)
+      PhoneDeviceAction.NextTrack -> mediaKey(context, KeyEvent.KEYCODE_MEDIA_NEXT)
+      PhoneDeviceAction.PreviousTrack -> mediaKey(context, KeyEvent.KEYCODE_MEDIA_PREVIOUS)
+      PhoneDeviceAction.StopMedia -> mediaKey(context, KeyEvent.KEYCODE_MEDIA_STOP)
+    }
+  } catch (_: SecurityException) {
+    PhoneDeviceResult("Android blocked this action", completed = false)
+  }
+
+private fun unavailablePhoneReading() = PhoneDeviceResult("This phone reading is unavailable", completed = false)
+
+private fun volumeReading(context: Context, stream: Int, name: String): PhoneDeviceResult {
+  val audio = context.getSystemService(AudioManager::class.java) ?: return unavailablePhoneReading()
+  val maximum = audio.getStreamMaxVolume(stream)
+  if (maximum <= 0) return unavailablePhoneReading()
+  val percent = if (audio.isStreamMute(stream)) 0 else (audio.getStreamVolume(stream) * 100.0 / maximum).roundToInt().coerceIn(0, 100)
+  return PhoneDeviceResult("$name volume is $percent%")
+}
+
+private fun phoneClockCommand(context: Context, action: String, feedback: String): PhoneDeviceResult {
+  for (clock in listOf("com.sec.android.app.clockpackage", "com.google.android.deskclock")) {
+    try {
+      context.startActivity(Intent(action).setPackage(clock).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+      return PhoneDeviceResult(feedback)
+    } catch (_: ActivityNotFoundException) {
+      continue
+    }
+  }
+  return PhoneDeviceResult("No supported Clock app is available", completed = false)
+}
+
+private fun mediaKey(context: Context, code: Int): PhoneDeviceResult {
+  val audio = context.getSystemService(AudioManager::class.java) ?: return unavailablePhoneReading()
+  audio.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_DOWN, code))
+  audio.dispatchMediaKeyEvent(KeyEvent(KeyEvent.ACTION_UP, code))
+  return PhoneDeviceResult("Media command sent")
+}
diff --git a/apps/android/app/src/main/java/ai/openclaw/app/PhoneGoogleAction.kt b/apps/android/app/src/main/java/ai/openclaw/app/PhoneGoogleAction.kt
