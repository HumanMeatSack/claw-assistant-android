+package ai.openclaw.app.voice
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.media.AudioFormat
+import android.os.Build
+import android.os.Bundle
+import android.os.ParcelFileDescriptor
+import android.os.RemoteException
+import android.os.SystemClock
+import android.speech.RecognitionService
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import android.system.Os
+import android.system.OsConstants
+import android.system.StructPollfd
+import androidx.annotation.RequiresApi
+import androidx.core.content.ContextCompat
+import com.k2fsa.sherpa.onnx.SileroVadModelConfig
+import com.k2fsa.sherpa.onnx.Vad
+import com.k2fsa.sherpa.onnx.VadModelConfig
+import java.io.Closeable
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** Private, explicit-component recognizer. Audio and inference remain entirely on this phone. */
+@RequiresApi(Build.VERSION_CODES.TIRAMISU)
+class ParakeetRecognitionService : RecognitionService() {
+  private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+  @Volatile private var active: Capture? = null
+
+  private class Capture(val callback: Callback, val request: Intent) {
+    val cancelled = AtomicBoolean(false)
+    val finishing = AtomicBoolean(false)
+    var job: Job? = null
+    private val sourceLock = Any()
+    private var source: PcmSource? = null
+    // Take responsibility for the received descriptor at admission, even when
+    // cancellation wins before the asynchronous capture worker can start.
+    private val suppliedAudio = runCatching {
+      request.getParcelableExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE, ParcelFileDescriptor::class.java)
+    }
+
+    fun providedAudio(): ParcelFileDescriptor? = suppliedAudio.getOrThrow()
+
+    fun own(value: PcmSource) = synchronized(sourceLock) {
+      if (cancelled.get()) { value.close(); throw CancellationException("Speech capture replaced") }
+      source = value
+    }
+
+    fun closeSource() = synchronized(sourceLock) {
+      val old = source
+      source = null
+      runCatching { old?.close() }
+      runCatching { suppliedAudio.getOrNull()?.close() }
+      Unit
+    }
+
+    fun cancel() {
+      cancelled.set(true)
+      closeSource()
+      job?.cancel()
+    }
+  }
+
+  override fun onStartListening(recognizerIntent: Intent, listener: Callback) {
+    val previous = active
+    previous?.cancel()
+    val capture = Capture(listener, recognizerIntent)
+    active = capture
+    capture.job = scope.launch {
+      previous?.job?.join()
+      try {
+        if (ContextCompat.checkSelfPermission(this@ParakeetRecognitionService, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+          fail(capture, SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS)
+          return@launch
+        }
+        recognize(capture)
+      } catch (cancelled: CancellationException) {
+        throw cancelled
+      } catch (_: SecurityException) {
+        fail(capture, SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS)
+      } catch (_: ParakeetModelFailure) {
+        fail(capture, SpeechRecognizer.ERROR_SERVER)
+      } catch (_: IllegalArgumentException) {
+        fail(capture, SpeechRecognizer.ERROR_CLIENT)
+      } catch (_: Exception) {
+        fail(capture, SpeechRecognizer.ERROR_AUDIO)
+      } catch (_: LinkageError) {
+        fail(capture, SpeechRecognizer.ERROR_SERVER)
+      } finally {
+        capture.closeSource()
+        if (active === capture) active = null
+      }
+    }
+  }
+
+  override fun onStopListening(listener: Callback) {
+    active?.takeIf { it.callback === listener }?.finishing?.set(true)
+  }
+
+  override fun onCancel(listener: Callback) {
+    active?.takeIf { it.callback === listener }?.let {
+      active = null
+      it.cancel()
+    }
+  }
+
+  override fun onDestroy() {
+    active?.cancel()
+    active = null
+    scope.cancel()
+    super.onDestroy()
+  }
+
+  private suspend fun recognize(capture: Capture) {
+    val provided = capture.providedAudio()
+    val silenceMs = parakeetSilenceMillis(
+      capture.request.getLongExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 0L),
+      provided != null,
+    )
+    val segmented = provided != null &&
+      capture.request.getStringExtra(RecognizerIntent.EXTRA_SEGMENTED_SESSION) == RecognizerIntent.EXTRA_AUDIO_SOURCE
+    var partial: Job? = null
+    var durationExceeded = false
+    val audio = ParakeetAudioBuffer()
+    val pcm = ParakeetPcm16()
+    try {
+      withContext(Dispatchers.IO) {
+        val input = if (provided != null) {
+          require(capture.request.getIntExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_SAMPLING_RATE, 16_000) == 16_000)
+          require(capture.request.getIntExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_CHANNEL_COUNT, 1) == 1)
+          require(capture.request.getIntExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE_ENCODING, AudioFormat.ENCODING_PCM_16BIT) == AudioFormat.ENCODING_PCM_16BIT)
+          PipeSource(provided)
+        } else {
+          MicrophoneSource(AndroidAudioInputSession.open(
+            this@ParakeetRecognitionService, sampleRateHz = 16_000, frameBytes = 640,
+            isCurrent = { current(capture) }, onFocusLost = { capture.cancel() },
+          ))
+        }
+        capture.own(input)
+        val vad = try { Vad(
+          assetManager = assets,
+          config = VadModelConfig(
+            sileroVadModelConfig = SileroVadModelConfig(
+              model = "aiden-asr/silero_vad.onnx", threshold = 0.5f,
+              minSilenceDuration = silenceMs / 1000f, minSpeechDuration = 0.18f,
+              // The capture bound below reports a timeout instead of treating a
+              // forced VAD segment as a completed user instruction.
+              maxSpeechDuration = 100f,
+            ),
+            sampleRate = 16_000, numThreads = 1, provider = "cpu",
+          ),
+        ) } catch (error: Exception) { throw ParakeetModelFailure(error) }
+        val bytes = ByteArray(640)
+        try {
+          input.start()
+          signal(capture) { readyForSpeech(Bundle()) }
+          val startedAt = SystemClock.elapsedRealtime()
+          var lastPartialSize = 0
+
+          suspend fun decodeSegment(): String {
+            partial?.cancelAndJoin()
+            partial = null
+            signal(capture) { endOfSpeech() }
+            val snapshot = audio.snapshot()
+            return try {
+              if (snapshot.isEmpty()) "" else ParakeetDecoder.decode(this@ParakeetRecognitionService, snapshot)
+            } finally { snapshot.fill(0f) }
+          }
+
+          suspend fun completeSegment() {
+            val text = decodeSegment()
+            if (text.isNotBlank()) signal(capture) { segmentResults(transcriptBundle(text)) }
+            // An echo fragment may be ignored by the caller. Keep this same
+            // input session alive so a later real cut-in is still heard.
+            audio.clear()
+            vad.reset()
+            lastPartialSize = 0
+          }
+
+          while (currentCoroutineContext().isActive && current(capture) && !capture.finishing.get()) {
+            val count = input.read(bytes)
+            if (count < 0) break
+            if (count == 0) continue
+            val samples = pcm.decode(bytes, count)
+            try {
+              audio.append(samples)
+              vad.acceptWaveform(samples)
+              if (!audio.started && vad.isSpeechDetected()) {
+                audio.beginSpeech()
+                signal(capture) { beginningOfSpeech() }
+              }
+            } finally { samples.fill(0f) }
+            if (audio.started) {
+              // Parakeet is non-streaming: at most one provisional decode is in flight.
+              // Re-evaluate the whole bounded utterance so names can correct earlier guesses.
+              if (capture.request.getBooleanExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false) &&
+                audio.size - lastPartialSize >= 12_000 && partial?.isActive != true
+              ) {
+                lastPartialSize = audio.size
+                val snapshot = audio.snapshot()
+                partial = scope.launch(start = CoroutineStart.UNDISPATCHED) {
+                  try {
+                    val text = ParakeetDecoder.decode(this@ParakeetRecognitionService, snapshot)
+                    if (text.isNotBlank()) signal(capture) { partialResults(transcriptBundle(text)) }
+                  } catch (cancelled: CancellationException) {
+                    throw cancelled
+                  } catch (_: Exception) {
+                    // A provisional hypothesis is optional; the final decode owns failure.
+                  } catch (_: LinkageError) {
+                    // The final decode reports an unavailable native engine to the caller.
+                  } finally { snapshot.fill(0f) }
+                }
+              }
+              if (audio.full) { durationExceeded = true; break }
+              if (!vad.empty()) {
+                if (segmented) completeSegment() else break
+              }
+            } else if (provided == null && SystemClock.elapsedRealtime() - startedAt >= 30_000L) {
+              break
+            }
+          }
+          if (segmented && !durationExceeded) {
+            if (audio.started) completeSegment()
+            // Retire the owned stream before the terminal callback can re-arm
+            // another microphone/recognizer in the caller.
+            capture.closeSource()
+            signal(capture) { endOfSegmentedSession() }
+          }
+        } finally {
+          bytes.fill(0)
+          vad.release()
+          capture.closeSource()
+        }
+      }
+      currentCoroutineContext().ensureActive()
+      partial?.cancelAndJoin()
+      if (durationExceeded) {
+        fail(capture, SpeechRecognizer.ERROR_SPEECH_TIMEOUT)
+        return
+      }
+      if (segmented) return
+      signal(capture) { endOfSpeech() }
+      val snapshot = audio.snapshot()
+      val result = try {
+        if (snapshot.isEmpty()) "" else ParakeetDecoder.decode(this, snapshot)
+      } finally { snapshot.fill(0f) }
+      if (result.isBlank()) fail(capture, SpeechRecognizer.ERROR_NO_MATCH)
+      else signal(capture) { results(transcriptBundle(result)) }
+    } finally {
+      // Native inference is synchronous. Join its worker even on cancellation
+      // before zeroing buffers; it must never read a cleared/reused PCM array.
+      withContext(NonCancellable) { partial?.cancelAndJoin() }
+      capture.closeSource()
+      audio.clear()
+      pcm.clear()
+    }
+  }
+
+  private fun current(capture: Capture): Boolean = active === capture && !capture.cancelled.get()
+
+  private suspend fun signal(capture: Capture, block: Callback.() -> Unit) = withContext(Dispatchers.Main.immediate) {
+    if (current(capture)) {
+      try { capture.callback.block() } catch (_: RemoteException) { capture.cancel() }
+    }
+  }
+
+  private suspend fun fail(capture: Capture, code: Int) {
+    capture.closeSource()
+    signal(capture) { error(code) }
+  }
+
+  private interface PcmSource : Closeable {
+    fun start() {}
+    fun read(bytes: ByteArray): Int
+  }
+
+  private class MicrophoneSource(private val input: AndroidAudioInputSession) : PcmSource {
+    override fun start() = input.startRecording()
+    override fun read(bytes: ByteArray): Int = input.read(bytes, 0, bytes.size)
+    override fun close() = input.close()
+  }
+
+  private class PipeSource(source: ParcelFileDescriptor) : PcmSource {
+    private val descriptor = ParcelFileDescriptor.dup(source.fileDescriptor)
+    private val stream = ParcelFileDescriptor.AutoCloseInputStream(descriptor)
+    private val closed = AtomicBoolean(false)
+    override fun read(bytes: ByteArray): Int {
+      if (closed.get()) return -1
+      val poll = StructPollfd().apply { fd = descriptor.fileDescriptor; events = OsConstants.POLLIN.toShort() }
+      if (Os.poll(arrayOf(poll), 100) == 0) return 0
+      return if (closed.get()) -1 else stream.read(bytes)
+    }
+    override fun close() { if (closed.compareAndSet(false, true)) stream.close() }
+  }
+}
+
+internal fun parakeetSilenceMillis(requested: Long, suppliedAudio: Boolean): Long =
+  if (suppliedAudio) (if (requested > 0) requested else 900L).coerceIn(600L, 1_500L)
+  else (if (requested > 0) requested else 1_200L).coerceIn(1_000L, 2_000L)
+
+private fun transcriptBundle(text: String) = Bundle().apply {
+  putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf(text))
+}
diff --git a/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/voice/PlatformAlbaSpeech.kt b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/voice/PlatformAlbaSpeech.kt
new file mode 100644
index 0000000000000000000000000000000000000000..d3dd9a9d2a7c8d54352206d8c2ad18214e7e835d
--- /dev/null
+++ b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/voice/PlatformAlbaSpeech.kt
@@ -0,0 +1,347 @@
+package ai.openclaw.app.voice
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.Build
+import android.os.SystemClock
+import android.util.Log
+import com.k2fsa.sherpa.onnx.GenerationConfig
+import com.k2fsa.sherpa.onnx.OfflineTts
+import com.k2fsa.sherpa.onnx.OfflineTtsConfig
+import com.k2fsa.sherpa.onnx.OfflineTtsModelConfig
+import com.k2fsa.sherpa.onnx.OfflineTtsPocketModelConfig
+import com.k2fsa.sherpa.onnx.WaveReader
+import java.util.concurrent.atomic.AtomicLong
+import java.util.concurrent.locks.LockSupport
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.job
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+internal fun createAlbaSpeech(context: Context): AlbaSpeech? {
+  if ("arm64-v8a" !in Build.SUPPORTED_ABIS) return null
+  val available = runCatching { context.assets.list(modelDir)?.toSet().orEmpty() }.getOrDefault(emptySet())
+  // Alba is optional in the public build. Missing weights use the installed offline system voice.
+  return if (available.containsAll(requiredAssets)) PocketAlbaSpeech(context.applicationContext) else null
+}
+
+private const val tag = "AlbaSpeech"
+private const val modelDir = "aiden-alba"
+private const val playbackPollMs = 5L
+private const val engineIdleMs = 45_000L
+private val requiredAssets =
+  setOf(
+    "alba.wav",
+    "lm_flow.int8.onnx",
+    "lm_main.int8.onnx",
+    "encoder.onnx",
+    "decoder.int8.onnx",
+    "text_conditioner.onnx",
+    "vocab.json",
+    "token_scores.json",
+  )
+
+private class PocketAlbaSpeech(private val context: Context) : AlbaSpeech {
+  override suspend fun warm() {
+    try {
+      withContext(Dispatchers.Default) {
+        PocketRuntime.use(context) { engine ->
+          if (!engine.warmed) engine.generate("Ready.", 1f) { 0 }
+        }
+      }
+    } catch (cancelled: CancellationException) {
+      throw cancelled
+    } catch (error: Exception) {
+      Log.w(tag, "Alba preparation unavailable (${error.javaClass.simpleName})")
+    } catch (error: LinkageError) {
+      Log.w(tag, "Alba runtime unavailable (${error.javaClass.simpleName})")
+    }
+  }
+
+  override suspend fun speak(text: String, speechRate: Float?, communicationAudio: Boolean, beforeSpeak: () -> Unit): Boolean {
+    if (text.isBlank()) return false
+    val startedAt = SystemClock.elapsedRealtime()
+    val diagnostic = AlbaPlaybackDiagnostics.begin(speechRate ?: 1f, communicationAudio)
+    var report = AlbaPlaybackReport(phase = "preparing")
+    fun publish(next: AlbaPlaybackReport) {
+      report = next
+      AlbaPlaybackDiagnostics.publish(diagnostic, next)
+    }
+    var played = false
+    try {
+      withContext(Dispatchers.IO) {
+        streamReply(text, speechRate ?: 1f, communicationAudio, beforeSpeak, ::publish) {
+          if (!played) Log.d(tag, "First audio queued in ${SystemClock.elapsedRealtime() - startedAt} ms")
+          played = true
+        }
+      }
+    } catch (cancelled: CancellationException) {
+      publish(report.copy(phase = "cancelled"))
+      throw cancelled
+    } catch (error: Exception) {
+      publish(report.copy(phase = "failed"))
+      Log.w(tag, "Alba playback unavailable (${error.javaClass.simpleName})")
+      if (played) {
+        Log.w(tag, "alba_playback partial_audio_failed")
+        throw IllegalStateException("Alba audio playback stopped early", error)
+      }
+    } catch (error: LinkageError) {
+      publish(report.copy(phase = "failed"))
+      Log.w(tag, "Alba runtime unavailable (${error.javaClass.simpleName})")
+      if (played) {
+        Log.w(tag, "alba_playback partial_runtime_failed")
+        throw IllegalStateException("Alba audio runtime stopped early", error)
+      }
+    }
+    if (!played) publish(report.copy(phase = "failed"))
+    return played
+  }
+
+  private suspend fun streamReply(
+    text: String,
+    speed: Float,
+    communicationAudio: Boolean,
+    beforeSpeak: () -> Unit,
+    publish: (AlbaPlaybackReport) -> Unit,
+    onAudioQueued: () -> Unit,
+  ) = coroutineScope {
+    val chunks = Channel<FloatArray>(capacity = 2)
+    val sampleRate = CompletableDeferred<Int>()
+    val generatedFrames = AtomicLong()
+    val generator = launch(Dispatchers.Default) {
+      val request = coroutineContext.job
+      try {
+        PocketRuntime.use(context) { engine ->
+          sampleRate.complete(engine.sampleRate)
+          engine.generate(text, speed) { samples ->
+            if (!request.isActive) return@generate 0
+            if (samples.isEmpty()) return@generate 1
+            generatedFrames.addAndGet(samples.size.toLong())
+            while (request.isActive) {
+              val result = chunks.trySend(samples)
+              if (result.isSuccess) return@generate 1
+              if (result.isClosed) return@generate 0
+              // The native callback cannot suspend. Bound queued PCM and stop on cancellation.
+              LockSupport.parkNanos(2_000_000)
+            }
+            0
+          }
+        }
+      } catch (error: Exception) {
+        chunks.close(error)
+      } catch (error: LinkageError) {
+        chunks.close(error)
+      } finally {
+        chunks.close()
+      }
+    }
+    try {
+      val first = chunks.receiveCatching()
+      first.exceptionOrNull()?.let { throw it }
+      val initialAudio = first.getOrNull() ?: return@coroutineScope
+      val sourceRate = sampleRate.await()
+      val track = buildAudioTrack(sourceRate, communicationAudio)
+      var written = 0L
+      var startedPlaybackAt: Long? = null
+      var completed = false
+      var report = AlbaPlaybackReport(phase = "playing", sourceRateHz = sourceRate)
+      try {
+        report = report.copy(
+          trackRateHz = track.sampleRate,
+          playbackRateHz = track.playbackRate,
+          encoding = track.audioFormat,
+          speed = runCatching { track.playbackParams.speed }.getOrNull(),
+          pitch = runCatching { track.playbackParams.pitch }.getOrNull(),
+        )
+        withContext(Dispatchers.Main.immediate) { beforeSpeak() }
+        startedPlaybackAt = SystemClock.elapsedRealtime()
+        publish(report)
+        track.play()
+        fun audioQueued(count: Int) {
+          written += count
+          onAudioQueued()
+        }
+        writeAudio(track, initialAudio, ::audioQueued)
+        for (samples in chunks) writeAudio(track, samples, ::audioQueued)
+        if (communicationAudio) {
+          // Keep the speaker route through a real rendered silence tail before
+          // capture retirement withdraws MODE_IN_COMMUNICATION.
+          writeAudio(track, FloatArray(track.sampleRate * 150 / 1000)) { count -> written += count }
+        }
+        drainAudio(track, written)
+        completed = true
+      } finally {
+        try {
+          publish(report.copy(
+            // The outer speaker distinguishes an error from cancellation after cleanup.
+            phase = if (completed) "completed" else "playing",
+            generatedFrames = generatedFrames.get(),
+            writtenFrames = written,
+            renderedFrames = runCatching { track.playbackHeadPosition.toUInt().toLong() }.getOrNull(),
+            playbackElapsedMs = startedPlaybackAt?.let { SystemClock.elapsedRealtime() - it },
+            underruns = runCatching { track.underrunCount }.getOrNull(),
+          ))
+        } finally {
+          track.release()
+        }
+      }
+    } finally {
+      chunks.cancel()
+      generator.cancel()
+    }
+  }
+}
+
+private fun buildAudioTrack(sampleRate: Int, communicationAudio: Boolean): AudioTrack {
+  val channel = AudioFormat.CHANNEL_OUT_MONO
+  val encoding = AudioFormat.ENCODING_PCM_16BIT
+  val minimumBuffer = AudioTrack.getMinBufferSize(sampleRate, channel, encoding)
+  check(minimumBuffer > 0)
+  val track = AudioTrack.Builder()
+    .setAudioAttributes(
+      if (communicationAudio) RealtimeCommunicationAudio.playbackAttributes() else AudioAttributes.Builder()
+        .setUsage(AudioAttributes.USAGE_MEDIA)
+        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH)
+        .build(),
+    ).setAudioFormat(
+      AudioFormat.Builder()
+        .setChannelMask(channel)
+        .setEncoding(encoding)
+        .setSampleRate(sampleRate)
+        .build(),
+    ).setTransferMode(AudioTrack.MODE_STREAM)
+    .setBufferSizeInBytes(maxOf(minimumBuffer, sampleRate * Short.SIZE_BYTES / 5))
+    .build()
+  try {
+    check(track.state == AudioTrack.STATE_INITIALIZED) { "Alba AudioTrack did not initialize" }
+    track.setStartThresholdInFrames(1)
+    return track
+  } catch (error: Throwable) {
+    track.release()
+    throw error
+  }
+}
+
+private suspend fun writeAudio(track: AudioTrack, samples: FloatArray, onAudioQueued: (Int) -> Unit) {
+  val pcm = albaPcm16(samples)
+  var offset = 0
+  while (offset < pcm.size) {
+    kotlin.coroutines.coroutineContext.ensureActive()
+    val written = track.write(pcm, offset, pcm.size - offset, AudioTrack.WRITE_NON_BLOCKING)
+    check(written >= 0) { "Alba AudioTrack write failed ($written)" }
+    if (written > 0) {
+      onAudioQueued(written)
+      offset += written
+    } else {
+      delay(playbackPollMs)
+    }
+  }
+}
+
+private suspend fun drainAudio(track: AudioTrack, frames: Long) {
+  val deadline = SystemClock.elapsedRealtime() + 1_000L + track.bufferSizeInFrames * 1_000L / track.sampleRate
+  while (track.playbackHeadPosition.toUInt().toLong() < frames) {
+    check(SystemClock.elapsedRealtime() < deadline) { "Alba AudioTrack did not drain" }
+    delay(playbackPollMs)
+  }
+}
+
+/** Shares the native model across sessions and releases it after short inactivity. */
+private object PocketRuntime {
+  private val mutex = Mutex()
+  private val idleScope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+  private var engine: PocketEngine? = null
+  private var retirement: Job? = null
+
+  suspend fun use(context: Context, block: (PocketEngine) -> Unit) = mutex.withLock {
+    retirement?.cancel()
+    val active = engine ?: PocketEngine(context).also { engine = it }
+    try {
+      block(active)
+    } finally {
+      retirement = idleScope.launch {
+        delay(engineIdleMs)
+        mutex.withLock {
+          coroutineContext.ensureActive()
+          engine?.close()
+          engine = null
+        }
+      }
+    }
+  }
+}
+
+private class PocketEngine(context: Context) {
+  private val assets = context.assets
+
+  init {
+    check(assets.list(modelDir)?.toSet()?.containsAll(requiredAssets) == true) { "Alba model is unavailable" }
+  }
+
+  private val voice = WaveReader.readWave(assets, "$modelDir/alba.wav")
+
+  init {
+    check(voice.sampleRate > 0 && voice.samples.isNotEmpty()) { "Alba voice sample is unavailable" }
+  }
+
+  private val tts = OfflineTts(
+    assetManager = assets,
+    config = OfflineTtsConfig(
+      model = OfflineTtsModelConfig(
+        pocket = OfflineTtsPocketModelConfig(
+          lmFlow = "$modelDir/lm_flow.int8.onnx",
+          lmMain = "$modelDir/lm_main.int8.onnx",
+          encoder = "$modelDir/encoder.onnx",
+          decoder = "$modelDir/decoder.int8.onnx",
+          textConditioner = "$modelDir/text_conditioner.onnx",
+          vocabJson = "$modelDir/vocab.json",
+          tokenScoresJson = "$modelDir/token_scores.json",
+          voiceEmbeddingCacheCapacity = 1,
+        ),
+        numThreads = 2,
+      ),
+    ),
+  )
+
+  val sampleRate: Int get() = tts.sampleRate()
+  var warmed = false
+    private set
+
+  fun generate(text: String, speed: Float, callback: (FloatArray) -> Int) {
+    tts.generateWithConfigAndCallback(
+      text,
+      GenerationConfig(
+        speed = speed,
+        referenceAudio = voice.samples,
+        referenceSampleRate = voice.sampleRate,
+        numSteps = 5,
+        extra = mapOf("temperature" to "0.7", "chunk_size" to "8"),
+      ),
+      PocketAudioCallback { samples ->
+        if (samples.isNotEmpty()) warmed = true
+        callback(samples)
+      },
+    )
+  }
+
+  fun close() = tts.release()
+}
+
+// Sherpa 2.0.1 JNI resolves invoke(float[]) returning java.lang.Integer on
+// the concrete callback class. Android's desugared lambda only has the bridge.
+private class PocketAudioCallback(private val onSamples: (FloatArray) -> Int) : (FloatArray) -> Int {
+  override fun invoke(samples: FloatArray): Int = onSamples(samples)
+}
