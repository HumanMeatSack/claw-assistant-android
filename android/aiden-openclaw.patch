+  }
+
+  private fun textButton(@StringRes label: Int, action: () -> Unit): Button =
+    Button(context).apply {
+      setAllCaps(false)
+      setText(label)
+      textSize = 15f
+      gravity = Gravity.CENTER_VERTICAL or Gravity.START
+      minHeight = dp(48)
+      minimumHeight = dp(48)
+      minWidth = 0
+      minimumWidth = 0
+      stateListAnimator = null
+      compoundDrawablePadding = dp(5)
+      setPaddingRelative(dp(7), dp(2), dp(7), dp(2))
