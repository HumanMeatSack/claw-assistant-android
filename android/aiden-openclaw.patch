@@ -0,0 +1,64 @@
+package ai.openclaw.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class PhoneGoogleActionTest {
+  @Test
+  fun `recognizes explicit Google app and Gmail search requests`() {
+    assertEquals(PhoneGoogleAction.OpenGmail, parsePhoneGoogleAction("Please open Gmail."))
+    assertEquals(PhoneGoogleAction.OpenPhotos, parsePhoneGoogleAction("Open the Google Photos app"))
+    assertEquals(
+      PhoneGoogleAction.SearchGmail("from:alex@example.com is:unread"),
+      parsePhoneGoogleAction("Search Gmail for from:alex@example.com is:unread"),
+    )
+    assertEquals(PhoneGoogleAction.SearchGmail("\"July invoice\""), parsePhoneGoogleAction("Find \"July invoice\" in Gmail."))
+  }
+
+  @Test
+  fun `preserves the explicit recipient and draft fields`() {
+    val draft = PhoneGoogleAction.DraftEmail("Alex+Test@example.com", "Lunch & errands", "At 2? Thanks!")
+    assertEquals(
+      draft,
+      parsePhoneGoogleAction("Draft an email to Alex+Test@example.com with subject Lunch & errands saying At 2? Thanks!"),
+    )
+    assertEquals(
+      PhoneGoogleAction.DraftEmail("alex@example.com", "", "Hi!"),
+      parsePhoneGoogleAction("Draft a Gmail to alex@example.com saying Hi!"),
+    )
+    assertEquals(
+      PhoneGoogleAction.DraftEmail("alex@example.com", "", ""),
+      parsePhoneGoogleAction("Draft an email to alex@example.com."),
+    )
+  }
+
+  @Test
+  fun `keeps URL separators inside their input fields`() {
+    assertEquals(
+      "https://mail.google.com/mail/u/0/#search/from%3Aalex%2Btag%40example.com+%23a%2Fb%3Fx%26y",
+      gmailSearchUrl("from:alex+tag@example.com #a/b?x&y"),
+    )
+    assertEquals(
+      "mailto:Alex%2BTest@example.com?subject=Lunch%20%26%20errands&body=At%202%3F%20Th%C3%A1nks%21",
+      gmailDraftUri(PhoneGoogleAction.DraftEmail("Alex+Test@example.com", "Lunch & errands", "At 2? Thánks!")),
+    )
+    assertEquals("mailto:alex@example.com", gmailDraftUri(PhoneGoogleAction.DraftEmail("alex@example.com", "", "")))
+  }
+
+  @Test
+  fun `rejects implicit queries sending commands and unsafe recipients`() {
+    listOf(
+      "Why should I search Gmail for bills?",
+      "Search Gmail for",
+      "Search Gmail for a receipt\nthen delete it",
+      "Search Google Photos for December",
+      "Summarize my inbox",
+      "Send an email to alex@example.com saying hello",
+      "Draft an email to Alex saying hello",
+      "Draft an email to alex@example.com,bob@example.com saying hello",
+      "Draft an email to alex@example.com?bcc=bob@example.com saying hello",
+      "Draft an email to alex@example.com saying ${"x".repeat(1001)}",
+    ).forEach { input -> assertNull(input, parsePhoneGoogleAction(input)) }
+  }
+}
