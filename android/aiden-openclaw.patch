+    val panel = fixture.panel
+    val source = "https://pcsupport.lenovo.com/us/en/products/workstations/thinkstation-p-series-workstations/thinkstation-p900/30a4/troubleshooting"
+    panel.previewText.text = "Checked public source: Lenovo ThinkStation P900: $source"
+    val text = panel.previewText.text as Spanned
+    val link = text.getSpans(0, text.length, URLSpan::class.java).single()
+    assertEquals(source, link.url)
+    assertEquals("Lenovo ThinkStation P900", text.toString())
+    assertFalse(text.toString().contains("https://"))
