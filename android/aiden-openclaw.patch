+package ai.openclaw.app.voice
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AlbaPcmTest {
+  @Test
+  fun conversionKeepsEveryMonoFrameAndItsOrder() {
+    assertArrayEquals(
+      shortArrayOf(0, 16_384, -16_383, 32_767, -32_767),
+      albaPcm16(floatArrayOf(0f, 0.5f, -0.5f, 1f, -1f)),
+    )
+  }
+
+  @Test
+  fun clipsPeaksWithoutWrappingToTheOppositePolarity() {
+    assertArrayEquals(shortArrayOf(32_767, -32_767), albaPcm16(floatArrayOf(1.2f, -1.2f)))
+  }
+
+  @Test
+  fun rejectsNonFinitePcmInsteadOfRenderingNoise() {
+    for (value in floatArrayOf(Float.NaN, Float.POSITIVE_INFINITY, Float.NEGATIVE_INFINITY)) {
+      assertTrue(runCatching { albaPcm16(floatArrayOf(value)) }.exceptionOrNull() is IllegalArgumentException)
+    }
+  }
+
+  @Test
+  fun streamingBoundariesDoNotResampleOrDropFrames() {
+    val frames = FloatArray(24_000) { index -> if (index % 2 == 0) 0.25f else -0.25f }
+    val chunks = frames.toList().chunked(7_680).flatMap { albaPcm16(it.toFloatArray()).asList() }.toShortArray()
+    assertEquals(24_000, chunks.size)
+    assertArrayEquals(albaPcm16(frames), chunks)
+  }
+}
