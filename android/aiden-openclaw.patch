+<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
+    android:sessionService="ai.openclaw.app.assistant.AidenAssistantSessionService"
+    android:recognitionService="ai.openclaw.app.assistant.AidenLegacyRecognitionService"
