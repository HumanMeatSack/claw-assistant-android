+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.TestScope
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.resetMain
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import kotlinx.coroutines.test.setMain
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotSame
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadows.ShadowSpeechRecognizer
+import org.robolectric.shadows.ShadowSystemClock
+import org.robolectric.util.ReflectionHelpers
+import java.time.Duration
+
+@OptIn(ExperimentalCoroutinesApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], application = Application::class)
+class OfflineSpeechClientTest {
+  @Test
+  fun bufferedPartialsWaitForAudioEndpointAndPreserveTheFinalUtterance() =
+    runTest {
+      withBundledConversation { manager, requests ->
+        val recognizer = currentRecognizer()
+        recognizer.triggerOnPartialResults(results("Give me a link to"))
+        tick(2_000)
+        assertTrue("A gap between partial decodes must not submit an unfinished turn", requests.isEmpty())
+        assertTrue(manager.isListening.value)
+        assertFalse(recognizer.isDestroyed)
+
+        recognizer.triggerOnPartialResults(results("Give me a link to ThinkStation"))
+        tick(2_000)
+        assertTrue(requests.isEmpty())
+        recognizer.triggerOnResults(results("Give me a link to ThinkStation P900"))
+        tick(600)
+
+        assertEquals(listOf("Give me a link to ThinkStation P900"), requests)
+        assertTrue("An ordinary completed reply must rearm the conversation", manager.isListening.value)
+        assertTrue(recognizer.isDestroyed)
+        assertNotSame(recognizer, currentRecognizer())
+      }
+    }
+
+  @Test
+  fun finalResultSurvivesTheOldRestartDelayAndEachNewTurnSubmitsOnce() =
+    runTest {
+      withBundledConversation { manager, requests ->
+        val retired = currentRecognizer()
+        retired.triggerOnResults(results("First completed offline turn"))
+        tick(1_000)
+        assertEquals(listOf("First completed offline turn"), requests)
+        assertTrue(manager.isListening.value)
+
+        val current = currentRecognizer()
+        retired.triggerOnResults(results("Late duplicate from the retired recognizer"))
+        current.triggerOnPartialResults(results("Second unfinished"))
+        tick(1_000)
+        assertEquals("A previous final must not leak into the replacement listener", 1, requests.size)
+        current.triggerOnResults(results("Second completed offline turn"))
+        tick(1_000)
+        assertEquals(listOf("First completed offline turn", "Second completed offline turn"), requests)
+        assertTrue(manager.isListening.value)
+      }
+    }
+
+  @Test
+  fun closingConversationDiscardsPartialAndLateFinalInsteadOfSendingIt() =
+    runTest {
+      withBundledConversation { manager, requests ->
+        val recognizer = currentRecognizer()
+        recognizer.triggerOnPartialResults(results("Do not send this incomplete request"))
+        manager.setEnabled(false)
+        recognizer.triggerOnResults(results("Late final after the panel closed"))
+        tick(1_000)
+        assertTrue(requests.isEmpty())
+        assertFalse(manager.isListening.value)
+        assertFalse(manager.isEnabled.value)
+      }
+    }
+
+  @Test
+  fun unavailableModelStopsConversationWithoutRetryingOrSendingItsPartial() =
+    runTest {
+      withBundledConversation { manager, requests ->
+        val recognizer = currentRecognizer()
+        recognizer.triggerOnPartialResults(results("Never submit this failed offline recognition"))
+        recognizer.triggerOnError(SpeechRecognizer.ERROR_SERVER)
+        tick(1_000)
+
+        assertFalse(manager.isEnabled.value)
+        assertFalse(manager.isListening.value)
+        assertTrue(recognizer.isDestroyed)
+        assertNotNull(manager.failureNotice.value)
+        assertEquals("Offline speech recognition unavailable.", manager.failureNotice.value?.text)
+        assertTrue(requests.isEmpty())
+        assertSame("An unavailable model must not enter a recognizer reload loop", recognizer, currentRecognizer())
+      }
+    }
+
+  @Test
+  fun pushToTalkAutoStopWaitsForAudioEndpointAndDrainsTheSegmentedSession() =
+    runTest {
+      withBundledConversation { manager, requests ->
+        // Isolate the PTT endpointer from its AudioRecord/pipe transport; the
+        // recognizer callbacks and monitor below are the production owners.
+        val captureId = "offline-ptt-endpoint-test"
+        val owner = checkNotNull(ShadowSpeechRecognizer.getLatestSpeechRecognizer())
+        setField(manager, "activePttCaptureId", captureId)
+        setField(manager, "pttAutoStopEnabled", true)
+        val rungClass = Class.forName("ai.openclaw.app.voice.PushToTalkRecognitionRung\$SilenceSegmented")
+        setField(manager, "pttRecognitionRung", rungClass.getField("INSTANCE").get(null))
+        val listener = manager.javaClass.getDeclaredMethod(
+          "recognitionListener", String::class.java, SpeechRecognizer::class.java,
+        ).apply { isAccessible = true }.invoke(manager, captureId, owner) as RecognitionListener
+        owner.setRecognitionListener(listener)
+        manager.javaClass.getDeclaredMethod("startSilenceMonitor", String::class.java)
+          .apply { isAccessible = true }.invoke(manager, captureId)
+        runCurrent()
+
+        listener.onPartialResults(results("Check the unfinished"))
+        tick(2_000)
+        assertEquals(captureId, manager.activePushToTalkCaptureId)
+        assertNull(field(manager, "pttReleaseCompletion"))
+        assertTrue("PTT must keep capturing between offline partial decodes", manager.isListening.value)
+        assertTrue(requests.isEmpty())
+
+        listener.onSegmentResults(results("Check the completed ThinkStation P900 request"))
+        tick(200)
+        assertNotNull("A final audio endpoint should begin PTT release", field(manager, "pttReleaseCompletion"))
+        assertTrue("The final segment must drain before submission", requests.isEmpty())
+        listener.onEndOfSegmentedSession()
+        tick(600)
+        assertEquals(listOf("Check the completed ThinkStation P900 request"), requests)
+        assertNull(manager.activePushToTalkCaptureId)
+        assertTrue(manager.isListening.value)
+      }
+    }
+
+  private suspend fun TestScope.withBundledConversation(
+    block: suspend TestScope.(TalkModeManager, MutableList<String>) -> Unit,
+  ) {
+    val previousAbis = Build.SUPPORTED_ABIS
+    val managerJob = SupervisorJob(coroutineContext[Job])
+    val dispatcher = StandardTestDispatcher(testScheduler)
+    val app = RuntimeEnvironment.getApplication()
+    val requests = mutableListOf<String>()
+    var manager: TalkModeManager? = null
+    Dispatchers.setMain(dispatcher)
+    ReflectionHelpers.setStaticField(Build::class.java, "SUPPORTED_ABIS", arrayOf("arm64-v8a"))
+    try {
+      shadowOf(app).grantPermissions(Manifest.permission.RECORD_AUDIO)
+      assertEquals(
+        ComponentName(app, ParakeetRecognitionService::class.java),
+        BundledOfflineSpeech.component(app),
+      )
+      val session = GatewaySession(
+        scope = backgroundScope,
+        identityStore = testDeviceIdentityStore(app),
+        deviceAuthStore = DeviceAuthStore(SecurePrefs(app, app.getSharedPreferences("offline-speech-client-test", 0))),
+        onConnected = {},
+        onDisconnected = {},
+        onEvent = { _, _ -> },
+      )
+      val active = TalkModeManager(
+        context = app,
+        scope = CoroutineScope(coroutineContext + managerJob),
+        session = session,
+        isConnected = { true },
+        handleAssistantTurn = { transcript ->
+          requests += transcript
+          AssistantConversationTurn.Reply("Synthetic local reply")
+        },
+      )
+      manager = active
+      // The boundary under test ends at the reply callback; no audio synthesis or native JNI.
+      active.setPlaybackEnabled(false)
+      active.setEnabled(true)
+      runCurrent()
+      shadowOf(Looper.getMainLooper()).idle()
+      runCurrent()
+      assertTrue("The normal native entry point must start the bundled listener", active.isListening.value)
+      block(active, requests)
+    } finally {
+      manager?.setEnabled(false)
+      runCurrent()
+      shadowOf(Looper.getMainLooper()).idle()
+      managerJob.cancelAndJoin()
+      ReflectionHelpers.setStaticField(Build::class.java, "SUPPORTED_ABIS", previousAbis)
+      Dispatchers.resetMain()
+    }
+  }
+
+  private fun TestScope.tick(millis: Long) {
+    var remaining = millis
+    while (remaining > 0) {
+      val step = minOf(100L, remaining)
+      ShadowSystemClock.advanceBy(Duration.ofMillis(step))
+      advanceTimeBy(step)
+      shadowOf(Looper.getMainLooper()).idle()
+      runCurrent()
+      remaining -= step
+    }
+  }
+
+  private fun currentRecognizer(): ShadowSpeechRecognizer {
+    shadowOf(Looper.getMainLooper()).idle()
+    return shadowOf(checkNotNull(ShadowSpeechRecognizer.getLatestSpeechRecognizer()))
+  }
+
+  private fun results(text: String) = Bundle().apply {
+    putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf(text))
+  }
+
+  private fun setField(target: Any, name: String, value: Any?) {
+    target.javaClass.getDeclaredField(name).apply { isAccessible = true }.set(target, value)
+  }
+
+  private fun field(target: Any, name: String): Any? =
+    target.javaClass.getDeclaredField(name).let {
+      it.isAccessible = true
+      it.get(target)
+    }
+}
