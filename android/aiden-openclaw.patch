+import org.robolectric.annotation.GraphicsMode
+
+/** Exercises the real native view layout; optional images are inspection artifacts, not goldens. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], qualifiers = "w412dp-h892dp-night-xhdpi")
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+class AidenAssistantPanelRenderTest {
+  @Test
+  fun emptyAndCompactSourceLayoutsKeepControlsAndEvidenceWithinPhoneWidth() {
+    val context: Context = RuntimeEnvironment.getApplication()
+    val density = context.resources.displayMetrics.density
+    assertEquals(2f, density, 0f)
+    val width = (412 * density).roundToInt()
+    val height = (892 * density).roundToInt()
+    val opened = mutableListOf<String>()
+    val panel = AidenAssistantPanel(
+      context = context,
+      onClose = {},
+      onOpenChat = {},
+      onDictate = {},
+      onSubmit = {},
+      onReadScreen = {},
+      onShareScreen = {},
+      onHandsFree = {},
+      onReview = {},
+      onEdit = {},
+      onOpenLink = { opened += it },
+    )
+    panel.dispatchApplyWindowInsets(WindowInsets.Builder().build())
+
+    measureAndLayout(panel, width, height)
+    assertTrue(panel.input.text.isEmpty())
+    assertTrue(panel.input.hint.isNotBlank())
+    assertEquals(View.GONE, panel.preview.visibility)
+    assertControlsFit(panel)
+    val emptyHeight = panel.panel.height
+    drawAndOptionallyExport(panel, "aiden-panel-empty.png")
+
+    val destination = "https://docs.example.org/manual_(v2)?section=memory&revision=2"
+    panel.status.text = "Answered on this phone"
+    panel.status.visibility = View.VISIBLE
+    panel.previewText.text = "Checked public source: Sample hardware guide: $destination Battery is 54%."
+    panel.preview.visibility = View.VISIBLE
+    measureAndLayout(panel, width, height)
+
+    val text = panel.previewText.text as Spanned
+    assertEquals("Sample hardware guide\nBattery is 54%.", text.toString())
+    assertFalse(text.toString().contains("https://"))
+    val link = text.getSpans(0, text.length, URLSpan::class.java).single()
+    assertEquals(destination, link.url)
+    link.onClick(panel.previewText)
+    assertEquals(listOf(destination), opened)
+    assertTrue(panel.panel.height > emptyHeight)
+    assertControlsFit(panel)
+    assertInside(panel, panel.status)
+    assertInside(panel, panel.preview)
+    assertInside(panel, panel.previewText)
+    val layout = checkNotNull(panel.previewText.layout)
+    assertEquals(2, layout.lineCount)
+    for (line in 0 until layout.lineCount) assertEquals(0, layout.getEllipsisCount(line))
+    assertTrue(layout.height <= panel.preview.height - panel.previewText.paddingTop - panel.previewText.paddingBottom)
+    drawAndOptionallyExport(panel, "aiden-panel-source.png")
+  }
+
+  private fun measureAndLayout(view: View, width: Int, height: Int) {
+    view.measure(
+      View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY),
+      View.MeasureSpec.makeMeasureSpec(height, View.MeasureSpec.EXACTLY),
+    )
+    view.layout(0, 0, width, height)
+  }
+
+  private fun assertControlsFit(root: AidenAssistantPanel) {
+    assertInside(root, root.panel)
+    val input = assertInside(root, root.input)
+    val primary = assertInside(root, root.dictate)
+    assertTrue("Composer text must not overlap its action", input.right <= primary.left)
+    assertTrue("The primary action remains touchable", root.dictate.width >= 48 * root.resources.displayMetrics.density)
+    for (view in root.visibleDescendants()) {
+      if (view is TextView && view !== root.input && view.text.isNotBlank()) {
+        assertInside(root, view)
+        val layout = checkNotNull(view.layout)
+        assertTrue("Text must have a laid-out line", layout.lineCount > 0)
+        for (line in 0 until layout.lineCount) {
+          assertEquals("Visible labels must not be ellipsized", 0, layout.getEllipsisCount(line))
+        }
+      }
+    }
+  }
+
+  private fun assertInside(root: ViewGroup, child: View): Rect {
+    assertTrue("Visible view needs nonzero dimensions", child.width > 0 && child.height > 0)
+    val bounds = Rect(0, 0, child.width, child.height)
+    root.offsetDescendantRectToMyCoords(child, bounds)
+    assertTrue("View bounds $bounds must fit ${root.width} x ${root.height}", Rect(0, 0, root.width, root.height).contains(bounds))
+    return bounds
+  }
+
+  private fun drawAndOptionallyExport(panel: AidenAssistantPanel, name: String) {
+    val background = Color.rgb(25, 29, 34)
+    val bitmap = Bitmap.createBitmap(panel.width, panel.height, Bitmap.Config.ARGB_8888)
+    try {
+      val canvas = Canvas(bitmap)
+      canvas.drawColor(background)
+      panel.draw(canvas)
+      val sheet = assertInside(panel, panel.panel)
+      assertTrue("Native drawing must paint the panel", bitmap.getPixel(sheet.centerX(), sheet.bottom - 8) != background)
+      val directory = System.getenv("AIDEN_PANEL_PREVIEW_DIR")?.takeIf { it.isNotBlank() } ?: return
+      val folder = File(directory)
+      check(folder.isDirectory || folder.mkdirs()) { "Could not create panel preview directory" }
+      FileOutputStream(File(folder, name)).use { stream ->
+        assertTrue(bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream))
+      }
+    } finally {
+      bitmap.recycle()
+    }
+  }
+}
+
+private fun View.visibleDescendants(): Sequence<View> = sequence {
+  if (visibility != View.VISIBLE) return@sequence
+  yield(this@visibleDescendants)
+  val group = this@visibleDescendants as? ViewGroup ?: return@sequence
+  for (index in 0 until group.childCount) yieldAll(group.getChildAt(index).visibleDescendants())
+}
