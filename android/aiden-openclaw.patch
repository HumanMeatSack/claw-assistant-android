+package ai.openclaw.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class PhoneUtilityActionTest {
+  @Test
+  fun recognizesExplicitLauncherLabelCommands() {
+    assertEquals(PhoneUtilityAction.OpenInstalledApp("ChatGPT"), parsePhoneUtilityAction("Open ChatGPT app."))
+    assertEquals(
+      PhoneUtilityAction.OpenInstalledApp("The Weather Channel"),
+      parsePhoneUtilityAction("Please open The Weather Channel app"),
+    )
+    assertNull(parsePhoneUtilityAction("Open ChatGPT"))
+    assertNull(parsePhoneUtilityAction("Open file:///sdcard/photo app"))
+  }
+
+  @Test
+  fun recognizesOnlyExplicitAbsoluteWebUrlsWithoutUserInformation() {
+    val https = "HTTPS://example.com/Case%20Sensitive?x=1#section"
+    val http = "http://192.168.1.2:8123/dashboard"
+    assertEquals(PhoneUtilityAction.OpenWebsite(https), parsePhoneUtilityAction("Open $https"))
+    assertEquals(PhoneUtilityAction.OpenWebsite(http), parsePhoneUtilityAction("open $http"))
+    val invalid =
+      listOf(
+        "open example.com",
+        "open javascript:alert(1)",
+        "open file:///sdcard/notes.txt",
+        "open intent://example.com/#Intent;scheme=http;end",
+        "open https://user@example.com/",
+        "open https://@example.com/",
+        "open https:///missing-host",
+        "open https://example.com:70000/",
+        "open https://example.com/ and then open mail",
+      )
+    for (input in invalid) {
+      assertNull(input, parsePhoneUtilityAction(input))
+    }
+  }
+
+  @Test
+  fun recognizesCalendarDraftsByTitle() {
+    assertEquals(
+      PhoneUtilityAction.DraftCalendarEvent("Dinner with Family"),
+      parsePhoneUtilityAction("Draft a calendar event titled Dinner with Family"),
+    )
+    assertNull(parsePhoneUtilityAction("Create a calendar event"))
+  }
+
+  @Test
+  fun recognizesMapsCommandsAndPreservesNames() {
+    assertEquals(PhoneUtilityAction.MapSearch("Joe's Coffee & Bakery"), parsePhoneUtilityAction("Find Joe's Coffee & Bakery on Google Maps."))
+    assertEquals(PhoneUtilityAction.MapDirections("123 Main St"), parsePhoneUtilityAction("Please get directions to 123 Main St."))
+  }
+
+  @Test
+  fun normalizesOnlyExplicitOrdinaryNumbersAndPreservesMessageText() {
+    assertEquals(PhoneUtilityAction.Dial("+12135550100"), parsePhoneUtilityAction("Call +1 (213) 555-0100."))
+    assertEquals(PhoneUtilityAction.Dial("5550100"), parsePhoneUtilityAction("Dial (555) 0100"))
+    assertEquals(
+      PhoneUtilityAction.DraftText("+12135550101", "I'll arrive at 5:30. Thanks!"),
+      parsePhoneUtilityAction("Draft a text to +1 (213) 555-0101 saying I'll arrive at 5:30. Thanks!"),
+    )
+  }
+
+  @Test
+  fun recognizesCameraAndSettingsHandoffs() {
+    assertEquals(PhoneUtilityAction.OpenCamera, parsePhoneUtilityAction("Take a photo."))
+    assertEquals(PhoneUtilityAction.OpenSettings(PhoneUtilitySettingsPanel.Wifi), parsePhoneUtilityAction("Open the Wi-Fi settings."))
+    assertEquals(PhoneUtilityAction.OpenSettings(PhoneUtilitySettingsPanel.Internet), parsePhoneUtilityAction("Open Internet panel"))
+    assertEquals(PhoneUtilityAction.OpenSettings(PhoneUtilitySettingsPanel.Volume), parsePhoneUtilityAction("Open volume panel"))
+    assertEquals(PhoneUtilityAction.OpenSettings(PhoneUtilitySettingsPanel.Nfc), parsePhoneUtilityAction("Open NFC settings"))
+    assertEquals(
+      PhoneUtilityAction.OpenSettings(PhoneUtilitySettingsPanel.DoNotDisturb),
+      parsePhoneUtilityAction("Open Do Not Disturb settings"),
+    )
+  }
+
+  @Test
+  fun leavesConversationAndUnsupportedCommandsUntouched() {
+    val inputs =
+      listOf(
+        "How do I call 213 555 0100?",
+        "Call Mom",
+        "Call *#06#",
+        "Call 123",
+        "Call +1-213-555-0100,77",
+        "Call 213-555-0100 and then open YouTube",
+        "Send a text to 213-555-0100 saying ",
+        "Draft a text to 213-555-0100 saying message\nwith another line",
+        "Take a photo and then upload it",
+        "Open an arbitrary settings intent",
+        "Open Bluetooth panel",
+        "Find " + "a".repeat(201) + " on Maps",
+      )
+    for (input in inputs) {
+      assertNull(input, parsePhoneUtilityAction(input))
+    }
+  }
+}
