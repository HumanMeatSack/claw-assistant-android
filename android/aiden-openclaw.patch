index 0000000000000000000000000000000000000000..edcd7fd40f4f6bc500d9d49abcf5bfd66ac3e4fb
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/PhoneQuickAction.kt
@@ -0,0 +1,143 @@
+package ai.openclaw.app
+
+import java.util.Locale
+
+sealed interface PhoneQuickAction {
+  data class OpenApp(val app: PhoneQuickApp) : PhoneQuickAction
+
+  data class SetTimer(val seconds: Int) : PhoneQuickAction {
+    init {
+      require(seconds in 1..maxTimerSeconds)
+    }
+  }
+
+  data class SetAlarm(val hour: Int, val minute: Int) : PhoneQuickAction {
+    init {
+      require(hour in 0..23 && minute in 0..59)
+    }
+  }
+
+  data class SetFlashlight(val enabled: Boolean) : PhoneQuickAction
+
+  data class SetVolume(val stream: PhoneVolumeStream, val percent: Int) : PhoneQuickAction {
+    init {
+      require(percent in 0..100)
+    }
+  }
+}
+
+enum class PhoneQuickApp(val displayName: String) {
+  Calculator("Calculator"),
+  Clock("Clock"),
+  Maps("Maps"),
+  YouTube("YouTube"),
+  Camera("Camera"),
+  Settings("Settings"),
+}
+
+enum class PhoneVolumeStream(val displayName: String) {
+  Media("Media"),
+  Ringer("Ringer"),
+}
+
+private const val maxCommandLength = 100
+private const val maxTimerSeconds = 86_400
+private const val amountPattern = "([0-9]+|[a-z]+(?:[ -][a-z]+)?)"
+private const val minutesPattern = "min(?:ute)?s?"
+private const val secondsPattern = "sec(?:ond)?s?"
+private val openAppPattern = Regex("open (?:the )?(.+?)(?: app)?")
+private val timerPattern = Regex("(?:set|start) (?:(?:a )?timer for (.+)|(?:(?:a|an) )?(.+) timer)")
+private val minuteDurationPattern = Regex("$amountPattern[ -]$minutesPattern(?:(?: and)? $amountPattern[ -]$secondsPattern)?")
+private val secondDurationPattern = Regex("$amountPattern[ -]$secondsPattern")
+private val alarmPattern = Regex("""set (?:an )?alarm (?:for|at) ([0-9]{1,2})(?::([0-9]{2}))?(?: ?([ap])\.?m\.?)?""")
+private val flashlightPattern = Regex("(?:turn )?(?:the )?(?:flashlight|torch) (on|off)|turn (on|off) (?:the )?(?:flashlight|torch)")
+private val volumePattern = Regex("set (?:the )?(media|ringer) volume to $amountPattern(?: ?%| percent)")
+private val smallNumbers =
+  listOf(
+    "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
+    "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen",
+  )
+private val tensNumbers = listOf("twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety")
+
+/** Recognizes only complete commands so conversational text stays on the normal chat path. */
+fun parsePhoneQuickAction(input: String): PhoneQuickAction? {
+  if (input.length > maxCommandLength || input.any { it == '\n' || it == '\r' }) return null
+  val command = input.trim().lowercase(Locale.ROOT).removeSuffix(".").removePrefix("please ")
+
+  openAppPattern.matchEntire(command)?.let { match ->
+    val app =
+      when (match.groupValues[1]) {
+        "calculator" -> PhoneQuickApp.Calculator
+        "clock" -> PhoneQuickApp.Clock
+        "maps", "google maps" -> PhoneQuickApp.Maps
+        "youtube", "you tube" -> PhoneQuickApp.YouTube
+        "camera" -> PhoneQuickApp.Camera
+        "settings" -> PhoneQuickApp.Settings
+        else -> return null
+      }
+    return PhoneQuickAction.OpenApp(app)
+  }
+
+  alarmPattern.matchEntire(command)?.let { return parseAlarmTime(it) }
+  flashlightPattern.matchEntire(command)?.let { match ->
+    return PhoneQuickAction.SetFlashlight(match.groupValues[1].ifEmpty { match.groupValues[2] } == "on")
+  }
+  volumePattern.matchEntire(command)?.let { match ->
+    val amount = match.groupValues[2]
+    val percent = if (amount == "one hundred") 100 else parseAmount(amount)
+    if (percent == null || percent !in 0..100) return null
+    val stream = if (match.groupValues[1] == "media") PhoneVolumeStream.Media else PhoneVolumeStream.Ringer
+    return PhoneQuickAction.SetVolume(stream, percent)
+  }
+
+  val match = timerPattern.matchEntire(command) ?: return null
+  val duration = match.groupValues[1].ifEmpty { match.groupValues[2] }
+  val seconds = parseTimerDuration(duration) ?: return null
+  return seconds.takeIf { it in 1..maxTimerSeconds.toLong() }?.let { PhoneQuickAction.SetTimer(it.toInt()) }
+}
+
+private fun parseAlarmTime(match: MatchResult): PhoneQuickAction.SetAlarm? {
+  val hourText = match.groupValues[1]
+  val hour = hourText.toInt()
+  val minuteText = match.groupValues[2]
+  val minute = minuteText.ifEmpty { "0" }.toInt()
+  if (minute !in 0..59) return null
+
+  val period = match.groupValues[3]
+  val localHour =
+    if (period.isNotEmpty()) {
+      if (hour !in 1..12) return null
+      hour % 12 + if (period == "p") 12 else 0
+    } else {
+      // Require AM/PM unless the clock notation uniquely indicates 24-hour time.
+      val explicit24Hour = hour in 13..23 || (hourText.length == 2 && hourText.startsWith("0"))
+      if (minuteText.isEmpty() || !explicit24Hour) return null
+      hour
+    }
+  return PhoneQuickAction.SetAlarm(localHour, minute)
+}
+
+private fun parseTimerDuration(duration: String): Long? {
+  minuteDurationPattern.matchEntire(duration)?.let { match ->
+    val minutes = parseAmount(match.groupValues[1]) ?: return null
+    val secondAmount = match.groups[2]?.value
+    val seconds = if (secondAmount == null) 0 else parseAmount(secondAmount) ?: return null
+    return minutes * 60L + seconds
+  }
+  val match = secondDurationPattern.matchEntire(duration) ?: return null
+  return parseAmount(match.groupValues[1])?.toLong()
+}
+
+private fun parseAmount(value: String): Int? {
+  value.toIntOrNull()?.let { return it }
+  if (value == "a" || value == "an") return 1
+  val smallNumber = smallNumbers.indexOf(value)
+  if (smallNumber >= 0) return smallNumber
+
+  val words = value.replace('-', ' ').split(' ')
+  val tens = tensNumbers.indexOf(words[0])
+  if (tens < 0) return null
+  if (words.size == 1) return (tens + 2) * 10
+  val ones = smallNumbers.indexOf(words[1])
+  return if (ones in 1..9) (tens + 2) * 10 + ones else null
+}
