+package ai.openclaw.app.localagent
+
+import android.net.Uri
+import java.io.File
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.async
+import kotlinx.coroutines.test.StandardTestDispatcher
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+
+@RunWith(RobolectricTestRunner::class)
+@OptIn(ExperimentalCoroutinesApi::class)
+class PhoneLocalAgentLifecycleTest {
+  private val context get() = RuntimeEnvironment.getApplication()
+  private val tool = PhoneAgentTool("phone_status", "Read phone state", "{\"type\":\"object\"}")
+
+  @Test
+  fun newInstallIsDisabledAndDoesNotLoadTheModel() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    var loads = 0
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> loads++; FakeRuntime() }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.warmUp()
+    assertFalse(agent.state.value.enabled)
+    assertEquals(0, loads)
+  }
+
+  @Test
+  fun unknownModelToolNeverReachesExecutor() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    val runtime = FakeRuntime { PhoneAgentRuntimeReply("", listOf(PhoneAgentCall("unbounded_shell", "{}"))) }
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    var executed = false
+    val answer = agent.reply("check the phone", listOf(tool)) { executed = true; "result" }
+    assertFalse(executed)
+    assertTrue(answer.contains("available phone action"))
+    assertTrue(runtime.conversations.single().closed)
+  }
+
+  @Test
+  fun validatedToolResultReturnsToModelBeforeFinalAnswer() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    var step = 0
+    val runtime = FakeRuntime { results ->
+      if (step++ == 0) PhoneAgentRuntimeReply("", listOf(PhoneAgentCall("phone_status", "{}"))) else {
+        assertEquals(listOf("phone_status" to "{\"battery\":74}"), results)
+        PhoneAgentRuntimeReply("Battery is 74 percent.", emptyList())
+      }
+    }
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    var count = 0
+    val answer = agent.reply("battery?", listOf(tool)) { count++; "{\"battery\":74}" }
+    assertEquals("Battery is 74 percent.", answer)
+    assertEquals(1, count)
+    assertEquals(2, step)
+  }
+
+  @Test
+  fun repeatedModelActionsStopAtFourExecutorCalls() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    val runtime = FakeRuntime { PhoneAgentRuntimeReply("", listOf(PhoneAgentCall("phone_status", "{}"))) }
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    var count = 0
+    val answer = agent.reply("check the phone", listOf(tool)) { count++; "{\"ok\":true}" }
+    assertEquals(4, count)
+    assertTrue(answer.contains("phone-action limit"))
+  }
+
+  @Test
+  fun onlyFinalizedVisibleAnswerEntersFollowUpHistory() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    val runtime = FakeRuntime { PhoneAgentRuntimeReply("512 GB total, 265 GB available.", emptyList()) }
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    val verified = "265 GB free on this phone. Total capacity was not provided."
+    assertEquals(verified, agent.reply("Read my storage", emptyList(), finalizeReply = { verified }) { error("No tool") })
+    agent.reply("What about total?", emptyList()) { error("No tool") }
+    assertEquals(verified, runtime.histories[1].single().answer)
+    assertFalse(runtime.histories[1].single().answer.contains("512"))
+  }
+
+  @Test
+  fun modelFailureAfterToolStillPublishesFinalizedReceiptWithoutRetry() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    var step = 0
+    val runtime = FakeRuntime {
+      if (step++ == 0) PhoneAgentRuntimeReply("", listOf(PhoneAgentCall("phone_status", "{}"))) else error("Decoder failed")
+    }
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    var calls = 0
+    val result = agent.reply("Check my battery", listOf(tool), finalizeReply = { "Battery is 54 percent." }) {
+      calls++
+      "{\"ok\":true,\"answer\":\"Battery is 54 percent.\"}"
+    }
+    assertEquals("Battery is 54 percent.", result)
+    assertEquals(1, calls)
+    assertTrue(runtime.conversations.single().closed)
+  }
+
+  @Test
+  fun cancelDiscardsConversationAndIdleDoesNotUnloadActiveTurn() = runTest {
+    context.getSharedPreferences("phone_local_agent", 0).edit().clear().commit()
+    val entered = CompletableDeferred<Unit>()
+    val finish = CompletableDeferred<Unit>()
+    val runtime = FakeRuntime {
+      entered.complete(Unit)
+      finish.await()
+      PhoneAgentRuntimeReply("Ready.", emptyList())
+    }
+    // One test clock owns worker entry and idle expiry; real Default scheduling must not race virtual time.
+    val agent = LiteRtPhoneLocalAgent(context, FakeStorage(context.cacheDir), { _, _ -> runtime }, backgroundScope, idleMillis = 1000, workDispatcher = StandardTestDispatcher(testScheduler))
+    agent.setEnabled(true)
+    agent.warmUp()
+    val turn = async { agent.reply("hello", emptyList()) { error("No tools") } }
+    entered.await()
+    advanceTimeBy(1001)
+    runCurrent()
+    assertFalse(runtime.closed)
+    agent.cancel()
+    assertTrue(runCatching { turn.await() }.isFailure)
+    assertTrue(runtime.conversations.single().cancelled)
+    assertTrue(runtime.conversations.single().closed)
+    finish.complete(Unit)
+    assertEquals("Ready.", agent.reply("try again", emptyList()) { error("No tools") })
+    assertEquals(2, runtime.conversations.size)
+    advanceTimeBy(1001)
+    runCurrent()
+    assertTrue(runtime.closed)
+  }
+
+  private class FakeStorage(override val modelFile: File) : PhoneAgentModelStorage {
+    override fun isReady() = true
+
+    override suspend fun import(uri: Uri) = Unit
+  }
+
+  private class FakeRuntime(
+    private val respond: suspend (List<Pair<String, String>>?) -> PhoneAgentRuntimeReply = { PhoneAgentRuntimeReply("Hello.", emptyList()) },
+  ) : PhoneAgentRuntime {
+    val conversations = mutableListOf<FakeConversation>()
+    val histories = mutableListOf<List<PhoneAgentHistory>>()
+    var closed = false
+
+    override fun conversation(tools: List<PhoneAgentTool>, history: List<PhoneAgentHistory>): PhoneAgentRuntimeConversation =
+      FakeConversation(respond).also { conversations += it; histories += history.toList() }
+
+    override fun close() { closed = true }
+  }
+
+  private class FakeConversation(
+    private val respond: suspend (List<Pair<String, String>>?) -> PhoneAgentRuntimeReply,
+  ) : PhoneAgentRuntimeConversation {
+    var cancelled = false
+    var closed = false
+    private var running = false
+
+    override fun tokenCount() = 64
+
+    override fun renderedBytes(text: String?, results: List<Pair<String, String>>?) = 64
+
+    override suspend fun send(text: String?, results: List<Pair<String, String>>?): PhoneAgentRuntimeReply {
+      check(!closed && !cancelled)
+      running = true
+      try { return respond(results) } finally { running = false }
+    }
+
+    override fun cancel() { cancelled = true }
+
+    override fun close() { check(!running); closed = true }
+  }
+}
