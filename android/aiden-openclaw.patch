+package ai.openclaw.app.assistant
+
+import android.content.Context
+import android.os.Build
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.KeywordSpotter
+import com.k2fsa.sherpa.onnx.KeywordSpotterConfig
+import com.k2fsa.sherpa.onnx.OnlineModelConfig
+import com.k2fsa.sherpa.onnx.OnlineTransducerModelConfig
+import java.io.Closeable
+
+private const val wakeSampleRate = 16_000
+private const val wakeAssets = "aiden-wake"
+
+/** One narrow offline detector. Its owner must use it from a single recording thread. */
+internal class AidenKeywordDetector(context: Context) : Closeable {
+  init {
+    check("arm64-v8a" in Build.SUPPORTED_ABIS) { "Aiden wake detection requires arm64-v8a" }
+  }
+
+  private val spotter =
+    KeywordSpotter(
+      assetManager = context.assets,
+      config = KeywordSpotterConfig(
+        featConfig = FeatureConfig(sampleRate = wakeSampleRate, featureDim = 80),
+        modelConfig = OnlineModelConfig(
+          transducer = OnlineTransducerModelConfig(
+            encoder = "$wakeAssets/encoder.int8.onnx",
+            decoder = "$wakeAssets/decoder.int8.onnx",
+            joiner = "$wakeAssets/joiner.int8.onnx",
+          ),
+          tokens = "$wakeAssets/tokens.txt",
+          numThreads = 1,
+          provider = "cpu",
+          modelType = "zipformer2",
+        ),
+        keywordsFile = "$wakeAssets/keywords.txt",
+        keywordsThreshold = 0.12f,
+      ),
+    )
+  private val stream =
+    try {
+      spotter.createStream()
+    } catch (error: RuntimeException) {
+      spotter.release()
+      throw error
+    }
+  private var waveform = FloatArray(0)
+  private var closed = false
+
+  fun accept(samples: ShortArray, count: Int = samples.size): Boolean {
+    check(!closed)
+    require(count in 0..samples.size)
+    if (count == 0) return false
+    if (waveform.size != count) waveform = FloatArray(count)
+    for (index in 0 until count) waveform[index] = samples[index] / 32_768f
+    stream.acceptWaveform(waveform, wakeSampleRate)
+    while (spotter.isReady(stream)) {
+      spotter.decode(stream)
+      if (spotter.getResult(stream).keyword.isNotEmpty()) {
+        reset()
+        return true
+      }
+    }
+    return false
+  }
+
+  fun reset() {
+    check(!closed)
+    spotter.reset(stream)
+  }
+
+  override fun close() {
+    if (closed) return
+    closed = true
+    stream.release()
+    spotter.release()
+  }
+}
