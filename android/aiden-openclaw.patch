diff --git a/apps/android/app/src/main/java/ai/openclaw/app/voice/AlbaPlaybackDiagnostics.kt b/apps/android/app/src/main/java/ai/openclaw/app/voice/AlbaPlaybackDiagnostics.kt
new file mode 100644
index 0000000000000000000000000000000000000000..ee0bfdcf6ff174fd0f4d1351eb4e52bacd877b56
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/voice/AlbaPlaybackDiagnostics.kt
@@ -0,0 +1,97 @@
+package ai.openclaw.app.voice
+
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+
+/** Numeric playback facts only. No text, PCM, file names, or model/tool results are retained. */
+internal data class AlbaPlaybackReport(
+  val phase: String,
+  val sourceRateHz: Int? = null,
+  val trackRateHz: Int? = null,
+  val playbackRateHz: Int? = null,
+  val encoding: Int? = null,
+  val speed: Float? = null,
+  val pitch: Float? = null,
+  val generatedFrames: Long? = null,
+  val writtenFrames: Long? = null,
+  val renderedFrames: Long? = null,
+  val playbackElapsedMs: Long? = null,
+  val underruns: Int? = null,
+)
+
+internal object AlbaPlaybackDiagnostics {
+  private val owner = AlbaPlaybackDiagnosticsOwner()
+
+  fun begin(requestedSpeed: Float, communication: Boolean): Long = owner.begin(requestedSpeed, communication)
+
+  fun publish(token: Long, report: AlbaPlaybackReport) = owner.publish(token, report)
+
+  fun snapshot(): JsonObject? = owner.snapshot()
+}
+
+/** One process-wide latest attempt; late callbacks cannot replace a newer attempt's facts. */
+internal class AlbaPlaybackDiagnosticsOwner(
+  private val monotonicMs: () -> Long = { System.nanoTime() / 1_000_000L },
+) {
+  private data class Attempt(
+    val sequence: Long,
+    val startedAtMonotonicMs: Long,
+    val requestedSpeed: Float,
+    val communication: Boolean,
+    val report: AlbaPlaybackReport,
+  )
+
+  private val lock = Any()
+  private var sequence = 0L
+  private var latest: Attempt? = null
+
+  fun begin(requestedSpeed: Float, communication: Boolean): Long = synchronized(lock) {
+    val token = ++sequence
+    latest = Attempt(
+      sequence = token,
+      startedAtMonotonicMs = maxOf(latest?.startedAtMonotonicMs ?: Long.MIN_VALUE, monotonicMs()),
+      requestedSpeed = requestedSpeed,
+      communication = communication,
+      report = AlbaPlaybackReport(phase = "preparing"),
+    )
+    token
+  }
+
+  fun publish(token: Long, report: AlbaPlaybackReport) = synchronized(lock) {
+    val current = latest ?: return@synchronized
+    if (current.sequence != token || report.phase !in phases) return@synchronized
+    // A delayed playing callback cannot turn a finished request back into active playback.
+    if (current.report.phase in terminalPhases && report.phase != current.report.phase) return@synchronized
+    latest = current.copy(report = report)
+  }
+
+  fun snapshot(): JsonObject? = synchronized(lock) {
+    val current = latest ?: return@synchronized null
+    val report = current.report
+    buildJsonObject {
+      put("sequence", JsonPrimitive(current.sequence))
+      put("startedAtMonotonicMs", JsonPrimitive(current.startedAtMonotonicMs))
+      put("provider", JsonPrimitive("android-alba"))
+      put("phase", JsonPrimitive(report.phase))
+      current.requestedSpeed.takeIf(Float::isFinite)?.let { put("requestedSpeed", JsonPrimitive(it)) }
+      put("communication", JsonPrimitive(current.communication))
+      report.sourceRateHz?.let { put("sourceRateHz", JsonPrimitive(it)) }
+      report.trackRateHz?.let { put("trackRateHz", JsonPrimitive(it)) }
+      report.playbackRateHz?.let { put("playbackRateHz", JsonPrimitive(it)) }
+      report.encoding?.let { put("encoding", JsonPrimitive(it)) }
+      report.speed?.takeIf(Float::isFinite)?.let { put("speed", JsonPrimitive(it)) }
+      report.pitch?.takeIf(Float::isFinite)?.let { put("pitch", JsonPrimitive(it)) }
+      report.generatedFrames?.let { put("generatedFrames", JsonPrimitive(it)) }
+      report.writtenFrames?.let { put("writtenFrames", JsonPrimitive(it)) }
+      report.renderedFrames?.let { put("renderedFrames", JsonPrimitive(it)) }
+      report.playbackElapsedMs?.let { put("playbackElapsedMs", JsonPrimitive(it)) }
+      report.underruns?.let { put("underruns", JsonPrimitive(it)) }
+    }
+  }
+
+  private companion object {
+    val terminalPhases = setOf("completed", "failed", "cancelled")
+    val phases = terminalPhases + setOf("preparing", "playing")
+  }
+}
