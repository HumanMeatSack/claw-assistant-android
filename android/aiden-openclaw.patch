+class AidenAssistantSessionTest {
+  @Test
+  fun ordinarySideButtonShowQueuesContinuousVoiceUntilWindowFocus() {
+    withSession { session, _ ->
+      session.onShow(null, 0)
+      assertTrue(field(session, "conversationPending") as Boolean)
+      assertFalse(field(session, "greetPendingConversation") as Boolean)
+      assertNull(field(session, "dictationJob"))
+    }
+  }
+
+  @Test
+  fun initialFocusLossKeepsPendingEntryUntilWindowCanListen() {
+    withSession { session, _ ->
+      session.onShow(null, 0)
+      val focus = session.javaClass.getDeclaredMethod("handleWindowFocusChange", Boolean::class.javaPrimitiveType)
+      focus.isAccessible = true
+      focus.invoke(session, false)
+      assertTrue(field(session, "conversationPending") as Boolean)
+      assertNull(field(session, "dictationJob"))
+    }
+  }
+
+  @Test
+  fun emptyPanelMicQueuesContinuousVoiceInsteadOfOneShotDictation() {
+    withSession { session, panel ->
+      panel.dictate.performClick()
+      assertTrue(field(session, "conversationPending") as Boolean)
+      assertFalse(field(session, "greetPendingConversation") as Boolean)
+      assertNull(field(session, "dictationJob"))
+    }
+  }
+
+  @Test
+  fun typingCancelsPendingVoiceAndDoesNotRearmOnFocus() {
+    withSession { session, panel ->
+      session.onShow(null, 0)
+      assertTrue(field(session, "conversationPending") as Boolean)
+      panel.input.requestFocus()
+      assertFalse(field(session, "conversationPending") as Boolean)
+      panel.input.setText("Keep this typed question")
+      session.onShow(null, 0)
+      assertFalse(field(session, "conversationPending") as Boolean)
+    }
+  }
+
+  @Test
+  fun matchingScreenCaptureShowDoesNotStartVoice() {
+    withSession { session, _ ->
+      val captureClass = AidenAssistantSession::class.java.declaredClasses.single { it.simpleName == "ScreenCapture" }
+      val constructor = captureClass.getDeclaredConstructor(Long::class.javaPrimitiveType, Boolean::class.javaPrimitiveType)
+      constructor.isAccessible = true
+      val capture = constructor.newInstance(41L, true)
+      setField(session, "awaitingCapture", capture)
+      session.onShow(Bundle().apply { putLong("aiden.screen-request-id", 41L) }, VoiceInteractionSession.SHOW_WITH_SCREENSHOT)
+      assertFalse(field(session, "conversationPending") as Boolean)
+      assertNull(field(session, "conversationStartJob"))
