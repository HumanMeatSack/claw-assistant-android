+package ai.openclaw.app.voice
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class SpokenReplyTextTest {
+  @Test
+  fun noWorriesReplyKeepsEveryWordWithoutDecoration() {
+    assertEquals(
+      "\"No worries!\" I won't stop early.",
+      spokenReplyText("**““No worries!””** 😊\nI **won’t** stop early."),
+    )
+  }
+
+  @Test
+  fun headingsListsAndEmphasisRetainTheirContent() {
+    assertEquals(
+      "Quick check Home Assistant is reachable. It is not a phone-pairing problem. Read the current status. Keep the TV on.",
+      spokenReplyText(
+        """
+        ## Quick check
+        - **Home Assistant** is reachable.
+        * It is __not__ a phone-pairing problem.
+        1. Read the current status.
+        2) Keep the TV on.
+        """.trimIndent(),
+      ),
+    )
+  }
+
+  @Test
+  fun inlineCodePreservesIdentifiersAndQuotedContent() {
+    assertEquals(
+      "Use sensor.cheese_temperature and __init__, then print(\"\").",
+      spokenReplyText("Use `sensor.cheese_temperature` and `__init__`, then ```print(\"\")```."),
+    )
+    assertEquals("Check port 1. It is ready.", spokenReplyText("Check `port` 1. It is ready."))
+  }
+
+  @Test
+  fun fencedCodeKeepsItsWordsAndNumbers() {
+    assertEquals(
+      "Read temperature = -2.5 __init__(\"\") first.",
+      spokenReplyText("Read\n```python\ntemperature = -2.5\n__init__(\"\")\n```\nfirst."),
+    )
+  }
+
+  @Test
+  fun linksSpeakTheirLabelsIncludingParenthesesInTargets() {
+    assertEquals(
+      "Open Home Assistant and the wiring diagram.",
+      spokenReplyText("Open [Home Assistant](https://example.com/docs_(local)) and the ![wiring diagram](https://example.com/image.png)."),
+    )
+  }
+
+  @Test
+  fun measurementsNegativeNumbersDecimalsAndMathRemainIntact() {
+    val input = "-2.5 °F, +3.2 °C, 68℉, 20℃, 50%, and $12.99. 3 − 2 = 1; 6 × 7 = 42; 20 ÷ 4 = 5."
+    assertEquals(input, spokenReplyText(input))
+    assertEquals("- 2.5 °F -5 °F + 3.2 °C", spokenReplyText("- 2.5 °F\n-5 °F\n+ 3.2 °C"))
+  }
+
+  @Test
+  fun timesDatesAndPhoneNumbersAreNotListMarkers() {
+    val input = "Tomorrow, 2026-11-17 at 6:30 PM, call 562-555-0100. The reading is 0.75."
+    assertEquals(input, spokenReplyText(input))
+  }
+
+  @Test
+  fun meaningfulUnicodeLettersAndCombiningAccentsRemainIntact() {
+    val input = "Café, cafe\u0301, Ελληνικά, 中文, and العربية. Ω is a letter."
+    assertEquals(input, spokenReplyText(input))
+  }
+
+  @Test
+  fun decorativeEmojiAndControlCharactersDoNotJoinAdjacentWords() {
+    assertEquals("Hello there Ready now.", spokenReplyText("Hello😊there 👍🏽\u200D❤️\nReady\u0000now."))
+    assertEquals("", spokenReplyText("😊👍🏽 ❤️\uFE0F"))
+  }
+
+  @Test
+  fun plainTextNegationsAndArithmeticAreUnchanged() {
+    val input = "Do not turn it off. I can't verify that yet. 2 * 3 = 6 and sensor.cheese_temperature is an identifier."
+    assertEquals(input, spokenReplyText(input))
+    assertEquals("Do not stop.", spokenReplyText("***Do not*** stop."))
+  }
+}
