+
+/** The document picker grants access to one selected model; no storage-wide permission is used. */
+@Composable
+internal fun LocalPhoneAgentSettingsSection() {
+  val context = LocalContext.current
+  val agent = remember(context.applicationContext) { PhoneLocalAgentFactory.get(context.applicationContext) } ?: return
+  val state by agent.state.collectAsState()
+  val scope = rememberCoroutineScope()
+  var warming by remember { mutableStateOf(false) }
+  var notice by remember { mutableStateOf<String?>(null) }
+  val importFailed = nativeString("Could not import the model. Choose the model file again.")
+  val warmUpFailed = nativeString("Could not load the phone model. Check the model status and try again.")
+
+  fun warmUp() {
+    if (warming) return
+    warming = true
+    notice = null
+    scope.launch {
+      try {
+        agent.warmUp()
+      } catch (cancelled: CancellationException) {
+        throw cancelled
+      } catch (_: Exception) {
+        notice = warmUpFailed
+      } catch (_: LinkageError) {
+        notice = warmUpFailed
+      } finally {
+        warming = false
+      }
+    }
+  }
+
+  val modelPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+    if (uri != null) {
+      notice = null
+      scope.launch {
+        try {
+          agent.importModel(uri)
+        } catch (cancelled: CancellationException) {
+          throw cancelled
+        } catch (_: Exception) {
+          notice = importFailed
+        }
+      }
+    }
+  }
+
+  ClawPanel(verticalArrangement = Arrangement.spacedBy(ClawTheme.spacing.xxs)) {
+    Text(text = nativeString("Local phone agent"), style = ClawTheme.type.section, color = ClawTheme.colors.text)
+    Text(
+      text = nativeString("Use your imported Qwen model for the Side-button and Hey Aiden conversation. Speech, chat, and supported phone actions run on this phone. Ask Codex needs a paired Gateway. Home Assistant and web brokers are not included in this public preview."),
+      style = ClawTheme.type.body,
+      color = ClawTheme.colors.textMuted,
+    )
+    SettingsTogglePanel(
+      rows = listOf(
+        SettingsToggleRow(
+          title = nativeString("Use phone model"),
+          subtitle = nativeString("Applies to the next voice conversation. Local failures are reported without sending ordinary chat to the Mac."),
+          icon = Icons.Default.Bolt,
+          checked = state.enabled,
+          enabled = !state.importing && (state.modelReady || state.enabled),
+          onCheckedChange = { enabled ->
+            agent.setEnabled(enabled)
+            if (enabled) warmUp()
+          },
+        ),
+      ),
+    )
+    Text(text = state.status, style = ClawTheme.type.body, color = ClawTheme.colors.textMuted)
+    notice?.let { Text(text = it, style = ClawTheme.type.caption, color = ClawTheme.colors.warning) }
+    ClawSecondaryButton(
+      text = if (state.importing) nativeString("Importing model…") else nativeString("Import Qwen3-4B model"),
+      onClick = { modelPicker.launch(arrayOf("*/*")) },
+      enabled = !state.importing && !warming,
+      modifier = Modifier.fillMaxWidth(),
+    )
+    ClawSecondaryButton(
+      text = if (warming) nativeString("Loading phone model…") else nativeString("Warm up phone model"),
+      onClick = ::warmUp,
+      enabled = state.enabled && state.modelReady && !state.importing && !warming,
+      modifier = Modifier.fillMaxWidth(),
+    )
+    Text(
+      text = nativeString("Choose the verified Qwen3-4B .litertlm file. Import makes a private app copy and keeps the original file. Opening another app can end the current voice conversation."),
+      style = ClawTheme.type.caption,
+      color = ClawTheme.colors.textMuted,
+    )
+  }
+}
