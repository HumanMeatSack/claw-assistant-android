+package ai.openclaw.app.voice
+
+import android.content.Context
+import com.k2fsa.sherpa.onnx.FeatureConfig
+import com.k2fsa.sherpa.onnx.OfflineModelConfig
+import com.k2fsa.sherpa.onnx.OfflineRecognizer
+import com.k2fsa.sherpa.onnx.OfflineRecognizerConfig
+import com.k2fsa.sherpa.onnx.OfflineTransducerModelConfig
+import java.util.concurrent.Executors
+import kotlinx.coroutines.asCoroutineDispatcher
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+/** All recognizer JNI calls share one worker; replacing a capture never races native teardown. */
+internal object ParakeetDecoder {
+  private val worker = Executors.newSingleThreadExecutor { task -> Thread(task, "aiden-offline-asr") }.asCoroutineDispatcher()
+  private var recognizer: OfflineRecognizer? = null
+  private const val modelDirectory = "aiden-asr/parakeet-v2"
+
+  suspend fun decode(context: Context, samples: FloatArray): String = withContext(worker) {
+    try {
+      decodeOnWorker(context, samples)
+    } catch (cancelled: CancellationException) {
+      throw cancelled
+    } catch (error: Exception) {
+      throw ParakeetModelFailure(error)
+    } catch (error: LinkageError) {
+      throw ParakeetModelFailure(error)
+    }
+  }
+
+  private suspend fun decodeOnWorker(context: Context, samples: FloatArray): String {
+    currentCoroutineContext().ensureActive()
+    val engine = recognizer ?: OfflineRecognizer(
+      assetManager = context.applicationContext.assets,
+      config = OfflineRecognizerConfig(
+        featConfig = FeatureConfig(sampleRate = 16_000, featureDim = 80),
+        modelConfig = OfflineModelConfig(
+          transducer = OfflineTransducerModelConfig(
+            encoder = "$modelDirectory/encoder.int8.onnx",
+            decoder = "$modelDirectory/decoder.int8.onnx",
+            joiner = "$modelDirectory/joiner.int8.onnx",
+          ),
+          tokens = "$modelDirectory/tokens.txt",
+          modelType = "nemo_transducer",
+          numThreads = 2,
+          provider = "cpu",
+        ),
+        decodingMethod = "greedy_search",
+      ),
+    ).also { recognizer = it }
+    currentCoroutineContext().ensureActive()
+    val stream = engine.createStream()
+    try {
+      stream.acceptWaveform(samples, 16_000)
+      engine.decode(stream)
+      currentCoroutineContext().ensureActive()
+      return engine.getResult(stream).text.trim()
+    } finally {
+      stream.release()
+    }
+  }
+}
+
+internal class ParakeetModelFailure(cause: Throwable) : IllegalStateException("Offline speech model unavailable", cause)
+
+/** A pipe read may split a PCM16 sample at any byte, including across read callbacks. */
+internal class ParakeetPcm16 {
+  private var lowByte: Int? = null
+
+  fun decode(bytes: ByteArray, count: Int): FloatArray {
+    require(count in 0..bytes.size)
+    val samples = FloatArray((count + if (lowByte != null) 1 else 0) / 2)
+    var source = 0
+    var target = 0
+    lowByte?.let { low ->
+      if (count > 0) {
+        samples[target++] = ((bytes[source++].toInt() shl 8) or low).toShort() / 32_768f
+        lowByte = null
+      }
+    }
+    while (source + 1 < count) {
+      samples[target++] = ((bytes[source + 1].toInt() shl 8) or (bytes[source].toInt() and 255)).toShort() / 32_768f
+      source += 2
+    }
+    if (source < count) lowByte = bytes[source].toInt() and 255
+    return samples
+  }
+
+  fun clear() { lowByte = null }
+}
+
+/** Retains a short pre-roll while idle, then one bounded utterance, never a recording on disk. */
+internal class ParakeetAudioBuffer(
+  private val capacity: Int = 16_000 * 90,
+  preRollSamples: Int = 8_000,
+) {
+  init { require(capacity > 0 && preRollSamples in 1..capacity) }
+  private val preRoll = FloatArray(preRollSamples)
+  private val utterance = FloatArray(capacity)
+  private var preRollCount = 0
+  private var preRollNext = 0
+  var started: Boolean = false
+    private set
+  var size: Int = 0
+    private set
+  val full: Boolean get() = size >= capacity
+
+  fun append(samples: FloatArray) {
+    if (started) {
+      val copied = minOf(samples.size, capacity - size)
+      samples.copyInto(utterance, size, 0, copied)
+      size += copied
+    } else {
+      for (sample in samples) {
+        preRoll[preRollNext] = sample
+        preRollNext = (preRollNext + 1) % preRoll.size
+        preRollCount = minOf(preRollCount + 1, preRoll.size)
+      }
+    }
+  }
+
+  fun beginSpeech() {
+    if (started) return
+    started = true
+    val oldest = if (preRollCount == preRoll.size) preRollNext else 0
+    for (index in 0 until preRollCount) utterance[size++] = preRoll[(oldest + index) % preRoll.size]
+    preRoll.fill(0f)
+    preRollCount = 0
+  }
+
+  fun snapshot(): FloatArray = utterance.copyOf(size)
+
+  fun clear() {
+    preRoll.fill(0f)
+    utterance.fill(0f)
+    preRollCount = 0
+    preRollNext = 0
+    size = 0
+    started = false
+  }
+}
