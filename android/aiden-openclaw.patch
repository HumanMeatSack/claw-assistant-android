+package ai.openclaw.app.assistant
+
+import ai.openclaw.app.R
+import android.app.Activity
+import android.app.voiceinteraction.VoiceInteractionManager
+import android.content.ActivityNotFoundException
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.widget.Toast
+
+/** Only the overlay's explicit screen action can launch this private permission host. */
+class AidenScreenContextPermissionActivity : Activity() {
+  override fun onCreate(savedInstanceState: Bundle?) {
+    super.onCreate(savedInstanceState)
+    if (savedInstanceState != null) return
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.CINNAMON_BUN) {
+      finish()
+      return
+    }
+    val manager = getSystemService(VoiceInteractionManager::class.java)
+    if (manager == null || manager.readScreenContextRequestState != VoiceInteractionManager.READ_SCREEN_CONTEXT_REQUEST_STATE_REQUESTABLE) {
+      finish()
+      return
+    }
+    try {
+      @Suppress("DEPRECATION") // The platform requires startActivityForResult for this intent.
+      startActivityForResult(manager.createRequestReadScreenContextIntent(), screenContextRequest)
+    } catch (_: ActivityNotFoundException) {
+      reportResult(false)
+    } catch (_: SecurityException) {
+      reportResult(false)
+    }
+  }
+
+  @Deprecated("Activity's result callback is required by the screen context permission API.")
+  override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+    @Suppress("DEPRECATION")
+    super.onActivityResult(requestCode, resultCode, data)
+    if (requestCode == screenContextRequest) reportResult(resultCode == RESULT_OK)
+  }
+
+  private fun reportResult(granted: Boolean) {
+    val message = if (granted) R.string.aiden_assistant_screen_permission_granted else R.string.aiden_assistant_screen_permission_denied
+    Toast.makeText(this, message, Toast.LENGTH_LONG).show()
+    finish()
+  }
+
+  private companion object {
+    const val screenContextRequest = 1
+  }
+}
diff --git a/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenWakeService.kt b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenWakeService.kt
new file mode 100644
index 00000000..4683c281
--- /dev/null
+++ b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenWakeService.kt
@@ -0,0 +1,321 @@
+package ai.openclaw.app.assistant
+
+import ai.openclaw.app.NodeApp
+import ai.openclaw.app.NodeRuntime
+import ai.openclaw.app.R
+import android.Manifest
+import android.app.KeyguardManager
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.content.pm.ServiceInfo
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaRecorder
+import android.os.Build
+import android.os.IBinder
+import android.os.PowerManager
+import android.os.SystemClock
+import android.service.voice.VoiceInteractionService
+import android.util.Log
+import androidx.annotation.MainThread
+import androidx.core.app.NotificationCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.asCoroutineDispatcher
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicLong
+import java.util.concurrent.atomic.AtomicReference
+
+/** A user-armed, local microphone session. Incoming audio lasts only for the current model chunk. */
+internal class AidenWakeService : Service() {
+  enum class Status { Off, Starting, Listening, Paused, MicBusy, Unavailable }
+
+  private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+  private val activeRecorder = AtomicReference<AudioRecord>()
+  private var monitor: Job? = null
+  private var activeGeneration = 0L
+
+  override fun onBind(intent: Intent?): IBinder? = null
+
+  override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+    val token = intent?.getLongExtra(extraGeneration, 0) ?: 0
+    if (token == 0L || token != generation.get()) {
+      if (monitor?.isActive != true) stopSelfResult(startId)
+      return START_NOT_STICKY
+    }
+    if (intent?.action == actionStop) {
+      disarm(this)
+      return START_NOT_STICKY
+    }
+    if (intent?.action != actionArm || activeGeneration == token && monitor?.isActive == true) return START_NOT_STICKY
+
+    val previous = monitor
+    activeGeneration = token
+    if (!canMonitor(this)) {
+      publish(token, Status.Unavailable)
+      stopSelfResult(startId)
+      return START_NOT_STICKY
+    }
+    try {
+      val manager = checkNotNull(getSystemService(NotificationManager::class.java))
+      manager.createNotificationChannel(NotificationChannel(notificationChannelId, getString(R.string.aiden_wake_channel), NotificationManager.IMPORTANCE_LOW))
+      ServiceCompat.startForeground(this, notificationId, buildNotification(token), ServiceInfo.FOREGROUND_SERVICE_TYPE_MICROPHONE)
+    } catch (error: RuntimeException) {
+      Log.w(tag, "Could not start the wake-word foreground service", error)
+      publish(token, Status.Unavailable)
+      stopSelfResult(startId)
+      return START_NOT_STICKY
+    }
+    monitor =
+      scope.launch {
+        try {
+          previous?.cancelAndJoin()
+          val runtime = withContext(Dispatchers.Default) { (application as NodeApp).ensureBackgroundRuntime() }
+          monitorWakeWord(runtime, token)
+        } catch (error: CancellationException) {
+          throw error
+        } catch (error: Exception) {
+          Log.w(tag, "Wake-word monitoring stopped", error)
+          publish(token, Status.Unavailable)
+        } catch (error: LinkageError) {
+          Log.w(tag, "Local wake-word engine is unavailable", error)
+          publish(token, Status.Unavailable)
+        } finally {
+          if (token == activeGeneration && token == generation.get()) {
+            if (status.value != Status.Unavailable) publish(token, Status.Off)
+            stopForeground(STOP_FOREGROUND_REMOVE)
+            stopSelfResult(startId)
+          }
+        }
+      }
+    return START_NOT_STICKY
+  }
+
+  override fun onDestroy() {
+    scope.cancel()
+    // Unblock a pending native read while its worker retires the detector and releases the mic lease.
+    activeRecorder.get()?.let { recorder -> runCatching { recorder.stop() } }
+    if (status.value != Status.Unavailable) publish(activeGeneration, Status.Off)
+    super.onDestroy()
+  }
+
+  private suspend fun monitorWakeWord(runtime: NodeRuntime, token: Long) {
+    // sherpa's native state stays on one worker. Microphone samples stay inside this loop.
+    Executors.newSingleThreadExecutor { work -> Thread(work, "aiden-local-wake") }.asCoroutineDispatcher().use { worker ->
+      withContext(worker) {
+        AidenKeywordDetector(applicationContext).use { detector ->
+          while (isActive && token == generation.get() && canMonitor(this@AidenWakeService)) {
+            if (runtime.isForeground.value || AidenAssistantService.isWakeOverlayBusy() || !isUnlocked()) {
+              publish(token, Status.Paused)
+              delay(pausePollMs)
+              continue
+            }
+            if (!runtime.tryAcquireDictationMic()) {
+              publish(token, Status.MicBusy)
+              delay(micRetryMs)
+              continue
+            }
+            val result =
+              try {
+                listen(runtime, detector, token)
+              } finally {
+                runtime.releaseDictationMic()
+              }
+            when (result) {
+              ListenResult.Hit -> {
+                // Retire AudioRecord and release its app-wide lease before the assistant can start dictation.
+                withContext(Dispatchers.Main.immediate) {
+                  if (token == generation.get() &&
+                    !runtime.isForeground.value &&
+                    !AidenAssistantService.isWakeOverlayBusy() &&
+                    isUnlocked() &&
+                    canMonitor(this@AidenWakeService)
+                  ) {
+                    AidenAssistantService.dispatchWake()
+                  }
+                }
+                publish(token, Status.Paused)
+                delay(wakeSettleMs)
+              }
+              ListenResult.Paused -> Unit
+              ListenResult.AudioBusy -> {
+                publish(token, Status.MicBusy)
+                delay(micRetryMs)
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  private suspend fun listen(runtime: NodeRuntime, detector: AidenKeywordDetector, token: Long): ListenResult {
+    if (runtime.isForeground.value || AidenAssistantService.isWakeOverlayBusy() || !isUnlocked()) return ListenResult.Paused
+    detector.reset()
+    val format =
+      AudioFormat.Builder()
+        .setSampleRate(sampleRate)
+        .setChannelMask(AudioFormat.CHANNEL_IN_MONO)
+        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+        .build()
+    val minimumBuffer = AudioRecord.getMinBufferSize(sampleRate, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+    check(minimumBuffer > 0) { "The phone does not support the required audio input format" }
+    val recorder =
+      AudioRecord.Builder()
+        .setAudioSource(MediaRecorder.AudioSource.VOICE_RECOGNITION)
+        .setAudioFormat(format)
+        .setBufferSizeInBytes(maxOf(minimumBuffer, chunkSize * Short.SIZE_BYTES * 4))
+        .build()
+    val chunk = ShortArray(chunkSize)
+    activeRecorder.set(recorder)
+    try {
+      if (!shouldRead(runtime, token)) return ListenResult.Paused
+      if (recorder.state != AudioRecord.STATE_INITIALIZED) return ListenResult.AudioBusy
+      recorder.startRecording()
+      if (recorder.recordingState != AudioRecord.RECORDSTATE_RECORDING) return ListenResult.AudioBusy
+      publish(token, Status.Listening)
+      var nextPermissionCheck = 0L
+      while (shouldRead(runtime, token)) {
+        val now = SystemClock.elapsedRealtime()
+        if (now >= nextPermissionCheck) {
+          if (!canMonitor(this) || !isUnlocked()) return ListenResult.Paused
+          if (recorder.activeRecordingConfiguration?.isClientSilenced == true) return ListenResult.AudioBusy
+          nextPermissionCheck = now + permissionPollMs
+        }
+        val count = recorder.read(chunk, 0, chunk.size, AudioRecord.READ_BLOCKING)
+        if (count < 0) return ListenResult.AudioBusy
+        if (count == 0) {
+          delay(emptyReadDelayMs)
+          continue
+        }
+        if (!shouldRead(runtime, token)) return ListenResult.Paused
+        if (detector.accept(chunk, count)) return ListenResult.Hit
+      }
+      return ListenResult.Paused
+    } finally {
+      activeRecorder.compareAndSet(recorder, null)
+      runCatching { recorder.stop() }
+      recorder.release()
+      chunk.fill(0)
+    }
+  }
+
+  private suspend fun shouldRead(runtime: NodeRuntime, token: Long): Boolean =
+    currentCoroutineContext().isActive &&
+      token == generation.get() &&
+      !runtime.isForeground.value &&
+      !AidenAssistantService.isWakeOverlayBusy()
+
+  private fun isUnlocked(): Boolean {
+    if (getSystemService(PowerManager::class.java)?.isInteractive != true) return false
+    val keyguard = getSystemService(KeyguardManager::class.java) ?: return false
+    return !keyguard.isDeviceLocked && !keyguard.isKeyguardLocked
+  }
+
+  private fun buildNotification(token: Long): Notification {
+    val stop =
+      PendingIntent.getService(
+        this,
+        0,
+        Intent(this, AidenWakeService::class.java).setAction(actionStop).putExtra(extraGeneration, token),
+        PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE,
+      )
+    return NotificationCompat.Builder(this, notificationChannelId)
+      .setSmallIcon(R.mipmap.ic_launcher)
+      .setContentTitle(getString(R.string.aiden_wake_notification_title))
+      .setContentText(getString(R.string.aiden_wake_notification_text))
+      .setCategory(NotificationCompat.CATEGORY_SERVICE)
+      .setForegroundServiceBehavior(NotificationCompat.FOREGROUND_SERVICE_IMMEDIATE)
+      .setOngoing(true)
+      .setOnlyAlertOnce(true)
+      .setDeleteIntent(stop)
+      .addAction(0, getString(R.string.aiden_wake_notification_stop), stop)
+      .build()
+  }
+
+  private enum class ListenResult { Hit, Paused, AudioBusy }
+
+  companion object {
+    private const val tag = "AidenWakeService"
+    const val notificationChannelId = "aiden_armed_wake"
+    private const val notificationId = 3001
+    private const val actionArm = "ai.openclaw.app.assistant.ARM_WAKE"
+    private const val actionStop = "ai.openclaw.app.assistant.STOP_WAKE"
+    private const val extraGeneration = "wake_generation"
+    private const val sampleRate = 16_000
+    private const val chunkSize = 800
+    private const val emptyReadDelayMs = 20L
+    private const val pausePollMs = 200L
+    private const val micRetryMs = 750L
+    private const val wakeSettleMs = 700L
+    private const val permissionPollMs = 1_000L
+    private val generation = AtomicLong()
+    private val statusLock = Any()
+    private val mutableStatus = MutableStateFlow(Status.Off)
+    val status: StateFlow<Status> = mutableStatus.asStateFlow()
+
+    @MainThread
+    fun arm(context: Context): Boolean {
+      if (!canMonitor(context)) return false
+      if (status.value != Status.Off && status.value != Status.Unavailable) return true
+      val token = generation.incrementAndGet()
+      publish(token, Status.Starting)
+      return try {
+        ContextCompat.startForegroundService(
+          context,
+          Intent(context, AidenWakeService::class.java).setAction(actionArm).putExtra(extraGeneration, token),
+        )
+        true
+      } catch (error: RuntimeException) {
+        Log.w(tag, "Could not arm the wake word from this screen", error)
+        publish(token, Status.Unavailable)
+        false
+      }
+    }
+
+    @MainThread
+    fun disarm(context: Context) {
+      val token = generation.incrementAndGet()
+      publish(token, Status.Off)
+      context.stopService(Intent(context, AidenWakeService::class.java))
+    }
+
+    private fun publish(token: Long, value: Status) {
+      synchronized(statusLock) {
+        if (token == generation.get()) mutableStatus.value = value
+      }
+    }
+
+    private fun canMonitor(context: Context): Boolean {
+      val manager = context.getSystemService(NotificationManager::class.java) ?: return false
+      return VoiceInteractionService.isActiveService(context, ComponentName(context, AidenAssistantService::class.java)) &&
+        ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED &&
+        (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
+          ContextCompat.checkSelfPermission(context, Manifest.permission.POST_NOTIFICATIONS) == PackageManager.PERMISSION_GRANTED) &&
+        manager.areNotificationsEnabled() &&
+        manager.getNotificationChannel(notificationChannelId)?.importance != NotificationManager.IMPORTANCE_NONE
+    }
+  }
+}
