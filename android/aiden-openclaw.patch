@@ -0,0 +1,52 @@
+package ai.openclaw.app
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+
+private const val gmailPackage = "com.google.android.gm"
+private const val googlePhotosPackage = "com.google.android.apps.photos"
+
+internal fun executePhoneGoogleAction(context: Context, action: PhoneGoogleAction): PhoneDeviceResult =
+  try {
+    when (action) {
+      PhoneGoogleAction.OpenGmail -> openGoogleApp(context, gmailPackage, gmailHomeUrl, "Opening Gmail")
+      PhoneGoogleAction.OpenPhotos -> openGoogleApp(context, googlePhotosPackage, googlePhotosHomeUrl, "Opening Google Photos")
+      is PhoneGoogleAction.SearchGmail ->
+        if (startGoogleActivity(context, googleWebIntent(gmailSearchUrl(action.query)))) {
+          PhoneDeviceResult("Opening Gmail web search")
+        } else {
+          PhoneDeviceResult("No app can open Gmail web search", completed = false)
+        }
+      is PhoneGoogleAction.DraftEmail -> {
+        val intent = Intent(Intent.ACTION_SENDTO, Uri.parse(gmailDraftUri(action))).setPackage(gmailPackage)
+        if (startGoogleActivity(context, intent)) {
+          PhoneDeviceResult("Opening Gmail compose")
+        } else {
+          PhoneDeviceResult("Gmail compose is unavailable on this phone", completed = false)
+        }
+      }
+    }
+  } catch (_: SecurityException) {
+    PhoneDeviceResult("Android blocked this action", completed = false)
+  }
+
+private fun openGoogleApp(context: Context, packageName: String, url: String, message: String): PhoneDeviceResult {
+  val app = context.packageManager.getLaunchIntentForPackage(packageName)
+  return if ((app != null && startGoogleActivity(context, app)) || startGoogleActivity(context, googleWebIntent(url))) {
+    PhoneDeviceResult(message)
+  } else {
+    PhoneDeviceResult("No app can open this Google service", completed = false)
+  }
+}
+
+private fun googleWebIntent(url: String): Intent = Intent(Intent.ACTION_VIEW, Uri.parse(url)).addCategory(Intent.CATEGORY_BROWSABLE)
+
+private fun startGoogleActivity(context: Context, intent: Intent): Boolean =
+  try {
+    context.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    true
+  } catch (_: ActivityNotFoundException) {
+    false
+  }
