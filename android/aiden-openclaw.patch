+package ai.openclaw.app.voice
+
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ParakeetCaptureTest {
+  @Test
+  fun pcm16PreservesSampleValuesAcrossEveryByteBoundary() {
+    val bytes = byteArrayOf(0, 0, -1, 127, 0, -128, -1, -1, 0, 64)
+    val expected = floatArrayOf(0f, 32767 / 32768f, -1f, -1 / 32768f, 0.5f)
+    for (split in 0..bytes.size) {
+      val decoder = ParakeetPcm16()
+      val first = decoder.decode(bytes.copyOfRange(0, split), split)
+      val second = decoder.decode(bytes.copyOfRange(split, bytes.size), bytes.size - split)
+      assertArrayEquals("split=$split", expected, first + second, 0f)
+    }
+  }
+
+  @Test
+  fun emptyReadDoesNotLoseSplitSampleAndCancelDoesNotCarryItIntoNextTurn() {
+    val decoder = ParakeetPcm16()
+    assertTrue(decoder.decode(byteArrayOf(0), 1).isEmpty())
+    assertTrue(decoder.decode(byteArrayOf(), 0).isEmpty())
+    assertArrayEquals(floatArrayOf(0.5f), decoder.decode(byteArrayOf(64), 1), 0f)
+    decoder.decode(byteArrayOf(-1), 1)
+    decoder.clear()
+    assertArrayEquals(floatArrayOf(0f), decoder.decode(byteArrayOf(0, 0), 2), 0f)
+  }
+
+  @Test
+  fun idleCaptureRetainsOnlyPrerollAndDoesNotInventAnUtterance() {
+    val buffer = ParakeetAudioBuffer(capacity = 10, preRollSamples = 3)
+    buffer.append(FloatArray(100) { it.toFloat() })
+    assertEquals(0, buffer.size)
+    assertFalse(buffer.started)
+    assertTrue(buffer.snapshot().isEmpty())
+    buffer.beginSpeech()
+    assertArrayEquals(floatArrayOf(97f, 98f, 99f), buffer.snapshot(), 0f)
+  }
+
+  @Test
+  fun speechIncludesPrerollAndCaptureLimitNeverOverrunsOrReordersSamples() {
+    val buffer = ParakeetAudioBuffer(capacity = 7, preRollSamples = 3)
+    buffer.append(floatArrayOf(0f, 1f, 2f, 3f))
+    buffer.beginSpeech()
+    buffer.beginSpeech()
+    buffer.append(floatArrayOf(4f, 5f, 6f, 7f, 8f, 9f))
+    buffer.append(floatArrayOf(10f))
+    assertTrue(buffer.full)
+    assertEquals(7, buffer.size)
+    assertArrayEquals(floatArrayOf(1f, 2f, 3f, 4f, 5f, 6f, 7f), buffer.snapshot(), 0f)
+  }
+
+  @Test
+  fun retiredCaptureDoesNotLeakEarlierSpeechIntoTheNextTurn() {
+    val buffer = ParakeetAudioBuffer(capacity = 8, preRollSamples = 3)
+    buffer.append(floatArrayOf(3f, 4f))
+    buffer.beginSpeech()
+    buffer.append(floatArrayOf(5f))
+    buffer.clear()
+    assertFalse(buffer.started)
+    assertEquals(0, buffer.size)
+    assertTrue(buffer.snapshot().isEmpty())
+    buffer.append(floatArrayOf(8f))
+    buffer.beginSpeech()
+    assertArrayEquals(floatArrayOf(8f), buffer.snapshot(), 0f)
+  }
+
+  @Test
+  fun snapshotsRemainStableWhileNewAudioIsCaptured() {
+    val buffer = ParakeetAudioBuffer(capacity = 8, preRollSamples = 3)
+    buffer.append(floatArrayOf(1f))
+    buffer.beginSpeech()
+    val partial = buffer.snapshot()
+    buffer.append(floatArrayOf(2f))
+    assertArrayEquals(floatArrayOf(1f), partial, 0f)
+    assertArrayEquals(floatArrayOf(1f, 2f), buffer.snapshot(), 0f)
+  }
+
+  @Test
+  fun conversationAllowsNaturalPausesWhileSuppliedBargeInAudioUsesItsRequestedEndpoint() {
+    assertEquals(1200L, parakeetSilenceMillis(0, false))
+    assertEquals(1200L, parakeetSilenceMillis(1200, false))
+    assertEquals(1000L, parakeetSilenceMillis(100, false))
+    assertEquals(2000L, parakeetSilenceMillis(Long.MAX_VALUE, false))
+    assertEquals(900L, parakeetSilenceMillis(900, true))
+    assertEquals(600L, parakeetSilenceMillis(1, true))
+    assertEquals(1500L, parakeetSilenceMillis(Long.MAX_VALUE, true))
+  }
+}
