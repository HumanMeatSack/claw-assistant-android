index 00000000..412352b2
--- /dev/null
+++ b/apps/android/app/src/thirdPartyDebug/java/ai/openclaw/app/assistant/AidenAssistantPanel.kt
@@ -0,0 +1,534 @@
+package ai.openclaw.app.assistant
+
+import ai.openclaw.app.R
+import android.content.Context
+import android.content.res.ColorStateList
+import android.content.res.Configuration
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PixelFormat
+import android.graphics.Rect
+import android.graphics.Typeface
+import android.graphics.drawable.Drawable
+import android.graphics.drawable.GradientDrawable
+import android.graphics.drawable.RippleDrawable
+import android.text.InputFilter
+import android.text.InputType
+import android.view.Gravity
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.WindowInsets
+import android.view.inputmethod.EditorInfo
+import android.widget.Button
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.ImageButton
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.Space
+import android.widget.TextView
+import androidx.annotation.StringRes
+import androidx.core.view.doOnLayout
+import androidx.core.widget.doAfterTextChanged
+import kotlin.math.roundToInt
+
+/** The view tree for the system assistant window. It leaves microphone and capture state to the session. */
+internal class AidenAssistantPanel(
+  context: Context,
+  onClose: () -> Unit,
+  onOpenChat: () -> Unit,
+  onDictate: () -> Unit,
+  private val onSubmit: (String) -> Unit,
+  onReadScreen: () -> Unit,
+  onShareScreen: () -> Unit,
+  onHandsFree: () -> Unit,
+  onReview: () -> Unit,
+  onEdit: () -> Unit,
+) : FrameLayout(context) {
+  private var palette = paletteFor(resources.configuration)
+  private var dictationLabel = R.string.aiden_assistant_dictate
+
+  val panel =
+    LinearLayout(context).apply {
+      orientation = LinearLayout.VERTICAL
+      isClickable = true
+      isFocusableInTouchMode = true
+      descendantFocusability = ViewGroup.FOCUS_BEFORE_DESCENDANTS
+      setPadding(dp(14), dp(12), dp(14), dp(6))
+    }
+
+  private val emblem =
+    ImageView(context).apply {
+      importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+      scaleType = ImageView.ScaleType.CENTER
+    }
+  private val title =
+    TextView(context).apply {
+      setText(R.string.aiden_assistant_title)
+      textSize = 20f
+      typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+      setAccessibilityHeading(true)
+    }
+  private val close = iconButton(R.string.aiden_assistant_close, onClose)
+
+  private val composer =
+    LinearLayout(context).apply {
+      orientation = LinearLayout.HORIZONTAL
+      gravity = Gravity.CENTER_VERTICAL
+      minimumHeight = dp(56)
+      setPadding(dp(5), 0, dp(5), 0)
+    }
+
+  val input =
+    EditText(context).apply {
+      setHint(R.string.aiden_assistant_ask_hint)
+      setSingleLine(true)
+      inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_CAP_SENTENCES
+      imeOptions = EditorInfo.IME_ACTION_SEND or EditorInfo.IME_FLAG_NO_EXTRACT_UI
+      filters = arrayOf(InputFilter.LengthFilter(1600))
+      background = null
+      minimumHeight = dp(48)
+      textSize = 17f
+      gravity = Gravity.CENTER_VERTICAL or Gravity.START
+      setPaddingRelative(dp(10), 0, dp(6), 0)
+      importantForAutofill = IMPORTANT_FOR_AUTOFILL_NO
+      isSaveEnabled = false
+      setOnFocusChangeListener { _, focused -> if (focused) onEdit() }
+    }
+
+  val dictate =
+    iconButton(R.string.aiden_assistant_dictate) {
+      if (!submitText()) onDictate()
+    }
+
+  val status =
+    TextView(context).apply {
+      textSize = 14f
+      accessibilityLiveRegion = ACCESSIBILITY_LIVE_REGION_POLITE
+      visibility = GONE
+    }
+  val previewText =
+    TextView(context).apply {
+      textSize = 15f
+      setTextIsSelectable(true)
+      setPadding(dp(12), dp(10), dp(12), dp(10))
+    }
+  val preview =
+    ScrollView(context).apply {
+      addView(previewText)
+      isNestedScrollingEnabled = true
+      visibility = GONE
+    }
+  val previewImage =
+    ImageView(context).apply {
+      scaleType = ImageView.ScaleType.FIT_CENTER
+      contentDescription = context.getString(R.string.aiden_assistant_image_preview)
+      visibility = GONE
+    }
+  val review =
+    textButton(R.string.aiden_assistant_screen_review, onReview).apply {
+      visibility = GONE
+    }
+
+  private val screenActions = LinearLayout(context).apply {
+    orientation = LinearLayout.VERTICAL
+    visibility = GONE
+  }
+  val readScreen =
+    textButton(R.string.aiden_assistant_read_screen) {
+      dismissScreenActions()
+      onReadScreen()
+    }
+  val shareScreen =
+    textButton(R.string.aiden_assistant_share_screen) {
+      dismissScreenActions()
+      onShareScreen()
+    }
+  private val handsFree =
+    textButton(R.string.aiden_assistant_hands_free) {
+      dismissScreenActions()
+      onHandsFree()
+    }
+
+  private val useScreen =
+    textButton(R.string.aiden_assistant_use_screen) {
+      if (screenActions.visibility == VISIBLE) {
+        dismissScreenActions()
+      } else {
+        screenActions.visibility = VISIBLE
+        screenActions.doOnLayout { row ->
+          if (row.visibility == VISIBLE) {
+            val bounds = Rect()
+            row.getDrawingRect(bounds)
+            row.requestRectangleOnScreen(bounds)
+          }
+        }
+      }
+    }
+
+  private val openChat = textButton(R.string.aiden_assistant_open_chat_short, onOpenChat).apply {
+    gravity = Gravity.CENTER_VERTICAL or Gravity.END
+  }
+
+  init {
+    clickableBackground(onClose)
+    val scroll =
+      ScrollView(context).apply {
+        clipChildren = false
+        clipToPadding = false
+        isNestedScrollingEnabled = true
+        isVerticalScrollBarEnabled = false
+        addView(panel, LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT))
+      }
+    clipChildren = false
+    clipToPadding = false
+    addView(scroll, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT, Gravity.BOTTOM))
+    setOnApplyWindowInsetsListener { _, insets ->
+      val area = insets.getInsets(WindowInsets.Type.systemBars() or WindowInsets.Type.displayCutout() or WindowInsets.Type.ime())
+      setPadding(dp(10) + area.left, dp(6) + area.top, dp(10) + area.right, dp(8) + area.bottom)
+      insets
+    }
+
+    panel.addView(
+      LinearLayout(context).apply {
+        gravity = Gravity.CENTER_VERTICAL
+        addView(emblem, LinearLayout.LayoutParams(dp(44), dp(44)))
+        addView(
+          title,
+          LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f).apply { marginStart = dp(10) },
+        )
+        addView(close, LinearLayout.LayoutParams(dp(48), dp(48)))
+      },
+      block(),
+    )
+    composer.addView(input, LinearLayout.LayoutParams(0, LayoutParams.WRAP_CONTENT, 1f))
+    composer.addView(dictate, LinearLayout.LayoutParams(dp(48), dp(48)))
+    panel.addView(composer, block(top = 8))
+    panel.addView(status, block(top = 6))
+    panel.addView(preview, block(top = 8, height = dp(128)))
+    panel.addView(previewImage, block(top = 8, height = dp(220)))
+    panel.addView(review, block(top = 2))
+
+    panel.addView(
+      LinearLayout(context).apply {
+        gravity = Gravity.CENTER_VERTICAL
+        addView(useScreen, LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+        addView(Space(context), LinearLayout.LayoutParams(0, dp(1), 1f))
+        addView(openChat, LinearLayout.LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+      },
+      block(top = 5),
+    )
+    screenActions.addView(readScreen, block())
+    screenActions.addView(shareScreen, block())
+    screenActions.addView(handsFree, block())
+    panel.addView(screenActions, block())
+
+    input.doAfterTextChanged { updatePrimaryAction() }
+    input.setOnEditorActionListener { _, action, event ->
+      val enter = event != null && event.keyCode == KeyEvent.KEYCODE_ENTER && event.action == KeyEvent.ACTION_UP
+      (action == EditorInfo.IME_ACTION_SEND || enter) && submitText()
+    }
+
+    updateAppearance()
+    panel.requestFocus()
+    requestApplyInsets()
+  }
+
+  fun setDictationAction(@StringRes label: Int) {
+    dictationLabel = label
+    input.isEnabled = label == R.string.aiden_assistant_dictate
+    updatePrimaryAction()
+  }
+
+  fun dismissScreenActions() {
+    screenActions.visibility = GONE
+  }
+
+  override fun onAttachedToWindow() {
+    super.onAttachedToWindow()
+    requestApplyInsets()
+  }
+
+  override fun onConfigurationChanged(newConfig: Configuration) {
+    super.onConfigurationChanged(newConfig)
+    palette = paletteFor(newConfig)
+    updateAppearance()
+  }
+
+  private fun submitText(): Boolean {
+    if (!dictate.isEnabled || dictationLabel != R.string.aiden_assistant_dictate) return false
+    val text = input.text.toString().trim()
+    if (text.isEmpty()) return false
+    onSubmit(text)
+    return true
+  }
+
+  private fun updatePrimaryAction() {
+    val icon: PanelIcon
+    val label: Int
+    when {
+      dictationLabel == R.string.aiden_assistant_dictate_stop ||
+        dictationLabel == R.string.aiden_assistant_conversation_end -> {
+        icon = PanelIcon.Stop
+        label = dictationLabel
+      }
+      dictationLabel == R.string.aiden_assistant_dictate_cancel -> {
+        icon = PanelIcon.Close
+        label = dictationLabel
+      }
+      input.text.isNotBlank() -> {
+        icon = PanelIcon.Send
+        label = R.string.aiden_assistant_send
+      }
+      else -> {
+        icon = PanelIcon.Mic
+        label = R.string.aiden_assistant_dictate
+      }
+    }
+    dictate.setImageDrawable(drawable(icon, palette.actionInk))
+    dictate.contentDescription = context.getString(label)
+  }
+
+  private fun updateAppearance() {
+    panel.background = rounded(palette.surface, 24, border = palette.border)
+    panel.elevation = dp(5).toFloat()
+    emblem.background = rounded(palette.field, 15)
+    emblem.setImageDrawable(drawable(PanelIcon.Spark, palette.accent))
+    title.setTextColor(palette.primary)
+    close.background = ripple(palette.primary, 18)
+    close.setImageDrawable(drawable(PanelIcon.Close, palette.primary))
+    composer.background = rounded(palette.field, 20)
+    input.setTextColor(palette.primary)
+    input.setHintTextColor(palette.secondary)
+    dictate.background = ripple(palette.actionInk, 16, palette.actionFill)
+    status.setTextColor(palette.secondary)
+    previewText.setTextColor(palette.primary)
+    preview.background = rounded(palette.field, 14)
+    previewImage.background = rounded(palette.field, 14)
+    screenActions.background = rounded(palette.field, 14)
+    styleLink(useScreen, PanelIcon.Screen)
+    styleLink(openChat, PanelIcon.Chat)
+    styleLink(readScreen)
+    styleLink(shareScreen)
+    styleLink(handsFree)
+    styleLink(review)
+    updatePrimaryAction()
+  }
+
+  private fun styleLink(button: Button, icon: PanelIcon? = null) {
+    button.setTextColor(
+      ColorStateList(
+        arrayOf(intArrayOf(-android.R.attr.state_enabled), intArrayOf()),
+        intArrayOf(palette.secondary, palette.accent),
+      ),
+    )
+    button.background = ripple(palette.accent, 13)
+    button.setCompoundDrawablesRelativeWithIntrinsicBounds(icon?.let { drawable(it, palette.accent, size = 19) }, null, null, null)
+  }
+
+  private fun clickableBackground(action: () -> Unit) {
+    importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+    setOnClickListener { action() }
+  }
+
+  private fun textButton(@StringRes label: Int, action: () -> Unit): Button =
+    Button(context).apply {
+      setAllCaps(false)
+      setText(label)
+      textSize = 15f
+      gravity = Gravity.CENTER_VERTICAL or Gravity.START
+      minHeight = dp(48)
+      minimumHeight = dp(48)
+      minWidth = 0
+      minimumWidth = 0
+      stateListAnimator = null
+      compoundDrawablePadding = dp(5)
+      setPaddingRelative(dp(7), dp(2), dp(7), dp(2))
+      setOnClickListener { action() }
+    }
+
+  private fun iconButton(@StringRes label: Int, action: () -> Unit): ImageButton =
+    ImageButton(context).apply {
+      contentDescription = context.getString(label)
+      scaleType = ImageView.ScaleType.CENTER
+      stateListAnimator = null
+      setOnClickListener { action() }
+    }
+
+  private fun block(top: Int = 0, height: Int = LayoutParams.WRAP_CONTENT): LinearLayout.LayoutParams =
+    LinearLayout.LayoutParams(LayoutParams.MATCH_PARENT, height).apply { topMargin = dp(top) }
+
+  private fun rounded(color: Int, radius: Int, border: Int? = null): GradientDrawable =
+    GradientDrawable().apply {
+      setColor(color)
+      cornerRadius = dp(radius).toFloat()
+      if (border != null) setStroke(dp(1), border)
+    }
+
+  private fun ripple(ink: Int, radius: Int, fill: Int? = null): RippleDrawable =
+    RippleDrawable(
+      ColorStateList.valueOf(Color.argb(36, Color.red(ink), Color.green(ink), Color.blue(ink))),
+      fill?.let { rounded(it, radius) },
+      rounded(Color.WHITE, radius),
+    )
+
+  private fun drawable(icon: PanelIcon, color: Int, size: Int = 24): Drawable = AidenPanelIcon(icon, color, dp(size))
+
+  private fun dp(value: Int): Int = (value * resources.displayMetrics.density).roundToInt()
+}
+
+private data class PanelPalette(
+  val surface: Int,
+  val border: Int,
+  val field: Int,
+  val primary: Int,
+  val secondary: Int,
+  val accent: Int,
+  val actionFill: Int,
+  val actionInk: Int,
+)
+
+private fun paletteFor(config: Configuration): PanelPalette =
+  if (config.uiMode and Configuration.UI_MODE_NIGHT_MASK == Configuration.UI_MODE_NIGHT_YES) {
+    PanelPalette(
+      surface = 0xff181e20.toInt(),
+      border = 0xff40534f.toInt(),
+      field = 0xff263235.toInt(),
+      primary = 0xffeef5f5.toInt(),
+      secondary = 0xffadc1c5.toInt(),
+      accent = 0xffa7e6dc.toInt(),
+      actionFill = 0xffa7e6dc.toInt(),
+      actionInk = 0xff103730.toInt(),
+    )
+  } else {
+    PanelPalette(
+      surface = 0xfff8fcfa.toInt(),
+      border = 0xffaabfb9.toInt(),
+      field = 0xffe7f1ef.toInt(),
+      primary = 0xff172927.toInt(),
+      secondary = 0xff526b67.toInt(),
+      accent = 0xff126458.toInt(),
+      actionFill = 0xffa8e3d8.toInt(),
+      actionInk = 0xff103730.toInt(),
+    )
+  }
+
+private enum class PanelIcon { Spark, Close, Mic, Send, Stop, Screen, Chat }
+
+/** Simple line icons with a common 24-unit viewport. */
+private class AidenPanelIcon(
+  private val icon: PanelIcon,
+  color: Int,
+  private val size: Int,
+) : Drawable() {
+  private val paint =
+    Paint(Paint.ANTI_ALIAS_FLAG).apply {
+      this.color = color
+      strokeWidth = 1.8f
+      strokeJoin = Paint.Join.ROUND
+      strokeCap = Paint.Cap.ROUND
+    }
+
+  override fun getIntrinsicWidth(): Int = size
+
+  override fun getIntrinsicHeight(): Int = size
+
+  override fun draw(canvas: Canvas) {
+    val saved = canvas.save()
+    canvas.translate(bounds.left.toFloat(), bounds.top.toFloat())
+    canvas.scale(bounds.width() / 24f, bounds.height() / 24f)
+    paint.style = Paint.Style.STROKE
+    when (icon) {
+      PanelIcon.Spark -> {
+        canvas.drawPath(
+          Path().apply {
+            moveTo(11f, 3f)
+            lineTo(12.9f, 9.2f)
+            lineTo(19f, 11f)
+            lineTo(12.9f, 12.8f)
+            lineTo(11f, 19f)
+            lineTo(9.1f, 12.8f)
+            lineTo(3f, 11f)
+            lineTo(9.1f, 9.2f)
+            close()
+          },
+          paint,
+        )
+        canvas.drawLine(19f, 2.5f, 19f, 7f, paint)
+        canvas.drawLine(16.7f, 4.8f, 21.3f, 4.8f, paint)
+        canvas.drawCircle(4.5f, 18.4f, 1.5f, paint)
+      }
+      PanelIcon.Close -> {
+        canvas.drawLine(6.5f, 6.5f, 17.5f, 17.5f, paint)
+        canvas.drawLine(17.5f, 6.5f, 6.5f, 17.5f, paint)
+      }
+      PanelIcon.Mic -> {
+        canvas.drawRoundRect(9f, 3f, 15f, 14.3f, 3f, 3f, paint)
+        canvas.drawPath(
+          Path().apply {
+            moveTo(6f, 11f)
+            lineTo(6f, 12.1f)
+            cubicTo(6f, 15.5f, 8.7f, 18f, 12f, 18f)
+            cubicTo(15.3f, 18f, 18f, 15.5f, 18f, 12.1f)
+            lineTo(18f, 11f)
+          },
+          paint,
+        )
+        canvas.drawLine(12f, 18f, 12f, 21f, paint)
+      }
+      PanelIcon.Send -> {
+        canvas.drawLine(12f, 20f, 12f, 5f, paint)
+        canvas.drawLine(12f, 5f, 6f, 11f, paint)
+        canvas.drawLine(12f, 5f, 18f, 11f, paint)
+      }
+      PanelIcon.Stop -> {
+        paint.style = Paint.Style.FILL
+        canvas.drawRoundRect(6.5f, 6.5f, 17.5f, 17.5f, 1.6f, 1.6f, paint)
+      }
+      PanelIcon.Screen -> {
+        canvas.drawLine(3f, 8f, 3f, 5f, paint)
+        canvas.drawLine(3f, 5f, 7.5f, 5f, paint)
+        canvas.drawLine(16.5f, 5f, 21f, 5f, paint)
+        canvas.drawLine(21f, 5f, 21f, 8f, paint)
+        canvas.drawLine(21f, 16f, 21f, 19f, paint)
+        canvas.drawLine(21f, 19f, 16.5f, 19f, paint)
+        canvas.drawLine(7.5f, 19f, 3f, 19f, paint)
+        canvas.drawLine(3f, 19f, 3f, 16f, paint)
+        canvas.drawLine(7.5f, 12f, 16.5f, 12f, paint)
+      }
+      PanelIcon.Chat -> {
+        canvas.drawPath(
+          Path().apply {
+            moveTo(4f, 16.5f)
+            cubicTo(0.8f, 10.6f, 5f, 3f, 12f, 3f)
+            cubicTo(17f, 3f, 21f, 6.9f, 21f, 12f)
+            cubicTo(21f, 17f, 17f, 21f, 12f, 21f)
+            cubicTo(10f, 21f, 8.9f, 20.6f, 7.5f, 19.8f)
+            lineTo(3.3f, 21f)
+            close()
+          },
+          paint,
+        )
+      }
+    }
+    canvas.restoreToCount(saved)
+  }
+
+  override fun setAlpha(alpha: Int) {
+    paint.alpha = alpha
+    invalidateSelf()
+  }
+
+  override fun setColorFilter(colorFilter: ColorFilter?) {
+    paint.colorFilter = colorFilter
+    invalidateSelf()
+  }
+
+  @Deprecated("Deprecated by Android Drawable.")
+  override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
