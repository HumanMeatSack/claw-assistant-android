+package ai.openclaw.app.voice
+
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+
+internal enum class AssistantMicrophoneAdmission { Acquired, Busy, Retired }
+
+internal class AssistantMicrophoneBusy : IllegalStateException("Assistant microphone is busy")
+
+/** Wait only for the existing owner to release its microphone; never bypass its admission gate. */
+internal suspend fun awaitAssistantMicrophoneAdmission(
+  isCurrent: () -> Boolean,
+  tryAcquire: () -> Boolean,
+  release: () -> Unit,
+  waitMs: Long = 1_250,
+  retryMs: Long = 50,
+  nowMs: () -> Long = { System.nanoTime() / 1_000_000 },
+): AssistantMicrophoneAdmission {
+  require(waitMs >= 0 && retryMs > 0)
+  val caller = currentCoroutineContext()
+  val startedAt = nowMs()
+  var attempted = false
+  while (true) {
+    caller.ensureActive()
+    if (!isCurrent()) return AssistantMicrophoneAdmission.Retired
+    if (attempted && nowMs() - startedAt >= waitMs) return AssistantMicrophoneAdmission.Busy
+    attempted = true
+    if (tryAcquire()) {
+      var handedOff = false
+      try {
+        caller.ensureActive()
+        if (!isCurrent()) return AssistantMicrophoneAdmission.Retired
+        handedOff = true
+        return AssistantMicrophoneAdmission.Acquired
+      } finally {
+        if (!handedOff) release()
+      }
+    }
+    val remaining = waitMs - (nowMs() - startedAt)
+    if (remaining <= 0) return AssistantMicrophoneAdmission.Busy
+    delay(minOf(retryMs, remaining))
+  }
+}
