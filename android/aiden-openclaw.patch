+
+private enum class PanelIcon { Spark, Close, Mic, Send, Stop, Screen, Chat }
+
+/** Simple line icons with a common 24-unit viewport. */
+private class AidenPanelIcon(
+  private val icon: PanelIcon,
+  color: Int,
+  private val size: Int,
+) : Drawable() {
+  private val paint =
+    Paint(Paint.ANTI_ALIAS_FLAG).apply {
+      this.color = color
+      strokeWidth = 1.8f
+      strokeJoin = Paint.Join.ROUND
+      strokeCap = Paint.Cap.ROUND
+    }
+
+  override fun getIntrinsicWidth(): Int = size
+
+  override fun getIntrinsicHeight(): Int = size
+
+  override fun draw(canvas: Canvas) {
+    val saved = canvas.save()
+    canvas.translate(bounds.left.toFloat(), bounds.top.toFloat())
+    canvas.scale(bounds.width() / 24f, bounds.height() / 24f)
+    paint.style = Paint.Style.STROKE
+    when (icon) {
+      PanelIcon.Spark -> {
+        canvas.drawPath(
+          Path().apply {
+            moveTo(11f, 3f)
+            lineTo(12.9f, 9.2f)
+            lineTo(19f, 11f)
+            lineTo(12.9f, 12.8f)
+            lineTo(11f, 19f)
+            lineTo(9.1f, 12.8f)
+            lineTo(3f, 11f)
+            lineTo(9.1f, 9.2f)
+            close()
+          },
+          paint,
+        )
+        canvas.drawLine(19f, 2.5f, 19f, 7f, paint)
+        canvas.drawLine(16.7f, 4.8f, 21.3f, 4.8f, paint)
+        canvas.drawCircle(4.5f, 18.4f, 1.5f, paint)
+      }
+      PanelIcon.Close -> {
+        canvas.drawLine(6.5f, 6.5f, 17.5f, 17.5f, paint)
+        canvas.drawLine(17.5f, 6.5f, 6.5f, 17.5f, paint)
+      }
+      PanelIcon.Mic -> {
+        canvas.drawRoundRect(9f, 3f, 15f, 14.3f, 3f, 3f, paint)
+        canvas.drawPath(
+          Path().apply {
+            moveTo(6f, 11f)
+            lineTo(6f, 12.1f)
+            cubicTo(6f, 15.5f, 8.7f, 18f, 12f, 18f)
+            cubicTo(15.3f, 18f, 18f, 15.5f, 18f, 12.1f)
+            lineTo(18f, 11f)
+          },
+          paint,
+        )
+        canvas.drawLine(12f, 18f, 12f, 21f, paint)
+      }
+      PanelIcon.Send -> {
+        canvas.drawLine(12f, 20f, 12f, 5f, paint)
+        canvas.drawLine(12f, 5f, 6f, 11f, paint)
+        canvas.drawLine(12f, 5f, 18f, 11f, paint)
+      }
+      PanelIcon.Stop -> {
+        paint.style = Paint.Style.FILL
+        canvas.drawRoundRect(6.5f, 6.5f, 17.5f, 17.5f, 1.6f, 1.6f, paint)
+      }
+      PanelIcon.Screen -> {
+        canvas.drawLine(3f, 8f, 3f, 5f, paint)
+        canvas.drawLine(3f, 5f, 7.5f, 5f, paint)
+        canvas.drawLine(16.5f, 5f, 21f, 5f, paint)
+        canvas.drawLine(21f, 5f, 21f, 8f, paint)
+        canvas.drawLine(21f, 16f, 21f, 19f, paint)
+        canvas.drawLine(21f, 19f, 16.5f, 19f, paint)
+        canvas.drawLine(7.5f, 19f, 3f, 19f, paint)
+        canvas.drawLine(3f, 19f, 3f, 16f, paint)
+        canvas.drawLine(7.5f, 12f, 16.5f, 12f, paint)
+      }
+      PanelIcon.Chat -> {
+        canvas.drawPath(
+          Path().apply {
+            moveTo(4f, 16.5f)
+            cubicTo(0.8f, 10.6f, 5f, 3f, 12f, 3f)
+            cubicTo(17f, 3f, 21f, 6.9f, 21f, 12f)
+            cubicTo(21f, 17f, 17f, 21f, 12f, 21f)
+            cubicTo(10f, 21f, 8.9f, 20.6f, 7.5f, 19.8f)
+            lineTo(3.3f, 21f)
+            close()
+          },
+          paint,
+        )
+      }
+    }
+    canvas.restoreToCount(saved)
+  }
+
+  override fun setAlpha(alpha: Int) {
+    paint.alpha = alpha
+    invalidateSelf()
+  }
+
+  override fun setColorFilter(colorFilter: ColorFilter?) {
+    paint.colorFilter = colorFilter
+    invalidateSelf()
+  }
+
+  @Deprecated("Deprecated by Android Drawable.")
+  override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
