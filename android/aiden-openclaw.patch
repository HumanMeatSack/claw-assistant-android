+package ai.openclaw.app.voice
+
+import ai.openclaw.app.gateway.GatewaySession
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssistantGatewayLeaseTest {
+  @Test
+  fun historyCannotSwitchToReplacementConnectionAfterDelegatedSend() = runBlocking {
+    var current = true
+    val requests = mutableListOf<String>()
+    val lease = GatewaySession.RequestLease("original-mac", isCurrentImpl = { current }) { method, _, _, enqueue ->
+      enqueue { requests += method }
+      "original response"
+    }
+    assertEquals("original response", requestPinnedAssistantGateway(lease, "chat.send", "{}"))
+    current = false
+    var rejected = false
+    try {
+      requestPinnedAssistantGateway(lease, "chat.history", "{}")
+    } catch (_: CancellationException) {
+      rejected = true
+    }
+    assertTrue(rejected)
+    assertEquals(listOf("chat.send"), requests)
+  }
+
+  @Test
+  fun connectionRetiredDuringRequestCannotPublishLateReply() = runBlocking {
+    var current = true
+    val lease = GatewaySession.RequestLease("original-mac", isCurrentImpl = { current }) { _, _, _, enqueue ->
+      enqueue {}
+      current = false
+      "late original reply"
+    }
+    var rejected = false
+    try {
+      requestPinnedAssistantGateway(lease, "chat.send", "{}")
+    } catch (_: CancellationException) {
+      rejected = true
+    }
+    assertTrue(rejected)
+  }
+}
