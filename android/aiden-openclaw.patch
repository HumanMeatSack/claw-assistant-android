@@ -0,0 +1,160 @@
+package ai.openclaw.app.voice
+
+import android.app.Application
+import android.content.Intent
+import android.os.Binder
+import android.os.Process
+import android.os.ParcelFileDescriptor
+import android.speech.RecognitionService
+import android.speech.RecognizerIntent
+import java.lang.reflect.Proxy
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicInteger
+import kotlinx.coroutines.Job
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], application = Application::class)
+class ParakeetRecognitionLifecycleTest {
+  @Test
+  fun stopFinalizesAdmittedCaptureWithoutCancellingOrDiscardingItsAudio() = withService { service ->
+    val current = admittedCapture(service)
+    stop(service, current.callback)
+    assertTrue(current.flag("finishing").get())
+    assertFalse(current.flag("cancelled").get())
+    assertFalse(current.job.isCancelled)
+    assertEquals(0, current.closed.get())
+  }
+
+  @Test
+  fun cancelRetiresTheMicrophoneAndJobOnceAndDisallowsQueuedResults() = withService { service ->
+    val current = admittedCapture(service)
+    cancel(service, current.callback)
+    assertNull(field(service, "active"))
+    assertTrue(current.flag("cancelled").get())
+    assertTrue(current.job.isCancelled)
+    assertEquals(1, current.closed.get())
+    assertFalse(isCurrent(service, current.capture))
+    cancel(service, current.callback)
+    assertEquals(1, current.closed.get())
+  }
+
+  @Test
+  fun lateStopAndCancelFromReplacedListenerCannotRetireNewCapture() = withService { service ->
+    val old = admittedCapture(service)
+    val replacement = admittedCapture(service)
+    stop(service, old.callback)
+    cancel(service, old.callback)
+    assertFalse(replacement.flag("finishing").get())
+    assertFalse(replacement.flag("cancelled").get())
+    assertFalse(replacement.job.isCancelled)
+    assertEquals(0, replacement.closed.get())
+    assertFalse(isCurrent(service, old.capture))
+    assertTrue(isCurrent(service, replacement.capture))
+    cancel(service, replacement.callback)
+    // The synthetic replaced capture is not owned by the service any longer.
+    old.job.cancel()
+  }
+
+  @Test
+  fun serviceDestructionRetiresPendingInputAndSuppressesAnyFurtherResult() = withService { service ->
+    val current = admittedCapture(service)
+    service.onDestroy()
+    assertEquals(1, current.closed.get())
+    assertTrue(current.job.isCancelled)
+    assertFalse(isCurrent(service, current.capture))
+  }
+
+  @Test
+  fun cancellationBeforeCaptureStartsClosesTheTransferredDescriptor() = withService { service ->
+    val pipe = ParcelFileDescriptor.createPipe()
+    try {
+      assertTrue(pipe[0].fileDescriptor.valid())
+      val request = Intent().putExtra(RecognizerIntent.EXTRA_AUDIO_SOURCE, pipe[0])
+      val current = admittedCapture(service, request)
+      cancel(service, current.callback)
+      assertFalse(runCatching { pipe[0].fileDescriptor.valid() }.getOrDefault(false))
+    } finally {
+      pipe.forEach { runCatching { it.close() } }
+    }
+  }
+
+  private data class Admitted(
+    val capture: Any,
+    val callback: RecognitionService.Callback,
+    val job: Job,
+    val closed: AtomicInteger,
+  ) {
+    fun flag(name: String) = field(capture, name) as AtomicBoolean
+  }
+
+  private fun admittedCapture(service: ParakeetRecognitionService, request: Intent = Intent()): Admitted {
+    val callback = callback(service)
+    val captureClass = ParakeetRecognitionService::class.java.declaredClasses.single { it.simpleName == "Capture" }
+    val capture = captureClass.declaredConstructors.single().apply { isAccessible = true }.newInstance(callback, request)
+    val sourceClass = ParakeetRecognitionService::class.java.declaredClasses.single { it.simpleName == "PcmSource" }
+    val closed = AtomicInteger()
+    val source = Proxy.newProxyInstance(sourceClass.classLoader, arrayOf(sourceClass)) { _, method, _ ->
+      if (method.name == "close") closed.incrementAndGet()
+      if (method.returnType == Int::class.javaPrimitiveType) -1 else null
+    }
+    setField(capture, "source", source)
+    val job = Job()
+    setField(capture, "job", job)
+    setField(service, "active", capture)
+    return Admitted(capture, callback, job, closed)
+  }
+
+  private fun callback(service: ParakeetRecognitionService): RecognitionService.Callback {
+    val listenerClass = Class.forName("android.speech.IRecognitionListener")
+    val binder = Binder()
+    val listener = Proxy.newProxyInstance(listenerClass.classLoader, arrayOf(listenerClass)) { _, method, _ ->
+      if (method.name == "asBinder") binder else null
+    }
+    val constructor = RecognitionService.Callback::class.java.declaredConstructors.single {
+      it.parameterTypes.firstOrNull() == RecognitionService::class.java && it.parameterTypes.contains(listenerClass)
+    }
+    val arguments = constructor.parameterTypes.map { type ->
+      when {
+        RecognitionService::class.java.isAssignableFrom(type) -> service
+        type == listenerClass -> listener
+        type == Int::class.javaPrimitiveType -> Process.myUid()
+        type.name == "android.content.AttributionSource" -> service.attributionSource
+        else -> error("Unexpected Callback constructor parameter ${type.name}")
+      }
+    }.toTypedArray()
+    constructor.isAccessible = true
+    return constructor.newInstance(*arguments) as RecognitionService.Callback
+  }
+
+  private fun isCurrent(service: ParakeetRecognitionService, capture: Any): Boolean =
+    service.javaClass.getDeclaredMethod("current", capture.javaClass).apply { isAccessible = true }.invoke(service, capture) as Boolean
+
+  private fun stop(service: ParakeetRecognitionService, callback: RecognitionService.Callback) {
+    service.javaClass.getDeclaredMethod("onStopListening", RecognitionService.Callback::class.java)
+      .apply { isAccessible = true }.invoke(service, callback)
+  }
+
+  private fun cancel(service: ParakeetRecognitionService, callback: RecognitionService.Callback) {
+    service.javaClass.getDeclaredMethod("onCancel", RecognitionService.Callback::class.java)
+      .apply { isAccessible = true }.invoke(service, callback)
+  }
+
+  private fun withService(test: (ParakeetRecognitionService) -> Unit) {
+    val controller = Robolectric.buildService(ParakeetRecognitionService::class.java).create()
+    try { test(controller.get()) } finally { controller.destroy() }
+  }
+
+  private companion object {
+    fun field(owner: Any, name: String): Any? = owner.javaClass.getDeclaredField(name).apply { isAccessible = true }.get(owner)
+    fun setField(owner: Any, name: String, value: Any) = owner.javaClass.getDeclaredField(name).apply { isAccessible = true }.set(owner, value)
+  }
+}
