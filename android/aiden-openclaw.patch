+    previewText.setTextColor(palette.primary)
+    previewText.setLinkTextColor(palette.accent)
+    preview.background = rounded(palette.field, 14)
+    previewImage.background = rounded(palette.field, 14)
+    screenActions.background = rounded(palette.field, 14)
+    styleLink(useScreen, PanelIcon.Screen)
+    styleLink(openChat, PanelIcon.Chat)
+    styleLink(readScreen)
+    styleLink(shareScreen)
+    styleLink(handsFree)
+    styleLink(review)
+    updatePrimaryAction()
+  }
+
+  private fun styleLink(button: Button, icon: PanelIcon? = null) {
+    button.setTextColor(
+      ColorStateList(
+        arrayOf(intArrayOf(-android.R.attr.state_enabled), intArrayOf()),
+        intArrayOf(palette.secondary, palette.accent),
