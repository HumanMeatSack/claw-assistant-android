+        "what happens if I turn the flashlight on",
+        "turn the flashlight off and open maps",
+        "set volume to 40%",
+        "set media volume to 104%",
+        "set ringer volume to -1%",
+        "set media volume to 25% and turn the flashlight on",
+      )
+    for (input in inputs) {
+      assertNull(input, parsePhoneQuickAction(input))
+    }
+  }
+}
