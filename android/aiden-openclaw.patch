@@ -0,0 +1,145 @@
+package ai.openclaw.app.voice
+
+import android.Manifest
+import android.app.KeyguardManager
+import android.content.Context
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class LocalSpeechBargeInTest {
+  @Test
+  fun ownOpeningAndLateEchoFragmentsDoNotInterrupt() {
+    val evidence = LocalBargeInEvidence("No worries. I can help you with the living room television.")
+    evidence.playbackStarted(0)
+    evidence.observe("No worries", true, 100)
+    assertEquals(BargeInEvidence.Converging, evidence.decision(100))
+    assertEquals(BargeInEvidence.Echo, evidence.decision(400))
+    evidence.observe("the living room television", true, 12_000)
+    assertEquals(BargeInEvidence.Echo, evidence.decision(13_000))
+  }
+
+  @Test
+  fun arbitraryCutInWaitsForConvergenceAndRetainsFirstWords() {
+    val evidence = LocalBargeInEvidence("No worries. I can help you.")
+    evidence.playbackStarted(0)
+    evidence.observe("Actually could you check the bedroom", true, 100)
+    assertEquals(BargeInEvidence.Converging, evidence.decision(200))
+    assertEquals(BargeInEvidence.Speech, evidence.decision(400))
+    assertEquals("Actually could you check the bedroom", evidence.text)
+  }
+
+  @Test
+  fun sharedFirstWordCanDivergeIntoAnArbitraryUserRequest() {
+    val evidence = LocalBargeInEvidence("The living room temperature is seventy degrees.")
+    evidence.playbackStarted(0)
+    evidence.observe("The", false, 500)
+    assertEquals(BargeInEvidence.Echo, evidence.decision(700))
+    evidence.observe("The bedroom is what I meant", false, 800)
+    assertEquals(BargeInEvidence.Confirming, evidence.decision(850))
+    assertEquals(BargeInEvidence.Speech, evidence.decision(920))
+    assertEquals("The bedroom is what I meant", evidence.text)
+  }
+
+  @Test
+  fun rearrangedSharedWordsAreNotAVocabularyVeto() {
+    val evidence = LocalBargeInEvidence("The bedroom television is off. The living room light is on.")
+    evidence.playbackStarted(0)
+    evidence.observe("The television light in the bedroom", true, 600)
+    assertEquals(BargeInEvidence.Speech, evidence.decision(600))
+  }
+
+  @Test
+  fun equivalentOwnContractionsRemainEcho() {
+    val evidence = LocalBargeInEvidence("I'm ready. You're connected and it's working.")
+    evidence.playbackStarted(0)
+    evidence.observe("you are connected and it is working", true, 600)
+    assertEquals(BargeInEvidence.Echo, evidence.decision(600))
+  }
+
+  @Test
+  fun arbitrarySpeechKeepsItsFirstWordsAndContinuedUtterance() {
+    val transcript = LocalInterruptionTranscript()
+    transcript.update("Actually", false)
+    assertEquals("Actually", transcript.text())
+    transcript.update("Actually the bedroom television", false)
+    transcript.update("Actually the bedroom television is the one I meant", true)
+    assertEquals("Actually the bedroom television is the one I meant", transcript.text())
+  }
+
+  @Test
+  fun wordsSharedWithAssistantStillCountAsUserSpeech() {
+    for (speech in listOf("The temperature is seventy degrees", "No", "Stop", "My daughter needs help")) {
+      val transcript = LocalInterruptionTranscript()
+      transcript.update(speech, false)
+      assertEquals(speech, transcript.text())
+    }
+  }
+
+  @Test
+  fun segmentedContinuationRetainsFirstSegmentWithoutRepeatingFinalCallback() {
+    val transcript = LocalInterruptionTranscript()
+    transcript.update("Could you check the living room?", true)
+    transcript.update("I want", false)
+    transcript.update("I want the temperature", true)
+    transcript.update("I want the temperature", true)
+    assertEquals("Could you check the living room? I want the temperature", transcript.text())
+  }
+
+  @Test
+  fun recoveryRequiresExplicitContinuationAndAcceptsNearbyVoiceCorrection() {
+    for (request in listOf("Continue", "Resume from where you left off", "Oh never mind, that was somebody else, continue", "Carry on", "Keep going", "Could you please continue your answer")) {
+      assertTrue(request, requestsInterruptedReply(request))
+    }
+    for (request in listOf("Never mind", "Cancel that", "What is the temperature?", "Continue playing music", "Don't continue", "I don't want you to resume", "Never continue", "Should I continue?", "How do I continue?")) {
+      assertFalse(request, requestsInterruptedReply(request))
+    }
+  }
+
+  @Test
+  fun microphoneDenialAndRetiredOwnerDoNotStartCapture() = runBlocking {
+    val context = RuntimeEnvironment.getApplication()
+    shadowOf(context).denyPermissions(Manifest.permission.RECORD_AUDIO)
+    val retirement = AudioRetirement(this)
+    val denied = LocalSpeechBargeIn(context, this, retirement, "Ready.", "en-US", { true }) {
+      error("Denied microphone must not interrupt")
+    }
+    assertFalse(denied.start())
+    denied.close()
+    denied.close()
+    retirement.await()
+    assertFalse(denied.active)
+
+    shadowOf(context).grantPermissions(Manifest.permission.RECORD_AUDIO)
+    val retired = LocalSpeechBargeIn(context, this, retirement, "Ready.", "en-US", { false }) {
+      error("Retired owner must not interrupt")
+    }
+    assertFalse(retired.start())
+    retired.close()
+    retirement.await()
+  }
+
+  @Test
+  fun lockedPhoneCannotStartInterruptionCapture() = runBlocking {
+    val context = RuntimeEnvironment.getApplication()
+    shadowOf(context).grantPermissions(Manifest.permission.RECORD_AUDIO)
+    val keyguard = context.getSystemService(Context.KEYGUARD_SERVICE) as KeyguardManager
+    shadowOf(keyguard).setKeyguardLocked(true)
+    val retirement = AudioRetirement(this)
+    val listener = LocalSpeechBargeIn(context, this, retirement, "Ready.", "en-US", { true }) {
+      error("Locked phone must not interrupt")
+    }
+    assertFalse(listener.start())
+    listener.close()
+    retirement.await()
+  }
+}
