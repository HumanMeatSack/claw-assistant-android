index 0000000000000000000000000000000000000000..2f267d14b87caae32de99e68bfe222ef5e331e8c
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/PhoneUtilityActionExecutor.kt
@@ -0,0 +1,159 @@
+package ai.openclaw.app
+
+import android.content.ActivityNotFoundException
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.net.Uri
+import android.provider.CalendarContract
+import android.provider.MediaStore
+import android.provider.Settings
+
+enum class PhoneUtilityActionResult {
+  INSTALLED_APP_OPENED,
+  APP_NAME_AMBIGUOUS,
+  WEB_PAGE_OPENED,
+  MAP_SEARCH_OPENED,
+  MAP_DIRECTIONS_OPENED,
+  DIALER_OPENED,
+  MESSAGE_DRAFT_OPENED,
+  CALENDAR_DRAFT_OPENED,
+  CAMERA_OPENED,
+  SETTINGS_OPENED,
+  APP_UNAVAILABLE,
+  COULD_NOT_START,
+}
+
+/** Opens a visible Android activity for the user to review and finish. */
+fun executePhoneUtilityAction(context: Context, action: PhoneUtilityAction): PhoneUtilityActionResult =
+  try {
+    when (action) {
+      is PhoneUtilityAction.OpenInstalledApp -> openInstalledApp(context, action.label)
+      is PhoneUtilityAction.OpenWebsite ->
+        launchUtility(
+          context,
+          Intent(Intent.ACTION_VIEW, Uri.parse(action.url).normalizeScheme()).addCategory(Intent.CATEGORY_BROWSABLE),
+          PhoneUtilityActionResult.WEB_PAGE_OPENED,
+        )
+      is PhoneUtilityAction.MapSearch -> {
+        val geo = Intent(Intent.ACTION_VIEW, Uri.parse("geo:0,0?q=${Uri.encode(action.query)}"))
+        if (startUtilityActivity(context, geo)) {
+          PhoneUtilityActionResult.MAP_SEARCH_OPENED
+        } else {
+          launchUtility(
+            context,
+            googleMapsIntent("search", "query", action.query),
+            PhoneUtilityActionResult.MAP_SEARCH_OPENED,
+          )
+        }
+      }
+      is PhoneUtilityAction.MapDirections ->
+        launchUtility(
+          context,
+          googleMapsIntent("dir", "destination", action.destination),
+          PhoneUtilityActionResult.MAP_DIRECTIONS_OPENED,
+        )
+      is PhoneUtilityAction.Dial ->
+        launchUtility(
+          context,
+          Intent(Intent.ACTION_DIAL, Uri.fromParts("tel", action.number, null)),
+          PhoneUtilityActionResult.DIALER_OPENED,
+        )
+      is PhoneUtilityAction.DraftText ->
+        launchUtility(
+          context,
+          Intent(Intent.ACTION_SENDTO, Uri.fromParts("smsto", action.number, null))
+            .putExtra("sms_body", action.body),
+          PhoneUtilityActionResult.MESSAGE_DRAFT_OPENED,
+        )
+      is PhoneUtilityAction.DraftCalendarEvent ->
+        launchUtility(
+          context,
+          Intent(Intent.ACTION_INSERT, CalendarContract.Events.CONTENT_URI)
+            .putExtra(CalendarContract.Events.TITLE, action.title),
+          PhoneUtilityActionResult.CALENDAR_DRAFT_OPENED,
+        )
+      PhoneUtilityAction.OpenCamera ->
+        launchUtility(
+          context,
+          Intent(MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA),
+          PhoneUtilityActionResult.CAMERA_OPENED,
+        )
+      is PhoneUtilityAction.OpenSettings ->
+        launchUtility(context, settingsIntent(action.panel), PhoneUtilityActionResult.SETTINGS_OPENED)
+    }
+  } catch (_: SecurityException) {
+    PhoneUtilityActionResult.COULD_NOT_START
+  }
+
+@Suppress("DEPRECATION")
+private fun openInstalledApp(context: Context, label: String): PhoneUtilityActionResult {
+  val launcher = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
+  val manager = context.packageManager
+  // A flags value of zero limits this existing launcher query to enabled components.
+  val components =
+    manager.queryIntentActivities(launcher, 0).asSequence()
+      .mapNotNull { result ->
+        val activity = result.activityInfo ?: return@mapNotNull null
+        if (!activity.exported || activity.applicationInfo.flags and ApplicationInfo.FLAG_SUSPENDED != 0) {
+          return@mapNotNull null
+        }
+        if (!result.loadLabel(manager).toString().trim().equals(label, ignoreCase = true)) return@mapNotNull null
+        ComponentName(activity.packageName, activity.name)
+      }
+      .distinct()
+      .take(2)
+      .toList()
+
+  return when (components.size) {
+    0 -> PhoneUtilityActionResult.APP_UNAVAILABLE
+    1 -> launchUtility(context, launcher.setComponent(components.single()), PhoneUtilityActionResult.INSTALLED_APP_OPENED)
+    else -> PhoneUtilityActionResult.APP_NAME_AMBIGUOUS
+  }
+}
+
+private fun googleMapsIntent(path: String, parameter: String, value: String): Intent {
+  val url =
+    Uri.Builder()
+      .scheme("https")
+      .authority("www.google.com")
+      .appendPath("maps")
+      .appendPath(path)
+      .appendQueryParameter("api", "1")
+      .appendQueryParameter(parameter, value)
+      .build()
+  return Intent(Intent.ACTION_VIEW, url)
+}
+
+private fun settingsIntent(panel: PhoneUtilitySettingsPanel): Intent =
+  Intent(
+    when (panel) {
+      PhoneUtilitySettingsPanel.Internet -> Settings.Panel.ACTION_INTERNET_CONNECTIVITY
+      PhoneUtilitySettingsPanel.Wifi -> Settings.ACTION_WIFI_SETTINGS
+      PhoneUtilitySettingsPanel.Bluetooth -> Settings.ACTION_BLUETOOTH_SETTINGS
+      PhoneUtilitySettingsPanel.Display -> Settings.ACTION_DISPLAY_SETTINGS
+      PhoneUtilitySettingsPanel.Sound -> Settings.ACTION_SOUND_SETTINGS
+      PhoneUtilitySettingsPanel.Volume -> Settings.Panel.ACTION_VOLUME
+      PhoneUtilitySettingsPanel.BatterySaver -> Settings.ACTION_BATTERY_SAVER_SETTINGS
+      PhoneUtilitySettingsPanel.AirplaneMode -> Settings.ACTION_AIRPLANE_MODE_SETTINGS
+      PhoneUtilitySettingsPanel.Accessibility -> Settings.ACTION_ACCESSIBILITY_SETTINGS
+      PhoneUtilitySettingsPanel.Nfc -> Settings.ACTION_NFC_SETTINGS
+      PhoneUtilitySettingsPanel.DoNotDisturb -> Settings.ACTION_ZEN_MODE_PRIORITY_SETTINGS
+    },
+  )
+
+private fun launchUtility(
+  context: Context,
+  intent: Intent,
+  success: PhoneUtilityActionResult,
+): PhoneUtilityActionResult =
+  if (startUtilityActivity(context, intent)) success else PhoneUtilityActionResult.APP_UNAVAILABLE
+
+private fun startUtilityActivity(context: Context, intent: Intent): Boolean =
+  try {
+    context.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    true
+  } catch (_: ActivityNotFoundException) {
+    false
+  }
