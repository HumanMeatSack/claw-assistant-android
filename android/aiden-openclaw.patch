+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class AidenAssistantPanelTest {
+  @Test
+  fun primaryActionDictatesWithoutTextAndSubmitsWithText() {
+    val fixture = Fixture()
+    val panel = fixture.panel
+
+    panel.input.setText("   ")
+    fixture.assertPrimaryLabel(R.string.aiden_assistant_dictate)
+    assertTrue(panel.dictate.performClick())
+    assertEquals(1, fixture.dictationTaps)
+    assertTrue(fixture.submissions.isEmpty())
+
+    panel.input.setText("  What is my battery level?  ")
+    fixture.assertPrimaryLabel(R.string.aiden_assistant_send)
+    assertTrue(panel.dictate.performClick())
+    assertEquals(listOf("What is my battery level?"), fixture.submissions)
+    assertEquals(1, fixture.dictationTaps)
+
+    panel.input.setText("Check my battery")
+    panel.input.onEditorAction(EditorInfo.IME_ACTION_SEND)
+    assertEquals(listOf("What is my battery level?", "Check my battery"), fixture.submissions)
+    assertEquals(1, fixture.dictationTaps)
+  }
+
+  @Test
+  fun stopDictationTakesPriorityOverTypedDraft() {
+    val fixture = Fixture()
+    val panel = fixture.panel
+    panel.input.setText("keep this draft")
+
+    panel.setDictationAction(R.string.aiden_assistant_dictate_stop)
+    fixture.assertPrimaryLabel(R.string.aiden_assistant_dictate_stop)
+    assertFalse(panel.input.isEnabled)
+    panel.input.onEditorAction(EditorInfo.IME_ACTION_SEND)
+    assertTrue(panel.dictate.performClick())
+    assertEquals(1, fixture.dictationTaps)
+    assertTrue(fixture.submissions.isEmpty())
+
+    panel.setDictationAction(R.string.aiden_assistant_dictate)
+    assertTrue(panel.input.isEnabled)
+    assertEquals("keep this draft", panel.input.text.toString())
+    fixture.assertPrimaryLabel(R.string.aiden_assistant_send)
+  }
+
+  @Test
+  fun useScreenExpandsInlineActionsAndEachActionDismissesThem() {
+    val fixture = Fixture()
+    val useScreen = fixture.button(R.string.aiden_assistant_use_screen)
+    val inlineActions = fixture.panel.readScreen.parent as View
+    assertEquals(View.GONE, inlineActions.visibility)
+
+    useScreen.performClick()
+    assertEquals(View.VISIBLE, inlineActions.visibility)
+    useScreen.performClick()
+    assertEquals(View.GONE, inlineActions.visibility)
+    assertTrue(fixture.screenActions.isEmpty())
+
+    for (label in listOf(R.string.aiden_assistant_read_screen, R.string.aiden_assistant_share_screen, R.string.aiden_assistant_hands_free)) {
+      useScreen.performClick()
+      assertEquals(View.VISIBLE, inlineActions.visibility)
+      fixture.button(label).performClick()
+      assertEquals(View.GONE, inlineActions.visibility)
+    }
+    assertEquals(listOf("read", "share", "hands-free"), fixture.screenActions)
+  }
+
+  private class Fixture {
+    private val context: Context = RuntimeEnvironment.getApplication()
+    val submissions = mutableListOf<String>()
+    val screenActions = mutableListOf<String>()
+    var dictationTaps = 0
+      private set
+
+    val panel =
+      AidenAssistantPanel(
+        context = context,
+        onClose = {},
+        onOpenChat = {},
+        onDictate = { dictationTaps += 1 },
+        onSubmit = { submissions += it },
+        onReadScreen = { screenActions += "read" },
+        onShareScreen = { screenActions += "share" },
+        onHandsFree = { screenActions += "hands-free" },
+        onReview = {},
+        onEdit = {},
+      )
+
+    fun assertPrimaryLabel(resource: Int) {
+      assertEquals(context.getString(resource), panel.dictate.contentDescription.toString())
+    }
+
+    fun button(resource: Int): Button {
+      val label = context.getString(resource)
+      return panel.descendantButtons().single { it.text.toString() == label }
+    }
+  }
+}
+
+private fun View.descendantButtons(): Sequence<Button> =
+  sequence {
+    if (this@descendantButtons is Button) yield(this@descendantButtons)
+    val group = this@descendantButtons as? ViewGroup ?: return@sequence
+    for (i in 0 until group.childCount) yieldAll(group.getChildAt(i).descendantButtons())
+  }
