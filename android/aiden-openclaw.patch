@@ -0,0 +1,143 @@
+package ai.openclaw.app.voice
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.async
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.test.advanceTimeBy
+import kotlinx.coroutines.test.runCurrent
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+@OptIn(ExperimentalCoroutinesApi::class)
+class AssistantMicrophoneAdmissionTest {
+  @Test
+  fun readyMicrophoneStartsWithoutAddingLatency() = runTest {
+    var attempts = 0
+    var releases = 0
+    val result = awaitAssistantMicrophoneAdmission(
+      isCurrent = { true },
+      tryAcquire = { attempts++; true },
+      release = { releases++ },
+      nowMs = { testScheduler.currentTime },
+    )
+
+    assertEquals(AssistantMicrophoneAdmission.Acquired, result)
+    assertEquals(1, attempts)
+    assertEquals(0, releases)
+    assertEquals(0L, testScheduler.currentTime)
+  }
+
+  @Test
+  fun previousOwnerMustActuallyReleaseBeforeStartupCanAcquire() = runTest {
+    var previousOwner = true
+    var leased = false
+    var releases = 0
+    launch { delay(175); previousOwner = false }
+    val result = awaitAssistantMicrophoneAdmission(
+      isCurrent = { true },
+      tryAcquire = { if (previousOwner || leased) false else { leased = true; true } },
+      release = { releases++; leased = false },
+      nowMs = { testScheduler.currentTime },
+    )
+
+    assertEquals(AssistantMicrophoneAdmission.Acquired, result)
+    assertEquals(200L, testScheduler.currentTime)
+    assertTrue(leased)
+    assertEquals(0, releases)
+  }
+
+  @Test
+  fun persistentBusyOwnerIsNeverStolenAndWaitIsBounded() = runTest {
+    var attempts = 0
+    var releases = 0
+    val result = awaitAssistantMicrophoneAdmission(
+      isCurrent = { true },
+      tryAcquire = { attempts++; false },
+      release = { releases++ },
+      nowMs = { testScheduler.currentTime },
+    )
+
+    assertEquals(AssistantMicrophoneAdmission.Busy, result)
+    assertEquals(1_250L, testScheduler.currentTime)
+    assertEquals(25, attempts)
+    assertEquals(0, releases)
+  }
+
+  @Test
+  fun retiredPanelOrRouteStopsWaitingWithoutAnotherAcquisitionAttempt() = runTest {
+    var current = true
+    var attempts = 0
+    launch { delay(75); current = false }
+    val result = awaitAssistantMicrophoneAdmission(
+      isCurrent = { current },
+      tryAcquire = { attempts++; false },
+      release = { error("No lease was acquired") },
+      nowMs = { testScheduler.currentTime },
+    )
+
+    assertEquals(AssistantMicrophoneAdmission.Retired, result)
+    assertEquals(2, attempts)
+    assertEquals(100L, testScheduler.currentTime)
+  }
+
+  @Test
+  fun cancellationWhileWaitingCannotAcquireWhenOldOwnerLaterReleases() = runTest {
+    var busy = true
+    var attempts = 0
+    val startup = async(start = CoroutineStart.UNDISPATCHED) {
+      awaitAssistantMicrophoneAdmission(
+        isCurrent = { true },
+        tryAcquire = { attempts++; !busy },
+        release = { error("No lease was acquired") },
+        nowMs = { testScheduler.currentTime },
+      )
+    }
+    startup.cancel()
+    busy = false
+    advanceTimeBy(1_500)
+    runCurrent()
+
+    assertTrue(startup.isCancelled)
+    assertEquals(1, attempts)
+  }
+
+  @Test
+  fun retirementDuringAcquisitionReleasesOnlyItsNewLease() = runTest {
+    var current = true
+    var releases = 0
+    val result = awaitAssistantMicrophoneAdmission(
+      isCurrent = { current },
+      tryAcquire = { current = false; true },
+      release = { releases++ },
+      nowMs = { testScheduler.currentTime },
+    )
+
+    assertEquals(AssistantMicrophoneAdmission.Retired, result)
+    assertEquals(1, releases)
+  }
+
+  @Test
+  fun cancellationDuringAcquisitionReleasesLeaseAndPreservesCancellation() = runTest {
+    var releases = 0
+    val startup = async {
+      val job = currentCoroutineContext()[Job]!!
+      awaitAssistantMicrophoneAdmission(
+        isCurrent = { true },
+        tryAcquire = { job.cancel(); true },
+        release = { releases++ },
+        nowMs = { testScheduler.currentTime },
+      )
+    }
+    val error = runCatching { startup.await() }.exceptionOrNull()
+
+    assertTrue(error is CancellationException)
+    assertEquals(1, releases)
+  }
+}
