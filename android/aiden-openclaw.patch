+package ai.openclaw.app.voice
+
+import kotlin.math.roundToInt
+
+/** Keep the model's mono frame count and sample clock while using Android's PCM16 output path. */
+internal fun albaPcm16(samples: FloatArray): ShortArray = ShortArray(samples.size) { index ->
+  val sample = samples[index]
+  require(sample.isFinite()) { "Alba produced invalid PCM" }
+  (sample.coerceIn(-1f, 1f) * Short.MAX_VALUE).roundToInt().toShort()
+}
