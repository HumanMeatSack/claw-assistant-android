@@ -0,0 +1,47 @@
+package ai.openclaw.app.assistant
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.net.Uri
+import androidx.core.content.FileProvider
+import java.io.File
+import java.io.IOException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+private const val maxSharedDimension = 1600
+private const val maxStagedAgeMs = 30 * 60 * 1000L
+
+/** Writes a private, bounded attachment after the user chooses to review the captured image. */
+internal suspend fun stageAidenScreenshot(context: Context, bitmap: Bitmap): Uri? = withContext(Dispatchers.IO) {
+  val directory = File(context.cacheDir, "aiden-screen-share")
+  if ((!directory.isDirectory && !directory.mkdirs()) || bitmap.isRecycled) return@withContext null
+  val now = System.currentTimeMillis()
+  directory.listFiles()?.filter { it.isFile && now - it.lastModified() > maxStagedAgeMs }?.forEach { it.delete() }
+
+  val sourceDimension = maxOf(bitmap.width, bitmap.height)
+  val scaled = if (sourceDimension <= maxSharedDimension) bitmap else Bitmap.createScaledBitmap(
+    bitmap,
+    (bitmap.width * maxSharedDimension.toLong() / sourceDimension).toInt().coerceAtLeast(1),
+    (bitmap.height * maxSharedDimension.toLong() / sourceDimension).toInt().coerceAtLeast(1),
+    true,
+  )
+  var file: File? = null
+  var staged = false
+  try {
+    val target = File.createTempFile("screen-", ".jpg", directory)
+    file = target
+    val encoded = target.outputStream().buffered().use { stream -> scaled.compress(Bitmap.CompressFormat.JPEG, 85, stream) }
+    if (!encoded) return@withContext null
+    val uri = FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", target)
+    staged = true
+    uri
+  } catch (_: IOException) {
+    null
+  } catch (_: IllegalArgumentException) {
+    null
+  } finally {
+    if (!staged) file?.delete()
+    if (scaled !== bitmap) scaled.recycle()
+  }
+}
