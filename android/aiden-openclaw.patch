+import java.util.Locale
+
+internal class AidenAssistantSession(
+  context: Context,
+) : VoiceInteractionSession(context) {
+  private val handler = Handler(Looper.getMainLooper())
+  private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main.immediate)
+  private val screenOffReceiver =
+    object : BroadcastReceiver() {
+      override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action == Intent.ACTION_SCREEN_OFF) closeOverlay()
+      }
+    }
+  private val captureTimeout =
+    Runnable {
+      val wasImage = awaitingCapture?.image == true
+      clearScreenExcerpt()
+      showStatus(if (wasImage) R.string.aiden_assistant_image_unavailable else R.string.aiden_assistant_screen_unavailable)
+    }
+  private lateinit var root: AidenAssistantPanel
+  private var currentCapture = 0L
+  private var awaitingCapture: ScreenCapture? = null
+  private var shownCapture: Long? = null
+  private var frameCommit: Runnable? = null
+  private var imageRequested = false
+  private var finishing = false
+  private var draftImage: Bitmap? = null
+  private var imageStageJob: Job? = null
+  private var draft: AssistantDraft? = null
+  private var visible = false
+  private var watchingScreenOff = false
+  private var dictationGeneration = 0L
+  private var dictationJob: Job? = null
+  private var dictationController: ChatDictationController? = null
+  private var wakeDictationPending = false
+  private var wakeGreetingJob: Job? = null
+  private val wakeSpeech = SystemSpeechSpeaker(context)
+  private var conversation: OverlayConversation? = null
+  private var conversationObserver: Job? = null
+
+  override fun onCreate() {
+    super.onCreate()
+    setDisabledShowContext(disabledScreenContext)
+  }
+
+  override fun onCreateContentView(): View {
+    window.window?.apply {
+      clearFlags(WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM)
+      setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_NOTHING)
+    }
+    root = AidenAssistantPanel(
+      context = context,
+      onClose = ::closeOverlay,
+      onOpenChat = ::openChat,
+      onDictate = {
+        if (conversation != null) {
+          stopConversation()
+          showStatus(R.string.aiden_assistant_conversation_ended)
+        } else {
+          cancelWakeGreeting()
+          toggleDictation()
+        }
+      },
+      onEdit = {
+        cancelWakeGreeting()
+        cancelDictation()
+        stopConversation()
+        wakeSpeech.stop()
+      },
+      onSubmit = ::submitPrompt,
+      onReadScreen = { requestScreenContext(image = false) },
+      onShareScreen = { requestScreenContext(image = true) },
+      onHandsFree = {
+        if (isInteractive()) openActivity(Intent(context, AidenWakeSettingsActivity::class.java))
+      },
+      onReview = { reviewDraft() },
+    )
+    root.viewTreeObserver.addOnWindowFocusChangeListener { focused ->
+      if (focused) startWakeDictationIfReady()
+      if (!focused && dictationJob?.isActive == true) cancelDictation()
+      if (!focused) {
+        cancelWakeGreeting()
+        stopConversation()
+        wakeSpeech.stop()
+      }
+    }
+    return root
+  }
+
+  override fun onShow(args: Bundle?, showFlags: Int) {
+    super.onShow(args, showFlags)
+    visible = true
+    val fromWake = AidenAssistantService.onSessionShown(this, args)
+    if (!watchingScreenOff) {
+      ContextCompat.registerReceiver(
+        context,
+        screenOffReceiver,
+        IntentFilter(Intent.ACTION_SCREEN_OFF),
+        ContextCompat.RECEIVER_NOT_EXPORTED,
+      )
+      watchingScreenOff = true
+    }
+    val request = awaitingCapture
+    if (request != null &&
+      args?.getLong(screenRequestId) == request.id &&
+      (!request.image || showFlags and SHOW_WITH_SCREENSHOT != 0)
+    ) {
+      shownCapture = request.id
+    } else {
+      cancelWakeGreeting()
+      cancelDictation()
+      stopConversation()
+      clearScreenExcerpt()
+      if (::root.isInitialized) root.dismissScreenActions()
+    }
+    wakeDictationPending = fromWake
+    if (wakeDictationPending && ::root.isInitialized) root.post { startWakeDictationIfReady() }
+  }
+
+  override fun onHide() {
+    retireOverlay()
+    super.onHide()
+    if (imageRequested) finishImageSession()
+  }
+
+  override fun onBackPressed() {
+    if (keyboardIsVisible()) dismissKeyboard() else closeOverlay()
+  }
+
+  override fun onCloseSystemDialogs() = closeOverlay()
+
+  override fun onLockscreenShown() {
+    closeOverlay()
+  }
+
+  override fun onDestroy() {
+    retireOverlay()
+    wakeSpeech.shutdown()
+    scope.cancel()
+    super.onDestroy()
+  }
+
+  override fun onHandleAssist(state: AssistState) {
+    val request = awaitingCapture ?: return
+    if (request.image || shownCapture != request.id || !isInteractive() || !state.isFocused) return
+    val structure = state.assistStructure ?: return
+    if (structure.activityComponent?.packageName == context.packageName) return
+    val visibleText = extractVisibleText(structure)
+    clearScreenExcerpt()
+    if (visibleText.isBlank()) {
+      showStatus(R.string.aiden_assistant_screen_unavailable)
+    } else {
+      val quotedExcerpt = visibleText.lineSequence().joinToString("\n") { "> $it" }
+      showPreview(visibleText, context.getString(R.string.aiden_assistant_screen_prompt, quotedExcerpt), screenContext = true)
+    }
+  }
+
+  override fun onHandleScreenshot(screenshot: Bitmap?) {
+    val request = awaitingCapture ?: return
+    if (!request.image || shownCapture != request.id || screenshot == null || !isInteractive()) return
+    clearScreenExcerpt()
+    draftImage = screenshot
+    root.previewImage.setImageBitmap(screenshot)
+    root.previewImage.visibility = View.VISIBLE
+    root.review.visibility = View.VISIBLE
+  }
+
+  private fun requestScreenContext(image: Boolean) {
+    if (!isInteractive() || dictationJob?.isActive == true || awaitingCapture != null || image && imageRequested) return
+    cancelWakeGreeting()
+    stopConversation()
+    root.dismissScreenActions()
+    dismissKeyboard()
+    clearScreenExcerpt()
+    var showFlags = SHOW_WITH_ASSIST
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.CINNAMON_BUN) {
+      val manager = context.getSystemService(VoiceInteractionManager::class.java)
+      if (manager?.canReadScreenContext() != true) {
+        if (manager?.readScreenContextRequestState == VoiceInteractionManager.READ_SCREEN_CONTEXT_REQUEST_STATE_REQUESTABLE) {
+          openActivity(Intent(context, AidenScreenContextPermissionActivity::class.java))
+        } else {
+          showStatus(R.string.aiden_assistant_screen_permission_unavailable)
+        }
+        return
+      }
+      if (!image) showFlags = showFlags or SHOW_WITH_ASSIST_STRUCTURE_SCREEN_CONTENT
+    }
+    if (image) showFlags = showFlags or SHOW_WITH_SCREENSHOT
+    if (userDisabledShowContext and showFlags != 0) {
+      showStatus(R.string.aiden_assistant_screen_permission_unavailable)
+      return
+    }
+
+    val request = ScreenCapture(++currentCapture, image)
+    awaitingCapture = request
+    root.readScreen.isEnabled = false
+    root.shareScreen.isEnabled = false
+    showStatus(R.string.aiden_assistant_screen_loading)
+    handler.postDelayed(captureTimeout, 2500)
+    if (!image) {
+      requestAndroidCapture(request, showFlags)
+      return
+    }
+    scope.launch {
+      val keyboardHidden = withTimeoutOrNull(700) {
+        while (keyboardIsVisible()) delay(25)
+        true
+      } == true
+      if (awaitingCapture != request || !isInteractive()) return@launch
+      if (keyboardHidden) hidePanelForScreenshot(request, showFlags)
+      else {
+        clearScreenExcerpt()
+        showStatus(R.string.aiden_assistant_image_unavailable)
+      }
+    }
+  }
+
+  private fun hidePanelForScreenshot(request: ScreenCapture, showFlags: Int) {
+    val observer = root.viewTreeObserver
+    if (!root.isHardwareAccelerated || !observer.isAlive) {
+      clearScreenExcerpt()
+      showStatus(R.string.aiden_assistant_image_unavailable)
+      return
+    }
+    // Android's assist screenshot can include the assistant window. Wait for a submitted
+    // frame with its panel hidden before asking the platform to take the screenshot.
+    val afterPanelHidden =
+      Runnable {
+        if (awaitingCapture != request || !isInteractive()) return@Runnable
+        frameCommit = null
+        imageRequested = true
+        requestAndroidCapture(request, showFlags)
+      }
+    frameCommit = afterPanelHidden
+    observer.registerFrameCommitCallback(afterPanelHidden)
+    root.panel.visibility = View.INVISIBLE
+    root.invalidate()
+  }
+
+  private fun requestAndroidCapture(request: ScreenCapture, showFlags: Int) {
+    try {
+      setDisabledShowContext(if (request.image) 0 else SHOW_WITH_SCREENSHOT)
+      try {
+        show(Bundle().apply { putLong(screenRequestId, request.id) }, showFlags)
+      } finally {
+        setDisabledShowContext(disabledScreenContext)
+      }
+    } catch (_: RuntimeException) {
+      clearScreenExcerpt()
+      showStatus(if (request.image) R.string.aiden_assistant_image_unavailable else R.string.aiden_assistant_screen_unavailable)
+    }
+  }
+
+  private fun reviewDraft() {
+    if (!isInteractive() || imageStageJob?.isActive == true) return
+    stopConversation()
+    val question = root.input.text.toString().trim().takeIf(String::isNotEmpty)
+    dismissKeyboard()
+    val image = draftImage
+    val intent = Intent(context, MainActivity::class.java).setAction(Intent.ACTION_SEND)
+    if (image == null) {
+      val currentDraft = draft ?: return
+      val text = if (question != null && currentDraft.screenContext) "$question\n\n${currentDraft.text}" else currentDraft.text
+      openActivity(intent.setType("text/plain").putExtra(Intent.EXTRA_TEXT, text))
+      return
+    }
+    root.review.isEnabled = false
+    imageStageJob =
+      scope.launch {
+        try {
+          val uri = stageAidenScreenshot(context, image)
+          if (draftImage !== image || !isInteractive()) return@launch
+          if (uri == null) {
+            showStatus(R.string.aiden_assistant_image_stage_failed)
+            return@launch
+          }
+          openActivity(
+            intent
+              .setType("image/jpeg")
+              .putExtra(Intent.EXTRA_STREAM, uri)
+              .putExtra(
+                Intent.EXTRA_TEXT,
+                listOfNotNull(question, context.getString(R.string.aiden_assistant_image_prompt)).joinToString("\n\n"),
+              )
+              .apply { clipData = ClipData.newUri(context.contentResolver, "Aiden screen image", uri) }
+              .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION),
+          )
+        } catch (error: CancellationException) {
+          throw error
+        } catch (_: RuntimeException) {
+          if (draftImage === image && isInteractive()) showStatus(R.string.aiden_assistant_image_stage_failed)
+        } finally {
+          if (draftImage === image) root.review.isEnabled = true
+        }
+      }
+  }
+
+  private fun openChat() {
+    if (!isInteractive()) return
+    if (draftImage != null || draft?.screenContext == true) {
+      reviewDraft()
+      return
+    }
+    val intent = Intent(context, MainActivity::class.java)
+    val text = root.input.text.toString().trim().takeIf(String::isNotEmpty) ?: draft?.text
+    if (text == null) openActivity(intent.setAction(Intent.ACTION_ASSIST))
+    else openActivity(intent.setAction(Intent.ACTION_SEND).setType("text/plain").putExtra(Intent.EXTRA_TEXT, text))
+  }
+
+  private fun openActivity(intent: Intent) {
+    cancelWakeGreeting()
+    cancelDictation()
+    stopConversation()
+    dismissKeyboard()
+    try {
+      startAssistantActivity(intent)
+      closeOverlay()
+    } catch (_: RuntimeException) {
+      showStatus(R.string.aiden_assistant_open_failed)
+    }
+  }
+
+  private fun submitPrompt(raw: String) {
+    if (!isInteractive() || conversation != null || dictationJob?.isActive == true || awaitingCapture != null) return
+    val text = raw.trim().take(maxDictationCharacters)
+    if (text.isEmpty()) return
+    cancelWakeGreeting()
+    root.dismissScreenActions()
+    if (draftImage != null || draft?.screenContext == true) {
+      reviewDraft()
+      return
+    }
+    dismissKeyboard()
+    root.input.text.clear()
+    clearScreenExcerpt()
+    if (!runOverlayCommand(text, speakResult = false)) showPreview(text, text)
+  }
+
+  private fun runOverlayCommand(text: String, speakResult: Boolean): Boolean {
+    val command = parsePhoneCommand(text)
+    if (command !is PhoneCommand.Quick && command !is PhoneCommand.Device) return false
+    val feedback = executePhoneCommand(context, command)
+    root.status.text = feedback.message
+    root.status.visibility = View.VISIBLE
+    if (speakResult && command is PhoneCommand.Device && isInteractive()) {
+      scope.launch {
+        try {
+          withTimeoutOrNull(dictationTimeoutMillis) { wakeSpeech.speakOffline(feedback.message) }
+        } catch (error: CancellationException) {
+          throw error
+        } catch (_: RuntimeException) {
+          // The result stays visible if on-device speech is unavailable.
+        }
+      }
+    }
+    return true
+  }
+
+  private fun startWakeDictationIfReady() {
+    if (!wakeDictationPending || !isInteractive()) return
+    wakeDictationPending = false
+    if (!hasMicPermission()) {
+      showStatus(R.string.aiden_assistant_mic_denied)
+      return
+    }
+    root.dictate.isEnabled = false
+    showStatus(R.string.aiden_assistant_wake_greeting)
+    wakeGreetingJob = scope.launch {
+      val greeting = async {
+        try {
+          try {
+            withTimeoutOrNull(greetingTimeoutMs) { wakeSpeech.speakOffline(context.getString(R.string.aiden_assistant_wake_greeting)) }
+          } catch (error: CancellationException) {
+            throw error
+          } catch (_: RuntimeException) {
+            // An unavailable voice should not prevent on-device recognition.
+          }
+          // Let the playback tail clear before opening the command microphone.
+          delay(greetingAudioTailMs)
+        } finally {
+          root.dictate.isEnabled = true
+        }
+        if (isInteractive()) showStatus(R.string.aiden_assistant_conversation_connecting)
+      }
+      val started = startConversation { greeting.await() }
+      greeting.await()
+      if (!started && isInteractive()) toggleDictation(fromWake = true)
+    }
+  }
+
+  private fun cancelWakeGreeting() {
+    wakeDictationPending = false
+    wakeGreetingJob?.cancel()
+    wakeGreetingJob = null
+  }
+
+  private suspend fun startConversation(awaitGreeting: suspend () -> Unit): Boolean {
+    if (!canStartConversation()) return false
+    val app = context.applicationContext as? NodeApp ?: return false
+    val runtime =
+      try {
+        app.peekRuntime() ?: withContext(Dispatchers.Default) { app.ensureBackgroundRuntime() }
+      } catch (error: CancellationException) {
+        throw error
+      } catch (_: RuntimeException) {
+        return false
+      }
+    if (!canStartConversation()) return false
+    wakeSpeech.stop()
+    val lifetime = SupervisorJob(scope.coroutineContext[Job])
+    val ownerScope = CoroutineScope(scope.coroutineContext + lifetime)
+    val talk =
+      try {
+        runtime.startAssistantConversation(ownerScope, beforeListening = {
+          awaitGreeting()
+          canStartConversation()
+        }) { text ->
+          withContext(Dispatchers.Main.immediate) { handleConversationTurn(lifetime, text) }
+        }
+      } catch (error: CancellationException) {
+        lifetime.cancel()
+        throw error
+      } catch (error: RuntimeException) {
+        Log.d("AidenAssistant", "Conversation startup failed: ${error.javaClass.simpleName}")
+        null
+      }
+    if (talk == null) {
+      lifetime.cancel()
+      return false
+    }
+    val current = OverlayConversation(runtime, talk, lifetime)
+    conversation = current
+    root.dismissScreenActions()
+    root.setDictationAction(R.string.aiden_assistant_conversation_end)
+    observeConversation(current)
+    return true
+  }
+
+  private fun canStartConversation(): Boolean =
+    isInteractive() && hasMicPermission() && conversation == null && dictationJob?.isActive != true && awaitingCapture == null
+
+  private fun observeConversation(current: OverlayConversation) {
+    val talk = current.talk
+    val startingStatus = talk.statusText.value
+    var hasStarted = false
+    conversationObserver =
+      scope.launch {
+        combine(talk.isEnabled, talk.isListening, talk.isSpeaking, talk.statusText, talk.failureNotice, ::ConversationPresentation)
+          .collect { status ->
+            if (conversation !== current) return@collect
+            val failure = talk.failureNotice.value?.text ?: status.failure?.text
+            if (!status.enabled || failure != null) {
+              stopConversation()
+              if (isInteractive() && draft == null) {
+                if (failure == null) showStatus(R.string.aiden_assistant_conversation_ended)
+                else showStatus(failure)
+              }
+              return@collect
+            }
+            if (draft != null || !isInteractive()) return@collect
+            when {
+              status.speaking -> {
+                hasStarted = true
+                showStatus(R.string.aiden_assistant_conversation_speaking)
+              }
+              status.listening -> {
+                hasStarted = true
+                showStatus(R.string.aiden_assistant_dictate_listening)
+              }
+              hasStarted || status.text != startingStatus -> showStatus(status.text)
+            }
+          }
+      }
+  }
+
+  private fun handleConversationTurn(lifetime: Job, raw: String): AssistantConversationTurn? {
+    if (conversation?.lifetime !== lifetime || !lifetime.isActive || !isInteractive()) return AssistantConversationTurn.Stop
+    val text = raw.trim()
+    val normalized = text.trimEnd('.', '!', '?').lowercase(Locale.ROOT).removePrefix("please ")
+    if (normalized in conversationStopPhrases) return AssistantConversationTurn.Stop
+    return when (val command = parsePhoneCommand(text)) {
+      is PhoneCommand.Quick, is PhoneCommand.Device -> AssistantConversationTurn.Reply(executePhoneCommand(context, command).message)
+      is PhoneCommand.Utility, is PhoneCommand.Google -> {
+        val preview = text.take(maxDictationCharacters)
+        showPreview(preview, preview)
+        AssistantConversationTurn.Stop
+      }
+      null -> null
+    }
+  }
+
+  private fun stopConversation() {
+    val current = conversation ?: return
+    conversation = null
+    conversationObserver?.cancel()
+    conversationObserver = null
+    try {
+      current.runtime.stopAssistantConversation(current.talk)
+    } finally {
+      current.lifetime.cancel()
+      if (::root.isInitialized) {
+        root.setDictationAction(R.string.aiden_assistant_dictate)
+        root.status.visibility = View.GONE
+      }
+    }
+  }
+
+  private fun toggleDictation(fromWake: Boolean = false) {
+    if (!isInteractive() || conversation != null || awaitingCapture != null) return
+    wakeSpeech.stop()
+    if (dictationJob?.isActive == true) {
+      val controller = dictationController
+      if (controller != null && controller.state.value is ChatDictationState.Listening) {
+        controller.finish()
+      } else {
+        cancelDictation()
+      }
+      return
+    }
+    if (!hasMicPermission()) {
+      if (fromWake) showStatus(R.string.aiden_assistant_mic_denied)
+      else openActivity(Intent(context, AidenMicPermissionActivity::class.java))
+      return
+    }
+
+    dismissKeyboard()
+    root.dismissScreenActions()
+    clearScreenExcerpt()
+    val generation = ++dictationGeneration
+    root.readScreen.isEnabled = false
+    root.shareScreen.isEnabled = false
+    root.setDictationAction(R.string.aiden_assistant_dictate_cancel)
+    showStatus(R.string.aiden_assistant_dictate_starting)
+    dictationJob =
+      scope.launch {
+        var controller: ChatDictationController? = null
+        try {
+          val runtime = withContext(Dispatchers.Default) { (context.applicationContext as NodeApp).ensureBackgroundRuntime() }
+          if (!isInteractive() || generation != dictationGeneration) return@launch
+          val active =
+            ChatDictationController(
+              recognizer = AndroidChatDictationRecognizer(context),
+              requestPermission = { isInteractive() && hasMicPermission() },
+              acquireMic = { isInteractive() && runtime.tryAcquireDictationMic() },
+              releaseMic = runtime::releaseDictationMic,
+            )
+          controller = active
+          dictationController = active
+          val observer =
+            launch {
+              active.state.collect { state ->
+                if (generation != dictationGeneration) return@collect
+                when (state) {
+                  ChatDictationState.Listening -> {
+                    root.setDictationAction(R.string.aiden_assistant_dictate_stop)
+                    showStatus(R.string.aiden_assistant_dictate_listening)
+                  }
+                  ChatDictationState.Transcribing -> {
+                    root.setDictationAction(R.string.aiden_assistant_dictate_cancel)
+                    showStatus(R.string.aiden_assistant_dictate_transcribing)
+                  }
+                  else -> Unit
+                }
+              }
+            }
+          try {
+            val result = withTimeoutOrNull(dictationTimeoutMillis) { active.start() to active.state.value }
+            if (generation != dictationGeneration || !isInteractive()) return@launch
+            val transcript = result?.first?.take(maxDictationCharacters)
+            if (transcript != null) {
+              if (!fromWake || !runOverlayCommand(transcript, speakResult = true)) {
+                showPreview(transcript, transcript)
+                if (fromWake) showStatus(R.string.aiden_assistant_conversation_draft)
+              }
+            } else {
+              showStatus(
+                if (result == null) {
+                  R.string.aiden_assistant_dictate_timeout
+                } else {
+                  dictationFailureText((result.second as? ChatDictationState.Failure)?.reason)
+                },
+              )
+            }
+          } finally {
+            observer.cancel()
+          }
+        } catch (error: CancellationException) {
+          throw error
+        } catch (_: RuntimeException) {
+          if (generation == dictationGeneration && isInteractive()) showStatus(R.string.aiden_assistant_dictate_failed)
+        } finally {
+          controller?.destroy()
+          if (generation == dictationGeneration) {
+            dictationController = null
+            dictationJob = null
+            root.readScreen.isEnabled = true
+            root.shareScreen.isEnabled = !imageRequested
+            root.setDictationAction(R.string.aiden_assistant_dictate)
+          }
+        }
+      }
+  }
+
+  private fun cancelDictation() {
+    val wasActive = dictationJob?.isActive == true
+    dictationGeneration++
+    dictationController?.cancel()
+    dictationController = null
+    dictationJob?.cancel()
+    dictationJob = null
+    if (::root.isInitialized) {
+      root.setDictationAction(R.string.aiden_assistant_dictate)
+      if (wasActive) {
+        root.readScreen.isEnabled = true
+        root.shareScreen.isEnabled = !imageRequested
+        root.status.visibility = View.GONE
+      }
+    }
+  }
+
+  private fun isInteractive(): Boolean {
+    if (!visible ||
+      window.window?.decorView?.hasWindowFocus() != true ||
+      context.getSystemService(PowerManager::class.java)?.isInteractive != true
+    ) return false
+    val keyguard = context.getSystemService(KeyguardManager::class.java) ?: return false
+    return !keyguard.isDeviceLocked && !keyguard.isKeyguardLocked
+  }
+
+  private fun hasMicPermission(): Boolean =
+    ContextCompat.checkSelfPermission(context, Manifest.permission.RECORD_AUDIO) == PackageManager.PERMISSION_GRANTED
+
+  private fun keyboardIsVisible(): Boolean =
+    ::root.isInitialized && root.rootWindowInsets?.isVisible(WindowInsets.Type.ime()) == true
+
+  private fun dismissKeyboard() {
+    if (!::root.isInitialized) return
+    root.windowInsetsController?.hide(WindowInsets.Type.ime())
+    if (root.input.hasFocus()) root.panel.requestFocus()
+  }
+
+  private fun closeOverlay() {
+    retireOverlay()
+    // Bitmap callbacks carry no token. Retire the session after one image request so a
+    // delayed bitmap can never be accepted by another image request in this session.
+    if (imageRequested) finishImageSession() else hide()
+  }
+
+  private fun finishImageSession() {
+    if (finishing) return
+    finishing = true
+    finish()
+  }
+
+  private fun retireOverlay() {
+    visible = false
+    cancelWakeGreeting()
+    stopConversation()
+    AidenAssistantService.onSessionClosed(this)
+    wakeSpeech.stop()
+    if (watchingScreenOff) {
+      context.unregisterReceiver(screenOffReceiver)
+      watchingScreenOff = false
+    }
+    cancelDictation()
+    clearScreenExcerpt()
+    if (::root.isInitialized) {
+      dismissKeyboard()
+      root.dismissScreenActions()
+      root.input.text.clear()
+    }
+  }
+
+  private fun clearScreenExcerpt() {
+    handler.removeCallbacks(captureTimeout)
+    frameCommit?.let { callback ->
+      if (root.viewTreeObserver.isAlive) root.viewTreeObserver.unregisterFrameCommitCallback(callback)
+    }
+    frameCommit = null
+    imageStageJob?.cancel()
+    imageStageJob = null
+    awaitingCapture = null
+    shownCapture = null
+    draft = null
+    draftImage = null
+    if (::root.isInitialized) {
+      root.panel.visibility = View.VISIBLE
+      root.readScreen.isEnabled = true
+      root.shareScreen.isEnabled = !imageRequested
+      root.review.visibility = View.GONE
+      root.review.isEnabled = true
+      root.previewText.text = ""
+      root.preview.visibility = View.GONE
+      root.previewImage.setImageDrawable(null)
+      root.previewImage.visibility = View.GONE
+      root.status.visibility = View.GONE
+    }
+  }
+
+  private fun showPreview(text: String, stagedDraft: String, screenContext: Boolean = false) {
+    draft = AssistantDraft(stagedDraft, screenContext)
+    root.status.visibility = View.GONE
+    root.previewText.text = text
+    root.preview.scrollTo(0, 0)
+    root.preview.visibility = View.VISIBLE
+    root.review.visibility = View.VISIBLE
+  }
+
+  private fun showStatus(message: Int) {
+    showStatus(context.getString(message))
+  }
+
+  private fun showStatus(message: String) {
+    if (root.status.text.toString() != message) root.status.text = message
+    root.status.visibility = View.VISIBLE
+  }
+
+  private companion object {
+    const val screenRequestId = "aiden.screen-request-id"
+    const val greetingTimeoutMs = 1_550L
+    const val greetingAudioTailMs = 110L
+    const val dictationTimeoutMillis = 20_000L
+    const val maxDictationCharacters = 1600
+    val conversationStopPhrases = setOf("end conversation", "end the conversation", "stop conversation", "stop the conversation")
+  }
+
+  private data class OverlayConversation(val runtime: NodeRuntime, val talk: TalkModeManager, val lifetime: Job)
+  private data class ConversationPresentation(
+    val enabled: Boolean,
+    val listening: Boolean,
+    val speaking: Boolean,
+    val text: String,
+    val failure: TalkFailureNotice?,
+  )
+  private data class ScreenCapture(val id: Long, val image: Boolean)
+  private data class AssistantDraft(val text: String, val screenContext: Boolean)
+}
+
+private fun dictationFailureText(failure: ChatDictationFailure?): Int =
+  when (failure) {
+    ChatDictationFailure.Unavailable -> R.string.aiden_assistant_dictate_unavailable
+    ChatDictationFailure.PermissionRequired -> R.string.aiden_assistant_mic_denied
+    ChatDictationFailure.Busy -> R.string.aiden_assistant_dictate_busy
+    ChatDictationFailure.NoSpeech -> R.string.aiden_assistant_dictate_no_speech
+    else -> R.string.aiden_assistant_dictate_failed
+  }
+
+private const val screenNodeLimit = 250
+private const val screenTextLimit = 1600
+private const val screenLineLimit = 240
+
+private fun extractVisibleText(structure: AssistStructure): String {
+  val queue = ArrayDeque<AssistStructure.ViewNode>()
+  val lines = linkedSetOf<String>()
+  for (index in 0 until minOf(structure.windowNodeCount, 3)) {
+    queue.addLast(structure.getWindowNodeAt(index).rootViewNode)
+  }
+  var visited = 0
+  var characters = 0
+  while (queue.isNotEmpty() && visited < screenNodeLimit && characters < screenTextLimit) {
+    val node = queue.removeFirst()
+    visited++
+    if (node.isAssistBlocked || node.visibility != View.VISIBLE) continue
+    // Editable and autofill fields can contain user-entered information.
+    val isTextInput =
+      node.inputType != InputType.TYPE_NULL ||
+        node.autofillType != View.AUTOFILL_TYPE_NONE ||
+        node.className?.endsWith("EditText") == true
+    if (!isTextInput) {
+      val text = node.text?.take(minOf(screenLineLimit, screenTextLimit - characters))?.toString()?.trim()
+      if (!text.isNullOrEmpty() && lines.add(text)) characters += text.length + 1
+    }
+    val remaining = screenNodeLimit - visited - queue.size
+    for (index in 0 until minOf(node.childCount, remaining)) {
+      queue.addLast(node.getChildAt(index))
+    }
+  }
+  return lines.joinToString("\n")
+}
