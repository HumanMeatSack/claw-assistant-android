+package ai.openclaw.app.assistant
+
+import android.app.KeyguardManager
+import android.content.ComponentName
+import android.content.Intent
+import android.os.Bundle
+import android.os.PowerManager
+import android.os.SystemClock
+import android.service.voice.VoiceInteractionService
+import android.service.voice.VoiceInteractionSession
+import android.service.voice.VoiceInteractionSessionService
+import android.speech.RecognitionService
+import android.speech.SpeechRecognizer
+
+internal const val disabledScreenContext =
+  VoiceInteractionSession.SHOW_WITH_ASSIST or VoiceInteractionSession.SHOW_WITH_SCREENSHOT
+
+/** Requests Android's assistant overlay after an explicit local wake event. */
+class AidenAssistantService : VoiceInteractionService() {
+  override fun onReady() {
+    super.onReady()
+    setDisabledShowContext(disabledScreenContext)
+    synchronized(lock) { activeService = this }
+  }
+
+  override fun onShutdown() {
+    val wasActive = synchronized(lock) {
+      if (activeService === this) {
+        activeService = null
+        pendingWake = null
+        visibleSession = null
+        true
+      } else {
+        false
+      }
+    }
+    if (wasActive) AidenWakeService.disarm(this)
+    super.onShutdown()
+  }
+
+  companion object {
+    private const val wakeArgument = "aiden.confirmed-wake"
+    private const val showTimeoutMs = 4_000L
+    private val lock = Any()
+    private var activeService: AidenAssistantService? = null
+    private var visibleSession: AidenAssistantSession? = null
+    private var nextId = 0L
+    private var pendingWake: PendingWake? = null
+
+    internal fun isWakeOverlayBusy(): Boolean = synchronized(lock) {
+      visibleSession != null || pendingWake?.let { SystemClock.elapsedRealtime() < it.deadlineMs } == true
+    }
+
+    internal fun dispatchWake(): Boolean = synchronized(lock) {
+      val service = activeService ?: return false
+      if (isWakeOverlayBusy() || !isActiveService(service, ComponentName(service, AidenAssistantService::class.java))) return false
+      val device = service.getSystemService(KeyguardManager::class.java) ?: return false
+      if (device.isDeviceLocked || device.isKeyguardLocked || service.getSystemService(PowerManager::class.java)?.isInteractive != true) return false
+      val wake = PendingWake(++nextId, SystemClock.elapsedRealtime() + showTimeoutMs)
+      pendingWake = wake
+      try {
+        service.showSession(Bundle().apply { putLong(wakeArgument, wake.id) }, 0)
+        true
+      } catch (_: RuntimeException) {
+        pendingWake = null
+        false
+      }
+    }
+
+    internal fun onSessionShown(session: AidenAssistantSession, args: Bundle?): Boolean = synchronized(lock) {
+      visibleSession = session
+      val wake = pendingWake
+      pendingWake = null
+      wake != null && args?.getLong(wakeArgument) == wake.id && SystemClock.elapsedRealtime() < wake.deadlineMs
+    }
+
+    internal fun onSessionClosed(session: AidenAssistantSession) = synchronized(lock) {
+      if (visibleSession === session) visibleSession = null
+    }
+
+    private data class PendingWake(val id: Long, val deadlineMs: Long)
+  }
+}
+
+class AidenAssistantSessionService : VoiceInteractionSessionService() {
+  override fun onNewSession(args: Bundle?): VoiceInteractionSession = AidenAssistantSession(this)
+}
+
+/** Required metadata for VoiceInteractionService. Android 12+ uses separate dictation services. */
+class AidenLegacyRecognitionService : RecognitionService() {
+  override fun onStartListening(intent: Intent, callback: Callback) {
+    callback.error(SpeechRecognizer.ERROR_CLIENT)
+  }
+
+  override fun onStopListening(callback: Callback) = Unit
+
+  override fun onCancel(callback: Callback) = Unit
+}
