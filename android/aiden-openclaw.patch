@@ -0,0 +1,72 @@
+package ai.openclaw.app.voice
+
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AlbaPlaybackDiagnosticsTest {
+  @Test
+  fun noSnapshotBeforeAnyAttempt() {
+    assertNull(AlbaPlaybackDiagnosticsOwner().snapshot())
+  }
+
+  @Test
+  fun newAttemptClearsPreviousMetricsAndRejectsLateOldReports() {
+    var now = 100L
+    val owner = AlbaPlaybackDiagnosticsOwner { now }
+    val first = owner.begin(1f, false)
+    owner.publish(first, AlbaPlaybackReport("completed", sourceRateHz = 24_000, writtenFrames = 65_280))
+    now = 200L
+    val second = owner.begin(1f, true)
+    owner.publish(first, AlbaPlaybackReport("failed", sourceRateHz = 48_000))
+    val current = checkNotNull(owner.snapshot())
+    assertEquals(second.toString(), current["sequence"]?.jsonPrimitive?.content)
+    assertEquals("200", current["startedAtMonotonicMs"]?.jsonPrimitive?.content)
+    assertEquals("preparing", current["phase"]?.jsonPrimitive?.content)
+    assertEquals("true", current["communication"]?.jsonPrimitive?.content)
+    assertFalse(current.containsKey("sourceRateHz"))
+    assertFalse(current.containsKey("writtenFrames"))
+  }
+
+  @Test
+  fun finishedAttemptCannotRegressToPlaying() {
+    val owner = AlbaPlaybackDiagnosticsOwner { 100L }
+    val token = owner.begin(1f, false)
+    owner.publish(token, AlbaPlaybackReport("completed", renderedFrames = 24_000))
+    owner.publish(token, AlbaPlaybackReport("playing", renderedFrames = 12_000))
+    assertEquals("completed", owner.snapshot()?.get("phase")?.jsonPrimitive?.content)
+    assertEquals("24000", owner.snapshot()?.get("renderedFrames")?.jsonPrimitive?.content)
+  }
+
+  @Test
+  fun snapshotContainsOnlyWhitelistedContentFreeFacts() {
+    val owner = AlbaPlaybackDiagnosticsOwner { 300L }
+    val token = owner.begin(1f, false)
+    owner.publish(token, AlbaPlaybackReport(
+      phase = "completed", sourceRateHz = 24_000, trackRateHz = 24_000, playbackRateHz = 24_000,
+      encoding = 2, speed = 1f, pitch = 1f, generatedFrames = 65_280, writtenFrames = 65_280,
+      renderedFrames = 65_280, playbackElapsedMs = 2_720, underruns = 0,
+    ))
+    val current = checkNotNull(owner.snapshot())
+    assertEquals(setOf(
+      "sequence", "startedAtMonotonicMs", "provider", "phase", "requestedSpeed", "communication",
+      "sourceRateHz", "trackRateHz", "playbackRateHz", "encoding", "speed", "pitch", "generatedFrames",
+      "writtenFrames", "renderedFrames", "playbackElapsedMs", "underruns",
+    ), current.keys)
+    assertEquals("android-alba", current["provider"]?.jsonPrimitive?.content)
+    owner.publish(token, AlbaPlaybackReport("private transcript must not be accepted"))
+    assertEquals(current, owner.snapshot())
+  }
+
+  @Test
+  fun nonFiniteNumbersCannotProduceInvalidJson() {
+    val owner = AlbaPlaybackDiagnosticsOwner { 100L }
+    val token = owner.begin(Float.NaN, false)
+    owner.publish(token, AlbaPlaybackReport("failed", speed = Float.POSITIVE_INFINITY, pitch = Float.NaN))
+    val current = checkNotNull(owner.snapshot())
+    assertTrue(current.keys.none { it in setOf("requestedSpeed", "speed", "pitch") })
+  }
+}
