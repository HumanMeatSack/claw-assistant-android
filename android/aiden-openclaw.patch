+package ai.openclaw.app.localagent
+
+import java.io.ByteArrayInputStream
+import java.nio.file.Files
+import java.security.MessageDigest
+import kotlinx.coroutines.test.runTest
+import org.junit.Assert.assertArrayEquals
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PinnedPhoneModelTest {
+  @Test
+  fun invalidImportPreservesPreviousModelAndRemovesTemporaryFile() = runTest {
+    val directory = Files.createTempDirectory("phone-agent-import").toFile()
+    try {
+      val target = directory.resolve("model.litertlm").apply { writeText("previous") }
+      val failure = runCatching {
+        importVerifiedPhoneModel(ByteArrayInputStream("corrupt".toByteArray()), target, 7, "0".repeat(64))
+      }.exceptionOrNull()
+      assertTrue(failure is IllegalArgumentException)
+      assertEquals("previous", target.readText())
+      assertEquals(listOf("model.litertlm"), directory.listFiles().orEmpty().map { it.name })
+    } finally {
+      directory.deleteRecursively()
+    }
+  }
+
+  @Test
+  fun validImportPublishesCompleteFile() = runTest {
+    val directory = Files.createTempDirectory("phone-agent-import").toFile()
+    try {
+      val bytes = "verified bytes".toByteArray()
+      val hash = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+      val target = directory.resolve("model.litertlm").apply { writeText("previous") }
+      importVerifiedPhoneModel(ByteArrayInputStream(bytes), target, bytes.size.toLong(), hash)
+      assertArrayEquals(bytes, target.readBytes())
+      assertEquals(1, directory.listFiles().orEmpty().size)
+    } finally {
+      directory.deleteRecursively()
+    }
+  }
+}
