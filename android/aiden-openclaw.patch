+    var executed = false
+    agent.answer = { text, tools, execute ->
+      assertEquals(original, text)
+      assertEquals(listOf(tool), tools)
+      assertEquals("live battery", execute(PhoneAgentCall("phone_read", "{}")))
+      "Your phone has 60 percent."
+    }
+    val reply = replyFromPhoneLocalAgent(agent, original, listOf(tool), { executed = true; "live battery" }, { true })
+    assertTrue(executed)
+    assertEquals(AssistantConversationTurn.Reply("Your phone has 60 percent."), reply)
+  }
+
+  @Test
+  fun retiredLocalTurnCannotExecuteToolAfterInferenceWaits() = runBlocking {
+    val agent = FakePhoneAgent()
+    var current = true
+    var executed = false
+    agent.answer = { _, _, execute ->
+      current = false
+      execute(PhoneAgentCall("phone_action", "{}"))
+    }
+    var cancelled = false
+    try {
+      replyFromPhoneLocalAgent(agent, "Turn on the flashlight", emptyList(), { executed = true; "done" }, { current })
+    } catch (_: CancellationException) {
+      cancelled = true
+    }
+    assertTrue(cancelled)
+    assertFalse(executed)
+    // A stale turn must not cancel a later turn using the same singleton model.
+    assertEquals(0, agent.cancellations)
+  }
+
+  @Test
+  fun localModelFailureNeverFallsThroughToRemote() = runBlocking {
+    val agent = FakePhoneAgent()
+    agent.answer = { _, _, _ -> throw IllegalStateException("Unavailable") }
+    val reply = replyFromPhoneLocalAgent(agent, "Tell me a joke", emptyList(), { error("No tool requested") }, { true })
+    assertTrue(reply is AssistantConversationTurn.Reply)
+    assertTrue((reply as AssistantConversationTurn.Reply).text.contains("phone model"))
+    agent.answer = { _, _, _ -> throw UnsatisfiedLinkError("Unavailable native runtime") }
+    val nativeFailure = replyFromPhoneLocalAgent(agent, "Tell me a joke", emptyList(), { error("No tool requested") }, { true })
+    assertTrue(nativeFailure is AssistantConversationTurn.Reply)
+  }
+
+  @Test
+  fun retiredOwnerDiscardsCompletedLocalReply() = runBlocking {
+    val agent = FakePhoneAgent()
+    var current = true
+    agent.answer = { _, _, _ -> current = false; "late answer" }
+    assertEquals(
+      AssistantConversationTurn.Stop,
+      replyFromPhoneLocalAgent(agent, "Tell me a joke", emptyList(), { error("No tool requested") }, { current }),
+    )
+  }
+
+  @Test
+  fun hideCancelsOnlyActiveOwnedTypedWork() {
+    val agent = FakePhoneAgent()
+    withSession { session, _ ->
+      val typed = Job()
+      setField(session, "typedTurnJob", typed)
+      setField(session, "typedTurnAgent", agent)
+      session.onHide()
+      assertFalse(typed.isActive)
+      assertNull(field(session, "typedTurnJob"))
+      assertNull(field(session, "typedTurnAgent"))
+      assertEquals(1, agent.cancellations)
+    }
+  }
+
+  @Test
+  fun completedTypedOwnerCannotCancelSuccessorModelWork() {
+    val agent = FakePhoneAgent()
+    withSession { session, _ ->
+      val completed = Job().apply { complete() }
+      setField(session, "typedTurnJob", completed)
+      setField(session, "typedTurnAgent", agent)
+      session.onHide()
+      assertEquals(0, agent.cancellations)
+      assertNull(field(session, "typedTurnAgent"))
+    }
+  }
+
+  private class FakePhoneAgent : PhoneLocalAgent {
+    override val state = MutableStateFlow(PhoneAgentState(true, true, "Ready"))
+    var cancellations = 0
+    var answer: suspend (String, List<PhoneAgentTool>, suspend (PhoneAgentCall) -> String) -> String = { _, _, _ -> "Ready" }
+    override suspend fun importModel(uri: Uri) = Unit
+    override fun setEnabled(enabled: Boolean) { state.value = state.value.copy(enabled = enabled) }
+    override suspend fun warmUp() = Unit
+    override suspend fun reply(text: String, tools: List<PhoneAgentTool>, finalizeReply: suspend (String) -> String, execute: suspend (PhoneAgentCall) -> String) = finalizeReply(answer(text, tools, execute))
+    override fun cancel() { cancellations++ }
+    override suspend fun resetConversation() = Unit
+    override suspend fun unload() = Unit
+  }
+
+  private fun withSession(block: (AidenAssistantSession, AidenAssistantPanel) -> Unit) {
+    val session = AidenAssistantSession(RuntimeEnvironment.getApplication())
+    shadowOf(session).create()
+    val panel = session.onCreateContentView() as AidenAssistantPanel
+    try {
+      block(session, panel)
+    } finally {
+      session.onDestroy()
+    }
+  }
+
+
+  private fun field(target: Any, name: String): Any? = target.javaClass.getDeclaredField(name).let {
+    it.isAccessible = true
+    it.get(target)
+  }
+
+  private fun setField(target: Any, name: String, value: Any) {
+    target.javaClass.getDeclaredField(name).apply { isAccessible = true }.set(target, value)
+  }
+}
