@@ -0,0 +1,19 @@
+package ai.openclaw.app.voice
+
+import android.content.Context
+import android.speech.SpeechRecognizer
+
+/** Selects the app's bundled recognizer, or the platform's strictly on-device service. */
+internal object LocalSpeechRecognition {
+  fun usesBundled(context: Context): Boolean = BundledOfflineSpeech.component(context) != null
+
+  fun isAvailable(context: Context): Boolean =
+    usesBundled(context) ||
+      runCatching { SpeechRecognizer.isOnDeviceRecognitionAvailable(context) }.getOrDefault(false)
+
+  fun create(context: Context): SpeechRecognizer {
+    val component = BundledOfflineSpeech.component(context)
+    return if (component != null) SpeechRecognizer.createSpeechRecognizer(context, component)
+    else SpeechRecognizer.createOnDeviceSpeechRecognizer(context)
+  }
+}
diff --git a/apps/android/app/src/main/java/ai/openclaw/app/voice/SpokenReplyText.kt b/apps/android/app/src/main/java/ai/openclaw/app/voice/SpokenReplyText.kt
new file mode 100644
index 0000000000000000000000000000000000000000..8d2cd35225da49a558885beb4900942acc1d8efb
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/voice/SpokenReplyText.kt
@@ -0,0 +1,45 @@
+package ai.openclaw.app.voice
+
+private val codeFragment = Regex(
+  "(?m)^[\\t ]*(`{3,}|~{3,})[\\p{L}\\p{N}_+.-]*[\\t ]*\\n([\\s\\S]*?)^[\\t ]*\\1[\\t ]*$|(`+)([^`]+)\\3",
+)
+private val markdownLink = Regex("!?\\[([^\\[\\]\\n]+)]\\((?:[^()\\n]|\\([^()\\n]*\\))*\\)")
+private val lineDecoration = Regex("(?m)^[\\t ]{0,3}(?:#{1,6}[\\t ]+|[-+*•][\\t ]+(?![\\d.])|\\d+[.)][\\t ]+)")
+private val emphasis = Regex("(?<![\\p{L}\\p{N}_\\\\])(\\*\\*|__|~~|\\*|_)(?=\\S)(.+?)(?<=\\S)\\1(?![\\p{L}\\p{N}_])")
+private val repeatedQuotes = Regex("\"{2,}")
+private val speechWhitespace = Regex("[\\s\\p{Z}]+")
+private val spokenUnitSymbols = setOf(0x00B0, 0x2103, 0x2109)
+
+/** Removes display decoration from speech while retaining words, measurements, and code content. */
+internal fun spokenReplyText(text: String): String {
+  val source = text.replace("\r\n", "\n")
+  val readable = buildString {
+    var position = 0
+    for (code in codeFragment.findAll(source)) {
+      append(spokenMarkupText(source.substring(position, code.range.first), position == 0 || source[position - 1] == '\n'))
+      append(code.groups[2]?.value ?: code.groupValues[4])
+      position = code.range.last + 1
+    }
+    append(spokenMarkupText(source.substring(position), position == 0 || source[position - 1] == '\n'))
+  }
+  val withoutDecoration = buildString {
+    readable.codePoints().forEach { codePoint ->
+      val decorativeSymbol = Character.getType(codePoint) == Character.OTHER_SYMBOL.toInt() &&
+        codePoint !in spokenUnitSymbols // Keep degree signs and Celsius/Fahrenheit units.
+      val emojiModifier = codePoint in 0x1F3FB..0x1F3FF || codePoint in 0xFE00..0xFE0F ||
+        codePoint in 0xE0100..0xE01EF || codePoint == 0x200D || codePoint == 0x20E3
+      if (decorativeSymbol || emojiModifier || Character.isISOControl(codePoint)) append(' ')
+      else appendCodePoint(codePoint)
+    }
+  }
+  return speechWhitespace.replace(withoutDecoration, " ").trim()
+}
+
+private fun spokenMarkupText(text: String, startsLine: Boolean): String =
+  markdownLink.replace(text, "\$1")
+    .replace("`", "")
+    .let { lineDecoration.replace(it) { marker -> if (marker.range.first == 0 && !startsLine) marker.value else "" } }
+    .let { emphasis.replace(it, "\$2") }
+    .let { emphasis.replace(it, "\$2") }
+    .replace('“', '"').replace('”', '"').replace('’', '\'')
+    .let { repeatedQuotes.replace(it, "\"") }
