+package ai.openclaw.app
+
+import android.content.ActivityNotFoundException
+import android.content.Context
+import android.content.Intent
+import android.hardware.camera2.CameraAccessException
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.media.AudioManager
+import android.provider.AlarmClock
+
+enum class PhoneQuickActionResult {
+  APP_OPENED,
+  TIMER_HANDED_OFF,
+  ALARM_HANDED_OFF,
+  FLASHLIGHT_SET,
+  VOLUME_SET,
+  APP_UNAVAILABLE,
+  CLOCK_UNAVAILABLE,
+  FLASHLIGHT_UNAVAILABLE,
+  VOLUME_UNAVAILABLE,
+  COULD_NOT_START,
+}
+
+private val clockPackages = listOf("com.sec.android.app.clockpackage", "com.google.android.deskclock")
+
+/** Executes a structured action from the visible assistant using Android APIs. */
+fun executePhoneQuickAction(context: Context, action: PhoneQuickAction): PhoneQuickActionResult =
+  try {
+    when (action) {
+      is PhoneQuickAction.OpenApp -> openPhoneApp(context, action.app)
+      is PhoneQuickAction.SetTimer ->
+        handOffToClock(
+          context,
+          Intent(AlarmClock.ACTION_SET_TIMER).putExtra(AlarmClock.EXTRA_LENGTH, action.seconds),
+          PhoneQuickActionResult.TIMER_HANDED_OFF,
+        )
+      is PhoneQuickAction.SetAlarm ->
+        handOffToClock(
+          context,
+          Intent(AlarmClock.ACTION_SET_ALARM)
+            .putExtra(AlarmClock.EXTRA_HOUR, action.hour)
+            .putExtra(AlarmClock.EXTRA_MINUTES, action.minute),
+          PhoneQuickActionResult.ALARM_HANDED_OFF,
+        )
+      is PhoneQuickAction.SetFlashlight -> setPhoneFlashlight(context, action.enabled)
+      is PhoneQuickAction.SetVolume -> setPhoneVolume(context, action.stream, action.percent)
+    }
+  } catch (_: SecurityException) {
+    PhoneQuickActionResult.COULD_NOT_START
+  }
+
+private fun openPhoneApp(context: Context, app: PhoneQuickApp): PhoneQuickActionResult {
+  val packages =
+    when (app) {
+      PhoneQuickApp.Calculator -> listOf("com.sec.android.app.popupcalculator", "com.google.android.calculator")
+      PhoneQuickApp.Clock -> clockPackages
+      PhoneQuickApp.Maps -> listOf("com.google.android.apps.maps")
+      PhoneQuickApp.YouTube -> listOf("com.google.android.youtube")
+      PhoneQuickApp.Camera -> listOf("com.sec.android.app.camera", "com.google.android.GoogleCamera")
+      PhoneQuickApp.Settings -> listOf("com.android.settings")
+    }
+  for (packageName in packages) {
+    val launchIntent = context.packageManager.getLaunchIntentForPackage(packageName) ?: continue
+    if (startPhoneActivity(context, launchIntent)) return PhoneQuickActionResult.APP_OPENED
+  }
+  return PhoneQuickActionResult.APP_UNAVAILABLE
+}
+
+private fun handOffToClock(
+  context: Context,
+  clockAction: Intent,
+  handoffResult: PhoneQuickActionResult,
+): PhoneQuickActionResult {
+  for (packageName in clockPackages) {
+    val intent = Intent(clockAction).setPackage(packageName).putExtra(AlarmClock.EXTRA_SKIP_UI, false)
+    if (startPhoneActivity(context, intent)) return handoffResult
+  }
+  return PhoneQuickActionResult.CLOCK_UNAVAILABLE
+}
+
+private fun setPhoneFlashlight(context: Context, enabled: Boolean): PhoneQuickActionResult {
+  val cameraManager = context.getSystemService(CameraManager::class.java) ?: return PhoneQuickActionResult.FLASHLIGHT_UNAVAILABLE
+  return try {
+    val rearFlashCamera = cameraManager.cameraIdList.firstOrNull { id ->
+      val characteristics = cameraManager.getCameraCharacteristics(id)
+      characteristics.get(CameraCharacteristics.LENS_FACING) == CameraCharacteristics.LENS_FACING_BACK &&
+        characteristics.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true
+    } ?: return PhoneQuickActionResult.FLASHLIGHT_UNAVAILABLE
+    cameraManager.setTorchMode(rearFlashCamera, enabled)
+    PhoneQuickActionResult.FLASHLIGHT_SET
+  } catch (_: CameraAccessException) {
+    PhoneQuickActionResult.FLASHLIGHT_UNAVAILABLE
+  } catch (_: IllegalArgumentException) {
+    PhoneQuickActionResult.FLASHLIGHT_UNAVAILABLE
+  }
+}
+
+private fun setPhoneVolume(
+  context: Context,
+  stream: PhoneVolumeStream,
+  percent: Int,
+): PhoneQuickActionResult {
+  val audioManager = context.getSystemService(AudioManager::class.java) ?: return PhoneQuickActionResult.VOLUME_UNAVAILABLE
+  if (audioManager.isVolumeFixed) return PhoneQuickActionResult.VOLUME_UNAVAILABLE
+  val streamType =
+    when (stream) {
+      PhoneVolumeStream.Media -> AudioManager.STREAM_MUSIC
+      PhoneVolumeStream.Ringer -> AudioManager.STREAM_RING
+    }
+  val minimum = audioManager.getStreamMinVolume(streamType)
+  val maximum = audioManager.getStreamMaxVolume(streamType)
+  if (maximum <= minimum) return PhoneQuickActionResult.VOLUME_UNAVAILABLE
+  val rounded = minimum + ((maximum - minimum) * percent + 50) / 100
+  val index = if (percent > 0) maxOf(1, rounded) else minimum
+
+  return try {
+    audioManager.setStreamVolume(streamType, index, AudioManager.FLAG_SHOW_UI)
+    if (audioManager.getStreamVolume(streamType) == index) {
+      PhoneQuickActionResult.VOLUME_SET
+    } else {
+      PhoneQuickActionResult.VOLUME_UNAVAILABLE
+    }
+  } catch (_: SecurityException) {
+    // Android protects changes that would toggle Do Not Disturb.
+    PhoneQuickActionResult.VOLUME_UNAVAILABLE
+  }
+}
+
+private fun startPhoneActivity(context: Context, intent: Intent): Boolean =
+  try {
+    context.startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+    true
+  } catch (_: ActivityNotFoundException) {
+    false
+  }
diff --git a/apps/android/app/src/main/java/ai/openclaw/app/PhoneUtilityAction.kt b/apps/android/app/src/main/java/ai/openclaw/app/PhoneUtilityAction.kt
new file mode 100644
index 0000000000000000000000000000000000000000..02eeba25212f4d1136405810471eb30d318c2bae
--- /dev/null
+++ b/apps/android/app/src/main/java/ai/openclaw/app/PhoneUtilityAction.kt
@@ -0,0 +1,162 @@
+package ai.openclaw.app
+
+import java.net.URI
+import java.net.URISyntaxException
+import java.util.Locale
+
+sealed interface PhoneUtilityAction {
+  data class OpenInstalledApp(val label: String) : PhoneUtilityAction
+
+  data class OpenWebsite(val url: String) : PhoneUtilityAction {
+    init {
+      require(isExplicitWebUrl(url))
+    }
+  }
+
+  data class MapSearch(val query: String) : PhoneUtilityAction
+
+  data class MapDirections(val destination: String) : PhoneUtilityAction
+
+  data class Dial(val number: String) : PhoneUtilityAction {
+    init {
+      require(phoneNumberPattern.matches(number))
+    }
+  }
+
+  data class DraftText(val number: String, val body: String) : PhoneUtilityAction {
+    init {
+      require(phoneNumberPattern.matches(number))
+      require(body.isNotBlank() && body.length <= maxMessageLength && body.none { it.isISOControl() })
+    }
+  }
+
+  data class DraftCalendarEvent(val title: String) : PhoneUtilityAction
+
+  data object OpenCamera : PhoneUtilityAction
+
+  data class OpenSettings(val panel: PhoneUtilitySettingsPanel) : PhoneUtilityAction
+}
+
+enum class PhoneUtilitySettingsPanel {
+  Internet,
+  Wifi,
+  Bluetooth,
+  Display,
+  Sound,
+  Volume,
+  BatterySaver,
+  AirplaneMode,
+  Accessibility,
+  Nfc,
+  DoNotDisturb,
+}
+
+private const val maxCommandLength = 1_100
+private const val maxAppLabelLength = 100
+private const val maxCalendarTitleLength = 160
+private const val maxPlaceLength = 200
+private const val maxMessageLength = 1_000
+
+private val cameraCommands = setOf("take a photo", "take a picture", "take a photograph")
+private val openWebsitePattern = Regex("open (https?://.+)", RegexOption.IGNORE_CASE)
+private val openInstalledAppPattern = Regex("open (.+?) app[.]?", RegexOption.IGNORE_CASE)
+private val mapsSearchPattern = Regex("(?:find|search for|look up) (.+?) (?:on|in) (?:google )?maps[.]?", RegexOption.IGNORE_CASE)
+private val mapsDirectionsPattern = Regex("(?:get |show )?directions to (.+)", RegexOption.IGNORE_CASE)
+private val calendarDraftPattern = Regex("draft (?:a )?calendar event titled (.+)", RegexOption.IGNORE_CASE)
+private val dialPattern = Regex("(?:call|dial) (.+)", RegexOption.IGNORE_CASE)
+private val messagePattern =
+  Regex("(?:draft (?:a )?(?:text|message) to|text|send (?:a )?(?:text|message) to) (.+?) saying (.+)", RegexOption.IGNORE_CASE)
+private val formattedNumberPattern = Regex("[+0-9(][0-9 ().+\\-]{5,31}")
+private val phoneNumberPattern = Regex("\\+?[0-9]{7,15}")
+private val settingsPattern =
+  Regex(
+    "open (?:the )?(internet|wi-fi|wifi|bluetooth|display|sound|volume|" +
+      "battery saver|airplane mode|accessibility|nfc|do not disturb) (settings|panel)",
+  )
+
+/** Parses explicit, single-line local commands while keeping text and place names unchanged. */
+fun parsePhoneUtilityAction(input: String): PhoneUtilityAction? {
+  if (input.length > maxCommandLength || input.any { it.isISOControl() }) return null
+  val trimmed = input.trim()
+  val command = if (trimmed.startsWith("please ", ignoreCase = true)) trimmed.substring(7).trimStart() else trimmed
+  val actionText = command.lowercase(Locale.ROOT).removeSuffix(".")
+  if (actionText in cameraCommands) return PhoneUtilityAction.OpenCamera
+
+  settingsPattern.matchEntire(actionText)?.let { match ->
+    val name = match.groupValues[1]
+    val surface = match.groupValues[2]
+    val panel =
+      when (name) {
+        "internet" -> PhoneUtilitySettingsPanel.Internet
+        "wi-fi", "wifi" -> PhoneUtilitySettingsPanel.Wifi
+        "bluetooth" -> PhoneUtilitySettingsPanel.Bluetooth
+        "display" -> PhoneUtilitySettingsPanel.Display
+        "sound" -> PhoneUtilitySettingsPanel.Sound
+        "volume" -> PhoneUtilitySettingsPanel.Volume
+        "battery saver" -> PhoneUtilitySettingsPanel.BatterySaver
+        "airplane mode" -> PhoneUtilitySettingsPanel.AirplaneMode
+        "accessibility" -> PhoneUtilitySettingsPanel.Accessibility
+        "nfc" -> PhoneUtilitySettingsPanel.Nfc
+        "do not disturb" -> PhoneUtilitySettingsPanel.DoNotDisturb
+        else -> return null
+      }
+    if (surface == "panel" && panel != PhoneUtilitySettingsPanel.Internet && panel != PhoneUtilitySettingsPanel.Volume) return null
+    return PhoneUtilityAction.OpenSettings(panel)
+  }
+
+  openWebsitePattern.matchEntire(command)?.let { match ->
+    val url = match.groupValues[1].takeIf(::isExplicitWebUrl) ?: return null
+    return PhoneUtilityAction.OpenWebsite(url)
+  }
+
+  openInstalledAppPattern.matchEntire(command)?.let { match ->
+    val label = match.groupValues[1].trim().takeIf { it.length in 1..maxAppLabelLength && "://" !in it } ?: return null
+    return PhoneUtilityAction.OpenInstalledApp(label)
+  }
+
+  mapsSearchPattern.matchEntire(command)?.let { match ->
+    val query = match.groupValues[1].trim().takeIf { it.length in 1..maxPlaceLength } ?: return null
+    return PhoneUtilityAction.MapSearch(query)
+  }
+
+  mapsDirectionsPattern.matchEntire(command)?.let { match ->
+    val destination = match.groupValues[1].trim().removeSuffix(".").takeIf { it.length in 1..maxPlaceLength } ?: return null
+    return PhoneUtilityAction.MapDirections(destination)
+  }
+
+  calendarDraftPattern.matchEntire(command)?.let { match ->
+    val title = match.groupValues[1].trim().takeIf { it.length in 1..maxCalendarTitleLength } ?: return null
+    return PhoneUtilityAction.DraftCalendarEvent(title)
+  }
+
+  dialPattern.matchEntire(command)?.let { match ->
+    val number = normalizeDialNumber(match.groupValues[1].trim().removeSuffix(".")) ?: return null
+    return PhoneUtilityAction.Dial(number)
+  }
+
+  val message = messagePattern.matchEntire(command) ?: return null
+  val number = normalizeDialNumber(message.groupValues[1]) ?: return null
+  val body = message.groupValues[2].trim().takeIf { it.length in 1..maxMessageLength } ?: return null
+  return PhoneUtilityAction.DraftText(number, body)
+}
+
+private fun normalizeDialNumber(input: String): String? {
+  if (!formattedNumberPattern.matches(input)) return null
+  return input.filter { it == '+' || it in '0'..'9' }.takeIf(phoneNumberPattern::matches)
+}
+
+private fun isExplicitWebUrl(url: String): Boolean {
+  if (url.isBlank() || url.length > maxCommandLength || url.any { it.isWhitespace() || it.isISOControl() }) return false
+  val parsed =
+    try {
+      URI(url)
+    } catch (_: URISyntaxException) {
+      return false
+    }
+  val scheme = parsed.scheme?.lowercase(Locale.ROOT)
+  return (scheme == "https" || scheme == "http") &&
+    !parsed.isOpaque &&
+    !parsed.host.isNullOrEmpty() &&
+    parsed.rawUserInfo == null &&
+    (parsed.port == -1 || parsed.port in 1..65_535)
+}
