+package ai.openclaw.app
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class PhoneQuickActionTest {
+  @Test
+  fun recognizesStandaloneAppCommands() {
+    val apps =
+      mapOf(
+        " OPEN the Calculator app " to PhoneQuickApp.Calculator,
+        "open Clock" to PhoneQuickApp.Clock,
+        "open Google Maps" to PhoneQuickApp.Maps,
+        "Open YouTube" to PhoneQuickApp.YouTube,
+        "Please open YouTube." to PhoneQuickApp.YouTube,
+        "open camera" to PhoneQuickApp.Camera,
+        "open settings" to PhoneQuickApp.Settings,
+      )
+    for ((input, expected) in apps) {
+      assertEquals(input, PhoneQuickAction.OpenApp(expected), parsePhoneQuickAction(input))
+    }
+  }
+
+  @Test
+  fun recognizesNumericAndSpelledTimerDurations() {
+    val durations =
+      mapOf(
+        "set a timer for 5 minutes" to 300,
+        "START A TIMER FOR 30 SEC" to 30,
+        "set a one minute timer" to 60,
+        "Set a timer for thirty seconds." to 30,
+        "set a twenty-five-second timer" to 25,
+        "set a 1 minute and 30 seconds timer" to 90,
+        "set a timer for two minutes thirty-five seconds" to 155,
+        "set a timer for a minute" to 60,
+        "set a 1 sec timer" to 1,
+        "set a timer for 86400 seconds" to 86_400,
+      )
+    for ((input, expected) in durations) {
+      assertEquals(input, PhoneQuickAction.SetTimer(expected), parsePhoneQuickAction(input))
+    }
+  }
+
+  @Test
+  fun recognizesExplicitAlarmTimes() {
+    val alarms =
+      mapOf(
+        "set an alarm for 7:30 AM" to PhoneQuickAction.SetAlarm(7, 30),
+        "set an alarm at 7 p.m." to PhoneQuickAction.SetAlarm(19, 0),
+        "set alarm for 12:15 AM" to PhoneQuickAction.SetAlarm(0, 15),
+        "set alarm for 12 PM" to PhoneQuickAction.SetAlarm(12, 0),
+        "set an alarm for 17:45" to PhoneQuickAction.SetAlarm(17, 45),
+        "set an alarm for 06:05" to PhoneQuickAction.SetAlarm(6, 5),
+      )
+    for ((input, expected) in alarms) {
+      assertEquals(input, expected, parsePhoneQuickAction(input))
+    }
+  }
+
+  @Test
+  fun recognizesExplicitFlashlightAndVolumeCommands() {
+    val commands =
+      mapOf(
+        "turn the flashlight on" to PhoneQuickAction.SetFlashlight(true),
+        "TURN OFF THE FLASHLIGHT" to PhoneQuickAction.SetFlashlight(false),
+        "torch off" to PhoneQuickAction.SetFlashlight(false),
+        "set media volume to 40%" to PhoneQuickAction.SetVolume(PhoneVolumeStream.Media, 40),
+        "set the ringer volume to twenty-five percent" to PhoneQuickAction.SetVolume(PhoneVolumeStream.Ringer, 25),
+        "set media volume to 0 %" to PhoneQuickAction.SetVolume(PhoneVolumeStream.Media, 0),
+        "set ringer volume to one hundred percent" to PhoneQuickAction.SetVolume(PhoneVolumeStream.Ringer, 100),
+      )
+    for ((input, expected) in commands) {
+      assertEquals(input, expected, parsePhoneQuickAction(input))
+    }
+  }
+
+  @Test
+  fun leavesUnknownActionsAndConversationUntouched() {
+    val inputs =
+      listOf(
+        "open unknown app",
+        "open https://example.com",
+        "how do I open calculator",
+        "open calculator and add five",
+        "open calculator\nopen camera",
+        "set a timer for",
+        "set a timer for 0 seconds",
+        "set a timer for -1 second",
+        "set a timer for 1.5 minutes",
+        "set a timer for 86401 seconds",
+        "set a timer for 2147483647 minutes",
+        "set a timer for 2147483648 minutes",
+        "set a timer for 5 minutes and then open Maps",
+        "set a timer for 5 minutes " + " ".repeat(100),
+        "set an alarm for 7",
+        "set an alarm for 7:30",
+        "set an alarm for 7:61 am",
+        "set an alarm for 16:15 pm",
+        "set an alarm for 24:00",
+        "set an alarm for 7:00 AM tomorrow",
+        "what happens if I turn the flashlight on",
+        "turn the flashlight off and open maps",
+        "set volume to 40%",
+        "set media volume to 104%",
+        "set ringer volume to -1%",
+        "set media volume to 25% and turn the flashlight on",
+      )
+    for (input in inputs) {
+      assertNull(input, parsePhoneQuickAction(input))
+    }
+  }
+}
